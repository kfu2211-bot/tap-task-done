@page
@model tts.Pages.TaskDetailsModel
@{
    Layout = null;
    var task = Model.Work;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@task.Title - Tap, Task, Done</title>
    <link rel="icon" href="/tap-task-icon.svg" />
    <link rel="stylesheet" href="~/css/task-details.css" asp-append-version="true" />
    <partial name="_AccountTheme" />
</head>
<body class="task-detail-page">
    <header class="task-detail-header"><a asp-page="/Dashboard"><img src="/tap-task-icon.svg" width="32" height="32" alt="" /> Tap, Task, Done</a></header>
<main class="task-detail-main">
    <a class="task-detail-action" asp-page="/Messages" asp-route-conversationId="@Model.ConversationId" asp-route-taskId="@task.Id" data-i18n>← Back to conversation</a>
    <article class="task-detail-card">
        <div class="card-body">
            <p class="small mb-2">Task #@task.Id <span class="task-detail-status" data-status="@task.Status">@tts.Data.TaskProgress.Label(task.Status)</span></p>
            <h1 class="h3">@task.Title</h1>
            <p style="white-space: pre-wrap; overflow-wrap: anywhere">@task.Description</p>
            <dl class="row">
                <dt class="col-sm-3" data-i18n>Category</dt><dd class="col-sm-9">@task.Category</dd>
                <dt class="col-sm-3" data-i18n>Job type</dt><dd class="col-sm-9">@task.JobTypeDisplay</dd>
                @if (task.WorkEndUtc.HasValue) { <dt class="col-sm-3" data-i18n>Expected finish</dt><dd class="col-sm-9">@task.WorkEndUtc.Value.AddHours(8).ToString("MMM d, yyyy h:mm tt") PHT</dd> }
                <dt class="col-sm-3" data-i18n>Budget</dt><dd class="col-sm-9">@task.BudgetDisplay</dd>
                @if (!string.IsNullOrWhiteSpace(task.ScheduleText))
                {
                    <dt class="col-sm-3" data-i18n>Preferred schedule</dt><dd class="col-sm-9">@tts.Data.TaskSchedule.Display(task.ScheduleText)</dd>
                }
                @if (Model.IsOwner || Model.IsAssigned)
                {
                    <dt class="col-sm-3" data-i18n>Location</dt><dd class="col-sm-9">@task.Location</dd>
                }
            </dl>
            @if (Model.IsAssigned)
            {
                <a class="task-detail-action task-detail-progress" asp-page="@(tts.Data.JobActivity.IsClosedTask(task.Status) || task.Status == "completed" ? "/JobRecord" : "/Tracking")" asp-route-taskId="@task.Id">@(tts.Data.JobActivity.IsClosedTask(task.Status) || task.Status == "completed" ? "View record" : "View progress")</a>
            }
            else { <a class="task-detail-action" asp-page="/JobRecord" asp-route-taskId="@task.Id" data-i18n>View record</a> }
        </div>
    </article>
</main>
<partial name="_TaskHelp" />
</body>
</html>
