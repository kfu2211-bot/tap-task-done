@page
@model LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" />

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Log in - Tap, Task, Done</title>

    <link rel="stylesheet"
          href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/light-auth.css" asp-append-version="true" />

</head>


<body>

    <div class="login-page">


        <!-- LOGO -->

        <div class="login-logo">

            <div class="login-logo-circle">
                ✓
            </div>

            <span>
                Tap, Task, Done
            </span>

        </div>



        <!-- LOGIN BOX -->

        <div class="login-box">


            <div class="login-eyebrow">WELCOME BACK</div>

            <h1>
                Log in to your account
            </h1>


            <p class="login-subtitle">
                Pick up where you left off and manage your tasks.
            </p>
            @if (TempData["BirthdayMessage"] is string birthdayMessage) { <p class="login-subtitle" role="status">@birthdayMessage</p> }
            @if (Request.Query["suspended"] == "1") { <p class="login-subtitle" role="alert">Your session ended because your account is suspended. Please contact the administrator.</p> }



            <form id="loginForm" method="post" asp-page="/Login" asp-page-handler="Login">
                @Html.AntiForgeryToken()


                <!-- EMAIL -->

                <div class="login-group">

                    <label>
                        EMAIL
                    </label>

                    <input type="email"
                           id="loginEmail"
                           name="email"
                           placeholder="you@example.com"
                           autocomplete="email"
                           required />

                </div>



                <!-- PASSWORD -->

                <div class="login-group">

                    <label>
                        PASSWORD
                    </label>

                    <div class="password-input-wrapper">
                    <input type="password"
                           id="loginPassword"
                           name="password"
                           placeholder="••••••••"
                           autocomplete="current-password"
                           required />
                    <button type="button" class="password-toggle" data-password-toggle="loginPassword" aria-controls="loginPassword" aria-pressed="false" aria-label="Show password">Show</button>
                    </div>

                </div>



                <button type="submit"
                        class="login-button">

                    <span class="login-button-label">Log in</span>
                    <span class="login-spinner" aria-hidden="true" hidden></span>

                </button>


                <p id="loginStatus" class="login-status" role="status" aria-live="polite"></p>
            </form>



            <p class="create-account-text">

                Don't have an account?

                <a href="/">
                    Create an account
                </a>

            </p>
            <p class="create-account-text"><a href="/ForgotPassword">Forgot password?</a></p>


        </div>

    </div>


    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
    <script>
        const loginForm = document.getElementById("loginForm");
        const loginButton = loginForm.querySelector('button[type="submit"]');
        const loginStatus = document.getElementById("loginStatus");
        let loginPending = false;
        let suspensionTimer;
        let loginNavigating = false;

        function setLoginLoading(loading) {
            loginPending = loading;
            loginButton.disabled = loading;
            loginForm.setAttribute("aria-busy", String(loading));
            loginButton.querySelector(".login-button-label").textContent = loading ? "Logging in…" : "Log in";
            loginButton.querySelector(".login-spinner").hidden = !loading;
        }

        // Restore the form when returning through the browser's back/forward cache.
        window.addEventListener("pageshow", function () {
            loginNavigating = false;
            setLoginLoading(false);
            loginStatus.textContent = "";
        });

        document.getElementById("loginForm").addEventListener("submit", async function (event) {
            event.preventDefault();
            if (loginPending) return;
            clearInterval(suspensionTimer);
            setLoginLoading(true);
            loginStatus.textContent = "Signing you in. Please wait…";
            const form = event.currentTarget;
            const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : "";
            const body = new URLSearchParams({
                email: document.getElementById("loginEmail").value.trim(),
                password: document.getElementById("loginPassword").value
            });
            if (token) {
                body.append("__RequestVerificationToken", token);
            }
            try {
                const response = await fetch(form.getAttribute("action") || "/Login?handler=Login", {
                    method: "POST",
                    headers: token ? { RequestVerificationToken: token } : undefined,
                    body,
                    credentials: "same-origin"
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok) {
                    loginStatus.textContent = result.message || "Unable to log in. Please try again.";
                    if (result.suspendedUntilUtc) {
                        const end = Date.parse(result.suspendedUntilUtc);
                        if (Number.isFinite(end)) {
                            const tick = () => {
                                const seconds = Math.max(0, Math.ceil((end - Date.now()) / 1000));
                                if (!seconds) { clearInterval(suspensionTimer); loginStatus.textContent = 'The suspension time has ended. Try logging in again; the server will verify your current account status.'; return; }
                                const days = Math.floor(seconds / 86400), hours = Math.floor(seconds % 86400 / 3600), minutes = Math.floor(seconds % 3600 / 60);
                                loginStatus.textContent = result.message + ` Remaining: ${days}d ${hours}h ${minutes}m ${seconds % 60}s.`;
                            };
                            tick(); suspensionTimer = setInterval(tick, 1000);
                        }
                    }
                    return;
                }
                // Legacy screens use this non-secret display profile; the server cookie is the login credential.
                if (result.redirect === "/VerifyEmail") localStorage.removeItem("tapTaskDoneAccount");
                else localStorage.setItem("tapTaskDoneAccount", JSON.stringify({ name: result.name, email: result.email }));
                loginStatus.textContent = "Login successful. Redirecting…";
                window.location.href = ["/Admin", "/Birthday", "/Dashboard", "/VerifyEmail"].includes(result.redirect) ? result.redirect : "/Dashboard";
                loginNavigating = true;
            } catch (error) {
                loginStatus.textContent = "Unable to reach the server. Please try again.";
            } finally {
                if (!loginNavigating) setLoginLoading(false);
            }
        });
    </script>

</body>

</html>
