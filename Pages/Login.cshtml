@page
@model LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Log in - Tap, Task, Done</title>

    <link rel="stylesheet"
          href="/css/site.css" asp-append-version="true" />

</head>


<body>

    <div class="login-page">


        <!-- LOGO -->

        <div class="login-logo">

            <div class="login-logo-circle">
                ✓
            </div>

            <span>
                Tap, Task, Done
            </span>

        </div>



        <!-- LOGIN BOX -->

        <div class="login-box">


            <div class="login-eyebrow">WELCOME BACK</div>

            <h1>
                Log in to your account
            </h1>


            <p class="login-subtitle">
                Pick up where you left off and manage your tasks.
            </p>



            <form id="loginForm" method="post" asp-page="/Login" asp-page-handler="Login">
                @Html.AntiForgeryToken()


                <!-- EMAIL -->

                <div class="login-group">

                    <label>
                        EMAIL
                    </label>

                    <input type="email"
                           id="loginEmail"
                           name="email"
                           placeholder="you@example.com"
                           autocomplete="email"
                           required />

                </div>



                <!-- PASSWORD -->

                <div class="login-group">

                    <label>
                        PASSWORD
                    </label>

                    <input type="password"
                           id="loginPassword"
                           name="password"
                           placeholder="••••••••"
                           autocomplete="current-password"
                           required />

                </div>



                <button type="submit"
                        class="login-button">

                    Log in <span>→</span>

                </button>


            </form>



            <p class="create-account-text">

                Don't have an account?

                <a href="/">
                    Create an account
                </a>

            </p>
            <p class="create-account-text">Password reset is not available yet.</p>

            <p class="create-account-text">
                Are you an administrator?
                <a href="/AdminLogin">Admin sign in</a>
            </p>


        </div>

    </div>


    <script>
        document.getElementById("loginForm").addEventListener("submit", async function (event) {
            event.preventDefault();
            const form = event.currentTarget;
            const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : "";
            const body = new URLSearchParams({
                email: document.getElementById("loginEmail").value.trim(),
                password: document.getElementById("loginPassword").value
            });
            if (token) {
                body.append("__RequestVerificationToken", token);
            }
            try {
                const response = await fetch(form.getAttribute("action") || "/Login?handler=Login", {
                    method: "POST",
                    headers: token ? { RequestVerificationToken: token } : undefined,
                    body,
                    credentials: "same-origin"
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok) { alert(result.message || "Unable to log in. Please check the database connection."); return; }
                // Legacy screens use this non-secret display profile; the server cookie is the login credential.
                localStorage.setItem("tapTaskDoneAccount", JSON.stringify({ name: result.name, email: result.email }));
                window.location.href = "/Dashboard";
            } catch (error) { alert("Unable to reach the server. Please try again."); }
        });
    </script>
    <script src="/js/admin-auth.js" asp-append-version="true"></script>

</body>

</html>
