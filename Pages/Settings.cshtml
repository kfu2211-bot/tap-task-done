@page
@model tts.Pages.SettingsModel
@{ Layout = null; var showProfile = Request.Query["view"] == "profile"; var pageTitle = showProfile ? "Profile" : "Settings"; }
<!DOCTYPE html>
<html lang="en">
<head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - Tap, Task, Done</title>
    <link rel="stylesheet" href="/css/settings.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/readability.css" asp-append-version="true" />
    <script defer src="/js/sidebar-account.js" asp-append-version="true"></script>
    <script defer src="/js/profile-photo.js" asp-append-version="true"></script>
<link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/settings-polish.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/sidebar-consistency.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/workspace-spacing.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/account-workspace.css" asp-append-version="true" />
    <script defer src="/js/work-preferences.js" asp-append-version="true"></script>
<partial name="_AccountTheme" /></head>
<body>
    <div class="settings-layout">
        <aside class="sidebar">
            <a class="brand" asp-page="/Landing" aria-label="Tap, Task, Done landing page" style="text-decoration:none"><span class="brand-icon">✓</span><strong>Tap, Task, Done</strong></a>
            <nav class="sidebar-menu">
                <a href="/Dashboard"><span class="menu-icon">⌂</span><span>Home</span></a>
                <a href="/FindPost"><span class="menu-icon">⌕</span><span>Find &amp; Post</span></a>
                <a href="/MyTasks"><span class="menu-icon">▤</span><span>My Tasks</span></a>
                <a href="/Messages"><span class="menu-icon">□</span><span>Messages</span></a>
                <a href="/Tracking"><span class="menu-icon">➤</span><span>Tracking</span></a>
                <a href="/Reviews"><span class="menu-icon">☆</span><span>Reviews</span></a>
            </nav>
            <div class="sidebar-account"><span class="account-avatar">U</span><div><strong id="sidebarName">User</strong><span id="sidebarEmail">user@email.com</span></div></div>
        </aside>
        <main>
            <header><h1>@pageTitle</h1></header>
            <section class="settings-content account-workspace">
                @if (showProfile)
                {
                <div class="page-intro">
                    <h2>Your profile</h2>
                    <p>Manage your display name and profile photo.</p>
                </div>
                <section class="settings-card account-card">
                    <h2>Account profile</h2>
                    <div class="profile-summary" aria-label="Current profile">
                        <span id="profileAvatar" class="profile-avatar">@(Model.DisplayName.FirstOrDefault())</span>
                        <div><strong id="profileSummaryName" data-own-account-name>@Model.DisplayName</strong><span id="profileSummaryEmail">@Model.Email</span></div>
                        
                    </div>
                    <section class="photo-settings" aria-labelledby="photoHeading">
                        <div class="photo-settings-copy"><h3 id="photoHeading">Profile photo</h3><p>Use a clear photo so people can recognize you.</p></div>
                        <div class="photo-actions">
                            <label class="photo-upload-button" for="profilePhotoInput">Change photo</label>
                            <input id="profilePhotoInput" type="file" accept="image/jpeg,image/png,image/webp" />
                            <div id="profilePhotoToken" hidden>@Html.AntiForgeryToken()</div>
                            <dialog id="profilePhotoCrop" aria-labelledby="profilePhotoCropTitle">
                                <h2 id="profilePhotoCropTitle">Crop profile photo</h2>
                                <p class="crop-hint">Adjust the image inside the circle before saving.</p>
                                <canvas width="320" height="320" role="img" aria-label="Circular crop preview"></canvas>
                                <p><label>Zoom <input type="range" min="1" max="3" step="0.01" value="1" /></label></p>
                                <p><label>Horizontal position <input type="range" min="0" max="100" value="50" /></label></p>
                                <p><label>Vertical position <input type="range" min="0" max="100" value="50" /></label></p>
                                <form method="dialog">
                                    <button type="submit">Cancel</button>
                                    <button type="button" data-save-crop>Save photo</button>
                                </form>
                            </dialog>
                            <button id="removePhotoButton" class="remove-photo-button" type="button">Remove photo</button>
                            <span class="photo-file-note">JPG, PNG or WEBP · Max 5 MB</span>
                            <p id="photoMessage" class="photo-message" aria-live="polite"></p>
                        </div>
                    </section>
                </section>
                <section class="settings-card profile-personal-details" aria-labelledby="personalDetailsTitle">
                    <h2 id="personalDetailsTitle">Personal details</h2>
                    <dl>
                        <div><dt>Display name</dt><dd>@Model.DisplayName</dd></div>
                        <div><dt>Login email</dt><dd>@Model.Email</dd></div>
                        <div><dt>Date of birth</dt><dd>@(Model.DateOfBirth?.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "Not provided")</dd></div>
                        <div><dt>Phone number</dt><dd>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</dd></div>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(Model.Message))
                    {
                        <p role="status">@Model.Message</p>
                    }
                    <details class="profile-name-editor" open="@(Request.Query["editName"] == "True" ? "open" : null)">
                        <summary>Edit display name</summary>
                        <form method="post" asp-page-handler="DisplayName">
                            <div class="profile-name-fields">
                                <label for="profileFirstName">First name
                                    <input id="profileFirstName" name="firstName" value="@Model.FirstName" autocomplete="given-name" maxlength="45" required />
                                </label>
                                <label for="profileLastName">Last name (optional)
                                    <input id="profileLastName" name="lastName" value="@Model.LastName" autocomplete="family-name" maxlength="45" />
                                </label>
                            </div>
                            <button class="settings-security-link" type="submit">Save display name</button>
                        </form>
                    </details>
                    <details class="profile-name-editor">
                        <summary>Edit phone number</summary>
                        @if (Model.ContactUnavailable) { <p>Contact settings are temporarily unavailable.</p> }
                        else { <form method="post" asp-page-handler="Contact" class="profile-contact-form"><label>Phone number (optional)<input name="phoneNumber" type="tel" maxlength="25" autocomplete="tel" value="@Model.PhoneNumber" /></label><p>Choose when to share your number from the task conversation in Messages.</p><button class="settings-security-link" type="submit">Save contact details</button></form> }
                    </details>
                </section>
                @if (Model.WorkRole is "freelancer" or "both")
                {
                    <section class="settings-card profile-personal-details" aria-labelledby="workSummaryTitle">
                        <h2 id="workSummaryTitle">Work summary</h2>
                        <dl>
                            <div><dt>Service</dt><dd>@(string.IsNullOrWhiteSpace(Model.Service) ? "Not set" : Model.Service)</dd></div>
                            <div><dt>Service location</dt><dd>@(string.IsNullOrWhiteSpace(Model.Location) ? "Not set" : Model.Location)</dd></div>
                            <div><dt>Rate range</dt><dd>@(Model.Rate is int rate ? $"₱{rate:N0} – ₱{(Model.RateMaximum ?? rate):N0}" : "Not set")</dd></div>
                        </dl>
                    </section>
                }
                <section class="settings-card signout-card profile-shortcuts" aria-labelledby="profileShortcutsTitle">
                    <div>
                        <h2 id="profileShortcutsTitle">Manage your account</h2>
                        <p>Update your work preferences or review where your account is signed in.</p>
                    </div>
                    <div class="profile-shortcut-links">
                        <a class="settings-security-link" href="/Settings">Work preferences</a>
                        <a class="settings-security-link" href="/Security">Security &amp; devices</a>
                    </div>
                </section>
                }
                else
                {
                <div class="page-intro">
                    <h2>Account settings</h2>
                    <p>Manage your work preferences, availability, and account security.</p>
                </div>
                <div class="account-settings-grid">
                <form method="post" id="profileForm" class="settings-card account-card">
                    <div class="account-role" id="work-preferences"><h3 id="workRoleTitle">Work role</h3><select aria-labelledby="workRoleTitle" aria-describedby="workRoleHelp" asp-for="WorkRole"><option value="client">Client</option><option value="freelancer">Freelancer</option><option value="both">Client &amp; Freelancer</option></select><p id="workRoleHelp" class="form-message"></p></div><div id="freelancerPreferences"><fieldset class="settings-group work-group">
                        <legend>Service details</legend>
                        <div class="field-grid work-field-grid">
                            <div class="service-choice">
                                <strong>Services offered</strong>
                                <details>
                                    <summary>Add services</summary>
                                    <div class="service-checkboxes">
                                        @foreach (var service in SettingsModel.ServiceOptions)
                                        {
                                            <label><input type="checkbox" name="Services" value="@service" checked="@Model.Services.Contains(service)" /> @service</label>
                                        }
                                    </div>
                                </details>
                                <div id="selectedServices"></div>
                                <label id="otherServiceField">Specify your service<input asp-for="OtherService" maxlength="60" /></label>
                            </div>
                            <div class="service-choice">
                                <strong>Service areas</strong>
                                <div class="service-checkboxes">
                                    <label><input type="checkbox" id="selectAllServiceAreas" /> Select all 5 areas</label>
                                    @foreach (var area in tts.Pages.BacolorServiceAreas.Names)
                                    {
                                        <label><input type="checkbox" name="Areas" value="@area" checked="@Model.Areas.Contains(area)" /> @area</label>
                                    }
                                </div>
                            </div>
                            <label>Minimum rate (₱)<input asp-for="Rate" type="number" min="1" step="1" placeholder="e.g. 500" /></label>
                            <label>Maximum rate (₱)<input asp-for="RateMaximum" type="number" min="1" step="1" placeholder="e.g. 1000" /></label>
                            
                            
                        </div>
                    </fieldset>
                    <fieldset class="settings-group"><legend>Availability</legend><div class="field-grid"><label>Availability preference<select asp-for="Availability"><option value="Available">Available</option><option value="Busy">Busy</option><option value="Day off">Day off</option></select></label></div><div class="availability-summary"><span>Current status <strong class="account-status">@Model.EffectiveAvailability</strong></span><p>Your chosen availability returns after work is finished or cancelled. You can accept new work while awaiting client confirmation.</p></div>
                    <h4>Weekly availability</h4><p class="form-message">Choose the days you normally accept work.</p><div id="weeklyAvailability">@foreach (var day in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" }) { <label class="weekly-day"><input type="checkbox" name="Days" value="@day" checked="@Model.Days.Contains(day)" /><span>@day</span></label> } <button type="button" id="selectAllDays" class="weekly-day">All</button></div></fieldset>
                    </div><div class="save-row"><p id="profileSavedMessage" class="form-message" aria-live="polite">@Model.Message</p><button class="primary-button" type="submit">Save changes</button></div>
                </form>
                    <section class="settings-card account-shortcuts" aria-labelledby="accountShortcutsTitle">
                        <h3 id="accountShortcutsTitle">Account shortcuts</h3>
                        <a href="/Settings?view=profile"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2Z"/></svg>View profile</a>
                        <a href="/Security"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M12 17v4m-5 0h10"/></svg>Security &amp; devices</a>
                    </section>
                </div>
                <section class="settings-card demo-card" aria-labelledby="demoDataHeading" hidden>
                    <div class="demo-title"><h2 id="demoDataHeading">Saved data</h2><span>On this device</span></div>
                    <p>Clear tasks, offers, messages, reviews, reports, and notifications. Your profile stays saved.</p>
                    <div class="demo-actions"><button id="resetDemoButton" class="danger-button" type="button">⌫&nbsp; Clear saved data</button><span class="demo-hint">Use this only when you want to start over.</span></div>
                </section>
                <section class="settings-card signout-card" aria-labelledby="deleteAccountHeading">
                    <div>
                        <h2 id="deleteAccountHeading">Delete account</h2>
                        <p>Request deletion with a 72-hour waiting period and admin review.</p>
                    </div>
                    <a class="signout-button settings-delete-link" href="/AccountDeletion">Delete account</a>
                </section>
                }
            </section>
        </main>
    </div>

    <partial name="_TaskHelp" />
</body>
</html>
