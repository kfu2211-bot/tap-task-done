@page
@model tts.Pages.SettingsModel
@{ Layout = null; var showProfile = Request.Query["view"] == "profile"; var pageTitle = showProfile ? "Profile" : "Settings"; }
<!DOCTYPE html>
<html lang="en">
<head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - Tap, Task, Done</title>
    <link rel="stylesheet" href="/css/settings.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/readability.css" asp-append-version="true" />
    <script defer src="/js/sidebar-account.js" asp-append-version="true"></script>
    <script defer src="/js/profile-photo.js" asp-append-version="true"></script>
<link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/settings-polish.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/sidebar-consistency.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/workspace-spacing.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/account-workspace.css" asp-append-version="true" />
    <script defer src="/js/work-preferences.js" asp-append-version="true"></script>
</head>
<body>
    <div class="settings-layout">
        <aside class="sidebar">
            <div class="brand"><span class="brand-icon">✓</span><strong>Tap, Task, Done</strong></div>
            <nav class="sidebar-menu">
                <a href="/Dashboard"><span class="menu-icon">⌂</span><span>Home</span></a>
                <a href="/FindPost"><span class="menu-icon">⌕</span><span>Find &amp; Post</span></a>
                <a href="/MyTasks"><span class="menu-icon">▤</span><span>My Tasks</span></a>
                <a href="/Messages"><span class="menu-icon">□</span><span>Messages</span></a>
                <a href="/Tracking"><span class="menu-icon">➤</span><span>Tracking</span></a>
                <a href="/Reviews"><span class="menu-icon">☆</span><span>Reviews</span></a>
            </nav>
            <div class="sidebar-account"><span class="account-avatar">U</span><div><strong id="sidebarName">User</strong><span id="sidebarEmail">user@email.com</span></div></div>
        </aside>
        <main>
            <header><h1>@pageTitle</h1></header>
            <section class="settings-content account-workspace">
                @if (showProfile)
                {
                <div class="page-intro">
                    <h2>Your profile</h2>
                    <p>View your account details and manage your profile photo.</p>
                </div>
                <section class="settings-card account-card">
                    <h2>Account profile</h2>
                    <div class="profile-summary" aria-label="Current profile">
                        <span id="profileAvatar" class="profile-avatar">@(Model.DisplayName.FirstOrDefault())</span>
                        <div><strong id="profileSummaryName" data-own-account-name>@Model.DisplayName</strong><span id="profileSummaryEmail">@Model.Email</span></div>
                        
                    </div>
                    <section class="photo-settings" aria-labelledby="photoHeading">
                        <div class="photo-settings-copy"><h3 id="photoHeading">Profile photo</h3><p>Use a clear photo so people can recognize you.</p></div>
                        <div class="photo-actions">
                            <label class="photo-upload-button" for="profilePhotoInput">Change photo</label>
                            <input id="profilePhotoInput" type="file" accept="image/jpeg,image/png,image/webp" />
                            <button id="removePhotoButton" class="remove-photo-button" type="button">Remove photo</button>
                            <span class="photo-file-note">JPG, PNG or WEBP · Max 5 MB</span>
                            <span class="photo-storage-note">Your photo is securely saved to your account.</span>
                            <p id="photoMessage" class="photo-message" aria-live="polite"></p>
                        </div>
                    </section>
                </section>
                <section class="settings-card signout-card profile-shortcuts" aria-labelledby="profileShortcutsTitle">
                    <div>
                        <h2 id="profileShortcutsTitle">Manage your account</h2>
                        <p>Update your work preferences or review where your account is signed in.</p>
                    </div>
                    <div class="profile-shortcut-links">
                        <a class="settings-security-link" href="/Settings">Work preferences</a>
                        <a class="settings-security-link" href="/Security">Security &amp; devices</a>
                    </div>
                </section>
                }
                else
                {
                <div class="page-intro">
                    <h2>Account settings</h2>
                    <p>Manage your work preferences, availability, and account security.</p>
                </div>
                <form method="post" id="profileForm" class="settings-card account-card">
                    <div class="account-role"><label>Work role<select asp-for="WorkRole"><option value="client">Client</option><option value="freelancer">Freelancer</option><option value="both">Client &amp; Freelancer</option></select></label></div><div id="freelancerPreferences"><fieldset class="settings-group work-group">
                        <legend>Work preferences</legend>
                        <div class="field-grid work-field-grid">
                            <label>Service / profession<input asp-for="Service" maxlength="60" placeholder="e.g. Plumber or balloon artist" /><small>Describe your specific skill so clients can find it, including unique services.</small></label>
                            <label>Service location<input asp-for="Location" maxlength="80" placeholder="e.g. Bacolor, Pampanga" /><small>Provide your barangay or service area within Bacolor, Pampanga.</small></label>
                            <label>Rate per task (₱)<input asp-for="Rate" type="number" min="1" step="1" placeholder="e.g. 600" /></label>
                            
                            <label>Availability preference<select asp-for="Availability"><option value="Available">Available</option><option value="Busy">Busy</option><option value="Day off">Day off</option></select></label>
                        </div>
                    </fieldset>
                    <p class="form-message">Current status <strong class="account-status">@Model.EffectiveAvailability</strong><br />Your availability preference resumes when work finishes or is cancelled. Waiting for client confirmation does not block new work.</p>
                    <fieldset class="settings-group"><legend>Weekly availability</legend><p class="form-message">Choose the days you normally accept work.</p><div id="weeklyAvailability">@foreach (var day in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" }) { <label class="weekly-day"><input type="checkbox" name="Days" value="@day" checked="@Model.Days.Contains(day)" /><span>@day</span></label> }</div></fieldset>
                    </div><div class="save-row"><p id="profileSavedMessage" class="form-message" aria-live="polite">@Model.Message</p><button class="primary-button" type="submit">Save changes</button></div>
                </form>
                <section class="settings-card demo-card" aria-labelledby="demoDataHeading" hidden>
                    <div class="demo-title"><h2 id="demoDataHeading">Saved data</h2><span>On this device</span></div>
                    <p>Clear tasks, offers, messages, reviews, reports, and notifications. Your profile stays saved.</p>
                    <div class="demo-actions"><button id="resetDemoButton" class="danger-button" type="button">⌫&nbsp; Clear saved data</button><span class="demo-hint">Use this only when you want to start over.</span></div>
                </section>
                <section class="settings-card signout-card"><div><h2>Security &amp; devices</h2><p>Review sign-in alerts, active sessions and trusted browsers.</p></div><a class="settings-security-link" href="/Security">Manage security</a></section>
                <section class="settings-card signout-card" aria-labelledby="deleteAccountHeading">
                    <div>
                        <h2 id="deleteAccountHeading">Delete account</h2>
                        <p>Request deletion with a 72-hour waiting period and admin review.</p>
                    </div>
                    <a class="signout-button settings-delete-link" href="/AccountDeletion">Delete account</a>
                </section>
                }
            </section>
        </main>
    </div>
</body>
</html>
