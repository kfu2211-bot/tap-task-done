@page
@model tts.Pages.AccountDeletionModel
@using tts.Data
@{ Layout = null; }
<!doctype html><html lang="en"><head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" asp-append-version="true" /><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Delete account - Tap, Task, Done</title><link rel="stylesheet" href="~/css/login-security.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/account-deletion.css" asp-append-version="true"/><partial name="_AccountTheme" /></head>
<body><main class="security-page deletion-page">
<header class="security-page-header"><div><p class="security-eyebrow">ACCOUNT SETTINGS</p><h1>Delete account</h1><p>A reviewed process, with time to change your mind.</p></div><a class="security-return" href="/Settings">Back to Settings</a></header>
@if(Model.Notice is not null){<p class="security-notice" role="status">@Model.Notice</p>}
@if(Model.Unavailable){<section class="security-card"><h2>Temporarily unavailable</h2><p>Account deletion storage is not ready. Your account has not been deleted.</p></section>}
else if(Model.IsStaff){<section class="security-card"><h2>Staff account</h2><p>Ask another administrator to arrange a staff access handover. Staff accounts cannot use self-service deletion.</p></section>}
else {
<section class="security-card"><h2>Before you leave</h2><ol class="deletion-steps"><li><strong>Verify your request</strong><span>Confirm your password and an email code.</span></li><li><strong>Wait at least 72 hours</strong><span>You can cancel before final deletion.</span></li><li><strong>Admin review</strong><span>Outstanding work and safety cases must be resolved.</span></li></ol><p>After deletion, your profile, photo, login credentials and identity uploads are removed. Work, conversation and safety records needed for accountability remain linked to “Deleted user.” Deletion does not cancel obligations or erase another participant's history.</p></section>
@if(Model.RequestRow is { } r && (AccountDeletion.Pending(r.Status) || r.Status == "rejected")) {
<section class="security-card"><div class="security-section-heading"><h2>Request status</h2><span class="security-count">@(r.Status == "held" ? "On hold" : r.Status == "approved" ? "Approved — waiting period" : r.Status == "rejected" ? "Rejected" : "Pending review")</span></div><p>Submitted: @DisplayTime.Philippine(r.RequestedUtc ?? r.UpdatedUtc)</p><p><strong>Earliest deletion:</strong> @DisplayTime.Philippine(r.EligibleUtc ?? r.UpdatedUtc) PHT. This is not a guaranteed deletion time. Admin approval and a final commitment check are required.</p>@if(r.ReviewReason is not null){<div class="deletion-review"><strong>Admin review</strong><p>@r.ReviewReason</p></div>}
<div class="deletion-actions">@if(AccountDeletion.Pending(r.Status)){<form method="post"><input type="hidden" name="action" value="cancel"/><button type="submit">Cancel deletion request</button></form>}@if(r.Status is "held" or "rejected"){<form method="post"><input type="hidden" name="action" value="review"/><button class="security-secondary" type="submit">Request another review</button></form>}</div><p>While pending or on hold, new tasks, offers and bookings are paused. You can still resolve existing work and messages.</p></section>
} else if(Model.RequestRow?.Status == "deleted") {<section class="security-card"><h2>Account deleted</h2><p>This account is no longer accessible.</p></section>}
else {
@if(Model.RequestRow?.Status == "verifying"){<section class="security-card"><h2>Confirm your request</h2><p>Enter the six-digit code sent to your registered email. It expires after 10 minutes. No deletion will happen immediately.</p><form method="post"><input type="hidden" name="action" value="confirm"/><label>Verification code<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required/></label><button type="submit">Verify deletion request</button></form></section>}
<section class="security-card deletion-danger"><h2>@(Model.RequestRow?.Status == "verifying" ? "Need another code?" : "Request account deletion")</h2><p>This submits a request for review. The 72-hour waiting period starts only after email verification.</p><form method="post"><input type="hidden" name="action" value="start"/><label>Current password<input name="password" type="password" autocomplete="current-password" maxlength="256" required/></label><label class="deletion-check"><input type="checkbox" name="acknowledge" value="true" required/><span>I understand the waiting period, admin review and retention of transaction/safety history.</span></label><button class="deletion-danger-button" type="submit">@(Model.RequestRow?.Status == "verifying" ? "Resend confirmation code" : "Send confirmation code")</button></form></section>
}
@if(Model.Blockers.Count>0){<section class="security-card"><h2>Items to resolve</h2><ul>@foreach(var item in Model.Blockers){<li>@item</li>}</ul><p>Admins also review reported issues that cannot be linked automatically.</p><div class="deletion-actions"><a class="security-return" href="/MarketTasks?view=mine">Open My Tasks</a><a class="security-return" href="/MyJobs">Open My Jobs</a>@if(Model.RequestRow is { } activeRequest && AccountDeletion.Pending(activeRequest.Status)){<form method="post"><input type="hidden" name="action" value="withdraw-offers"/><button class="security-secondary" type="submit">Withdraw my pending offers</button></form>}</div></section>}
@if(Model.History.Count>0){<section class="security-card"><h2>Request history</h2>@foreach(var item in Model.History){<div class="security-row"><div><strong>@item.Action</strong><small>@DisplayTime.Philippine(item.CreatedUtc) PHT</small><p>@item.Reason</p></div></div>}</section>}
}
</main>
    <partial name="_TaskHelp" />
</body></html>
