@page
@model tts.Pages.VerifyEmailModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Verify email - Tap, Task, Done</title>
    <link rel="stylesheet" href="~/css/login-security.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/email-verification.css" asp-append-version="true" />
    <script src="~/js/registration-verification.js" asp-append-version="true" defer></script>
</head>
<body class="email-verification-page">
<div class="email-verification-shell">
<main class="email-verification-card">
    <a class="verification-brand" href="/Index"><span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 12 4 4L19 6" /></svg></span>Tap, Task, Done</a>
    <nav class="verification-steps" aria-label="Registration progress"><span>Create account</span><span aria-hidden="true">/</span><strong aria-current="step">@(Model.Completed ? "Email verified" : "Verify email")</strong></nav>
    <div class="verification-heading">
        <span class="verification-envelope" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">@if(Model.Completed) { <path d="m5 12 4 4L19 6" /> } else { <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/> }</svg></span>
        <div><h1>@(Model.Completed ? "Email verified" : "Verify your email")</h1>
        @if(Model.Completed) { <p>Your account is ready. Please log in with <strong>@Model.DestinationEmail</strong></p> }
        else if(Model.Pending) { <p>Enter the 6-digit code for <strong>@Model.DestinationEmail</strong></p> }
        else { <p>Finish verifying your email to start using your account.</p> }</div>
    </div>
    @if(Model.Completed) {
        <p class="verification-success" role="status">Your email has been verified successfully.</p>
        <a class="verification-primary verification-login" href="/Login">Go to login</a>
        <p class="verification-note">Verification did not sign you in automatically.</p>
    } else {
        @if(Model.RegistrationNotice is not null) { <div class="verification-status" role="status"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 10v7m0-11v1"/></svg><div><strong>Verification pending</strong><p>@Model.RegistrationNotice</p></div></div> }
        @if(Model.ErrorMessage is not null) { <p class="verification-error" role="alert">@Model.ErrorMessage</p> }
        @if(Model.Pending) {
            <form method="post" asp-page-handler="Confirm" class="verification-code-form" data-code-form>
                <label id="verification-code-label" for="Code">Verification code</label>
                <input asp-for="Code" data-code-source inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" aria-describedby="verification-expiry" required autofocus />
                <p id="verification-expiry" class="verification-expiry">Code expires in 10 minutes</p>
                <button type="submit" class="verification-primary" data-idle-label="Verify email">Verify email</button>
            </form>
            <form method="post" asp-page-handler="Resend" class="verification-resend" data-resend-seconds="@Model.ResendSeconds">
                <button type="submit" disabled="@(Model.ResendSeconds > 0)" data-idle-label="Resend code">Resend code</button>
                <span class="verification-resend-divider" aria-hidden="true"></span>
                <small role="status" data-resend-label>@(Model.ResendSeconds > 0 ? $"Available in 00:{Model.ResendSeconds:D2}" : "You can request a new code.")</small>
            </form>
            <details class="verification-change">
                <summary><span class="verification-change-question"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m15 5 4 4M4 20l4-1L20 7a2.8 2.8 0 0 0-4-4L4 15Z"/></svg>Wrong email address?</span><span class="verification-change-action">Change email</span></summary>
                <p>Enter the correct email and your registration password. Your login email changes only after you verify the new address.</p>
                <form method="post" asp-page-handler="Change"><label>Correct email<input asp-for="NewEmail" type="email" autocomplete="email" maxlength="45" required /></label><label>Registration password<input asp-for="Password" type="password" autocomplete="current-password" maxlength="256" required /></label><button type="submit" class="verification-primary" data-idle-label="Send new code">Send new code</button></form>
            </details>
        } else {
            <p class="verification-resume">Create an account, or log in with your email and password to resume a pending registration.</p><a class="verification-primary verification-login" href="/Index">Create account</a>
        }
        <a class="verification-back" href="/Login"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m10 5-7 7 7 7M3 12h18"/></svg>Back to login</a>
    }
</main>
<p class="verification-footer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>Your email helps keep your account secure.</p>
</div>
</body>
</html>
