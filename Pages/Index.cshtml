@page
@model IndexModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" />

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Create an Account - Tap, Task, Done</title>

    <link rel="stylesheet"
          href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/light-auth.css" asp-append-version="true" />

</head>


<body>

    <div class="page">

        <!-- ================================= -->
        <!-- LEFT SIDE -->
        <!-- ================================= -->

        <div class="left-side">

            <div class="logo">

                <div class="logo-circle">
                    ✓
                </div>

                <span>
                    Tap, Task, Done
                </span>

            </div>


            <div class="left-content">

                <div class="badge">
                    ✦ TRUSTED LOCAL PROS, ON DEMAND
                </div>

                <h2>
                    Local help,<br />
                    made simple.
                </h2>

                <p>
                    Find the right person for your everyday tasks.
                </p>


                <div class="signup-steps" aria-label="How Tap, Task, Done works">
                    <div class="signup-step">
                        <span class="signup-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="13" height="18" rx="2"/><path d="M8 8h5M8 12h5M17 14v7M13.5 17.5h7"/></svg></span>
                        <strong>Post a task</strong>
                        <span>Share what you need help with.</span>
                    </div>
                    <div class="signup-step">
                        <span class="signup-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="3.5"/><path d="M5 20v-2a7 7 0 0 1 14 0v2H5Z"/></svg></span>
                        <strong>Connect</strong>
                        <span>Connect with a freelancer.</span>
                    </div>
                    <div class="signup-step">
                        <span class="signup-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L19 7"/></svg></span>
                        <strong>Get it done</strong>
                        <span>Complete your task together.</span>
                    </div>
                </div>

            </div>


            <div class="copyright">
                © 2026 Tap, Task, Done. All rights reserved.
            </div>

        </div>



        <!-- ================================= -->
        <!-- RIGHT SIDE -->
        <!-- ================================= -->

        <div class="right-side">

            <div class="register-box">


                <div class="signup-eyebrow">JOIN THE COMMUNITY</div>

                <h1>
                    Create an Account
                </h1>

                <p class="signup-subtitle">Start finding trusted local help today.</p>
                <p class="signup-demo-notice" role="status">Enter your first and last name. You must be at least 16 years old to register.</p>
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <p class="signup-demo-notice" role="alert">@Model.ErrorMessage</p>
                }


                <form id="registerForm" method="post" asp-page="/Index" asp-page-handler="Register">

                    <!-- NAME -->

                    <div class="form-group">

                        <label>
                            NAME
                        </label>

                        <input type="text"
                               id="name"
                               name="Name"
                               value="@Model.Name"
                               placeholder="Your full name"
                               autocomplete="name"
                               required />

                    </div>


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label>
                            EMAIL
                        </label>

                        <input type="email"
                               id="email"
                               name="Email"
                               value="@Model.Email"
                               placeholder="you@example.com"
                               autocomplete="email"
                               required />

                    </div>


               
                    <!-- PASSWORD -->

                    <div class="form-group password-group">

                        <label>PASSWORD</label>

                        <div class="password-input-wrapper">

                            <input type="password"
                                   id="password"
                                   name="password"
                                   placeholder="Create a strong password"
                                   autocomplete="new-password"
                                   required
                                   minlength="8" />

                            <button type="button" class="password-toggle" data-password-toggle="password" aria-controls="password" aria-pressed="false" aria-label="Show password">Show</button>

                            <div id="passwordPopup"
                                 class="password-popup">

                                <div class="password-popup-title">
                                    Password requirements
                                </div>

                                <div id="ruleLength" class="password-rule">
                                    <span>○</span>
                                    At least 8 characters
                                </div>

                                <div id="ruleUpper" class="password-rule">
                                    <span>○</span>
                                    One uppercase letter
                                </div>

                                <div id="ruleLower" class="password-rule">
                                    <span>○</span>
                                    One lowercase letter
                                </div>

                                <div id="ruleNumber" class="password-rule">
                                    <span>○</span>
                                    One number
                                </div>

                                <div id="ruleSpecial" class="password-rule">
                                    <span>○</span>
                                    One special character
                                </div>

                                <div id="strengthText"
                                     class="password-strength-text">
                                    Enter a strong password
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- DATE OF BIRTH -->

                    <input type="hidden" id="birthMonth" name="BirthMonth" value="@Model.BirthMonth" />
                    <input type="hidden" id="birthDay" name="BirthDay" value="@Model.BirthDay" />
                    <input type="hidden" id="birthYear" name="BirthYear" value="@Model.BirthYear" />

                    <div class="form-group">

                        <label>
                            DATE OF BIRTH
                        </label>


                        <div class="date-row">

                            <!-- MONTH -->

                            <div class="custom-dropdown"
                                 id="monthDropdown">

                                <button type="button"
                                        class="dropdown-button">

                                    <span>
                                        Month
                                    </span>

                                    <span class="arrow">
                                        ⌄
                                    </span>

                                </button>


                                <div class="dropdown-menu">

                                    <div class="dropdown-option"
                                         data-value="1">
                                        January
                                    </div>

                                    <div class="dropdown-option"
                                         data-value="2">
                                        February
                                    </div>

                                    <div class="dropdown-option"
                                         data-value="3">
                                        March
                                    </div>

                                    <div class="dropdown-option"
                                         data-value="4">
                                        April
                                    </div>

                                    <div class="dropdown-option"
                                         data-value="5">
                                        May
                                    </div>

                                    <div class="dropdown-option"
                                         data-value="6">
                                        June
                                    </div>

                                    <div class="dropdown-option"
                                         data-value="7">
                                        July
                                    </div>

                                    <div class="dropdown-option"
                                         data-value="8">
                                        August
                                    </div>

                                    <div class="dropdown-option"
                                         data-value="9">
                                        September
                                    </div>

                                    <div class="dropdown-option"
                                         data-value="10">
                                        October
                                    </div>

                                    <div class="dropdown-option"
                                         data-value="11">
                                        November
                                    </div>

                                    <div class="dropdown-option"
                                         data-value="12">
                                        December
                                    </div>

                                </div>

                            </div>


                            <!-- DAY -->

                            <div class="custom-dropdown"
                                 id="dayDropdown">

                                <button type="button"
                                        class="dropdown-button">

                                    <span>
                                        Day
                                    </span>

                                    <span class="arrow">
                                        ⌄
                                    </span>

                                </button>


                                <div class="dropdown-menu">

                                    <div class="dropdown-option" data-value="1">1</div>
                                    <div class="dropdown-option" data-value="2">2</div>
                                    <div class="dropdown-option" data-value="3">3</div>
                                    <div class="dropdown-option" data-value="4">4</div>
                                    <div class="dropdown-option" data-value="5">5</div>
                                    <div class="dropdown-option" data-value="6">6</div>
                                    <div class="dropdown-option" data-value="7">7</div>
                                    <div class="dropdown-option" data-value="8">8</div>
                                    <div class="dropdown-option" data-value="9">9</div>
                                    <div class="dropdown-option" data-value="10">10</div>
                                    <div class="dropdown-option" data-value="11">11</div>
                                    <div class="dropdown-option" data-value="12">12</div>
                                    <div class="dropdown-option" data-value="13">13</div>
                                    <div class="dropdown-option" data-value="14">14</div>
                                    <div class="dropdown-option" data-value="15">15</div>
                                    <div class="dropdown-option" data-value="16">16</div>
                                    <div class="dropdown-option" data-value="17">17</div>
                                    <div class="dropdown-option" data-value="18">18</div>
                                    <div class="dropdown-option" data-value="19">19</div>
                                    <div class="dropdown-option" data-value="20">20</div>
                                    <div class="dropdown-option" data-value="21">21</div>
                                    <div class="dropdown-option" data-value="22">22</div>
                                    <div class="dropdown-option" data-value="23">23</div>
                                    <div class="dropdown-option" data-value="24">24</div>
                                    <div class="dropdown-option" data-value="25">25</div>
                                    <div class="dropdown-option" data-value="26">26</div>
                                    <div class="dropdown-option" data-value="27">27</div>
                                    <div class="dropdown-option" data-value="28">28</div>
                                    <div class="dropdown-option" data-value="29">29</div>
                                    <div class="dropdown-option" data-value="30">30</div>
                                    <div class="dropdown-option" data-value="31">31</div>

                                </div>

                            </div>


                            <!-- YEAR -->

                            <div class="custom-dropdown"
                                 id="yearDropdown">

                                <button type="button"
                                        class="dropdown-button">

                                    <span>
                                        Year
                                    </span>

                                    <span class="arrow">
                                        ⌄
                                    </span>

                                </button>


                                <div class="dropdown-menu"
                                     id="yearOptions">
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- SIGN UP -->

                    <button type="submit"
                            class="signup-button"
                            asp-page="/Index"
                            asp-page-handler="Register">

                        Create account

                    </button>

                </form>

                <div class="already">
                    Already have an account?
                    <a href="/Login">Log in</a>
                </div>

            </div>

        </div>

    </div>


    <!-- SUCCESS POPUP -->

    <div id="successOverlay" class="success-overlay@(Model.AccountCreated ? " show" : "")">

        <div class="success-card">

            <div class="success-icon">
                ✓
            </div>

            <h2>
                You're all set
            </h2>

            <p>
                Congratulations, your account has been
                successfully created. Let's find your first task.
            </p>

            <form method="get" action="/Login">
                <button type="submit" id="continueButton">
                    Continue
                </button>
            </form>

        </div>

    </div>


    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
    <script>
        (function () {
            const isAppleMobile =
                /iPhone|iPad|iPod/i.test(navigator.userAgent);

            if (isAppleMobile) {
                document.documentElement.classList.add("apple-mobile");
            }
        })();
    </script>

</body>

</html>
