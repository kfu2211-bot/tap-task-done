@page
@model tts.Pages.AdminLoginModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin sign in - Tap, Task, Done</title>
    <link rel="stylesheet" href="/css/admin-login.css" asp-append-version="true" />
</head>
<body>
    <main class="admin-login-page">
        <a class="admin-login-brand" href="/"><span>✓</span><strong>Tap, Task, Done</strong></a>
        <section class="admin-login-card" aria-labelledby="adminLoginTitle">
            <p class="admin-eyebrow">RESTRICTED AREA</p>
            <h1 id="adminLoginTitle">Sign in to<br />Admin Center</h1>
            <p class="admin-login-copy">Review local verification requests, reports, and account activity.</p>
            <form id="adminLoginForm" method="post">
                <label for="adminEmail">ADMIN EMAIL</label>
                <input id="adminEmail" name="email" type="email" autocomplete="username" placeholder="admin@example.com" required />
                <label for="adminPassword">PASSWORD</label>
                <input id="adminPassword" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required />
                <p id="adminLoginError" class="admin-login-error" role="alert">@Model.ErrorMessage</p>
                <button type="submit">Sign in securely <span>→</span></button>
            </form>
            <a class="return-link" href="/Login">← Return to regular sign in</a>
        </section>
        <p class="local-warning">Local testing only. Admin access is disabled in production until MFA is ready.</p>
    </main>
</body>
</html>
