@page
@model tts.Pages.VerifyLoginModel
@{ Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Verify sign-in - Tap, Task, Done</title><link rel="stylesheet" href="~/css/login-security.css" asp-append-version="true"/></head><body class="security-auth"><main class="security-card"><a href="/Login">Tap, Task, Done</a><p class="security-eyebrow">ACCOUNT SECURITY</p><h1>Confirm it's you</h1><p>We sent a six-digit code to your registered email. Enter it to finish signing in on this browser.</p><p>Expires in 10 minutes. Never share your code.</p>@if(Model.ErrorMessage is not null) { <p class="security-error" role="alert">@Model.ErrorMessage</p> }<form method="post"><label>Verification code<input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required autofocus /></label><label class="security-checkbox"><input asp-for="TrustDevice"/>Trust this browser for 30 days. Use only on your own device.</label><button type="submit">Verify and sign in</button></form><p><a href="/Login">Back to login / Request a new code</a></p></main></body></html>
