@{ var id = "password-checklist-" + Guid.NewGuid().ToString("N"); }
<aside id="@id" class="password-checklist" data-password-checklist-panel aria-label="Password requirements" hidden>
    <strong>Password requirements</strong>
    <ul>
        <li data-password-rule="length"><span aria-hidden="true">○</span>8–256 characters</li>
        <li data-password-rule="upper"><span aria-hidden="true">○</span>One uppercase letter</li>
        <li data-password-rule="lower"><span aria-hidden="true">○</span>One lowercase letter</li>
        <li data-password-rule="number"><span aria-hidden="true">○</span>One number</li>
        <li data-password-rule="special"><span aria-hidden="true">○</span>One special character</li>
    </ul>
    <small data-password-rule-summary role="status" aria-live="polite">Enter a strong password</small>
</aside>
