@model tts.Data.FreelancerTaskActions
@using tts.Data
@{ var task = Model.Task; var closed = JobActivity.IsClosedTask(task.Status) || task.Status == "completed"; }
@if (task.Status == "completed") {
 <div class="work-primary-actions completed-rating-actions"><a class="work-button" data-work-primary href="/Reviews?taskId=@task.Id&amp;asRole=freelancer" data-i18n>Service Ratings</a><a class="work-button work-button-secondary" href="/Tracking?taskId=@task.Id" data-i18n>Task history</a><a class="work-button work-button-secondary" href="/Messages?taskId=@task.Id" data-i18n>Conversation</a></div>
} else {
<div class="work-primary-actions" aria-label="Job actions">
    @if (Model.Offer.Status == "accepted" && !closed) { <a class="work-button" data-work-primary href="/Tracking?taskId=@task.Id">@(task.Status == "assigned" ? "Review schedule" : "View progress")</a> }
    @if (Model.Offer.Status == "accepted" && task.Status is "completed" or "cancelled") { <a class="work-button" href="/Tracking?taskId=@task.Id" data-work-primary data-i18n>Task history</a> }

    @if (Model.Offer.Status == "pending" && task.Status == "open" && (task.PostExpiresUtc == null || task.PostExpiresUtc > DateTime.UtcNow)) { <a class="work-button" data-work-primary data-open-offer-editor href="#offer-editor-@task.Id" data-i18n>Edit offer</a> }
    @if (!(Model.Offer.Status == "accepted" && task.Status == "cancelled")) { <a class="work-button work-button-secondary" href="/JobRecord?taskId=@task.Id">@(closed ? "Task history" : "Task details")</a> }
    @if (Model.Offer.Status is "accepted" or "pending") {
        @if (closed) { <a class="work-button work-button-secondary" href="/Messages?taskId=@task.Id" data-i18n>View conversation</a> }
        else { <form method="post" asp-page="/Messages" asp-page-handler="Start"><input type="hidden" name="taskId" value="@task.Id" /><button type="submit" class="work-button work-button-secondary" data-i18n>Message client</button></form> }
    }
</div>
}

@if (Model.View is "active" or "scheduled" && task.Status == "assigned") { <p class="work-help" data-i18n>The scheduled time is your arrival time. Travel opens 1 hour earlier.</p> }
<div class="work-secondary-actions">
@if (Model.View is "active" or "scheduled" && task.Status == "assigned") {
    <details class="work-editor job-withdraw"><summary data-i18n>Withdraw from this job</summary><p data-i18n>The client will be notified. You cannot reapply to this task.</p>
        <form method="post" asp-page-handler="Withdraw" data-withdraw-job="@task.Title"><input type="hidden" name="id" value="@task.Id" /><label><span data-i18n>Reason for withdrawing</span><textarea name="reason" maxlength="500" rows="3" required></textarea></label><button type="submit" class="work-button work-button-secondary" data-i18n>Review withdrawal</button></form>
    </details>
}
@if (Model.Offer.Status == "accepted" && JobCancellation.CanRequest(task.Status)) { <a class="work-text-action" href="/Tracking?taskId=@task.Id" data-i18n>Request cancellation in Tracking</a> }
</div>

@if (Model.Offer.Status == "pending" && task.Status == "open" && (task.PostExpiresUtc == null || task.PostExpiresUtc > DateTime.UtcNow)) {
<div class="pending-offer-controls">
    <p class="work-help" data-i18n>You can edit or withdraw this offer until the client accepts. Discuss a counter-offer in Messages first.</p>
    <details class="work-editor" id="offer-editor-@task.Id"><summary data-i18n>Edit offer</summary>
        <form method="post" asp-page="/MyJobs" asp-page-handler="PendingOffer" class="work-form">
            <input type="hidden" name="id" value="@task.Id" /><input type="hidden" name="action" value="edit" /><input type="hidden" name="taskRevision" value="@TaskAcceptanceTerms.Revision(task, 0)" /><input type="hidden" name="revision" value="@OfferRevision.For(Model.Offer)" />
            <label><span data-i18n>Your offer (₱)</span><input name="price" type="number" min="1" max="9999999999" step="0.01" value="@Model.Offer.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
            <label><span data-i18n>Message (optional)</span><textarea name="message" maxlength="500" rows="3">@Model.Offer.Message</textarea></label>
            <button class="work-button" type="submit" data-i18n>Save revised offer</button>
        </form>
    </details>
    <details class="work-editor"><summary data-i18n>Withdraw offer</summary>
        <p data-i18n>Withdrawing is final. You cannot reapply to this task.</p>
        <form method="post" asp-page="/MyJobs" asp-page-handler="PendingOffer"><input type="hidden" name="id" value="@task.Id" /><input type="hidden" name="action" value="withdraw" /><input type="hidden" name="revision" value="@OfferRevision.For(Model.Offer)" /><button class="work-button work-button-secondary" type="submit" data-i18n>Confirm withdrawal</button></form>
    </details>
</div>
}
