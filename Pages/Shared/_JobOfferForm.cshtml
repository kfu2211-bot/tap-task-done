@model tts.Data.JobOfferView
@{
    var task = Model.Task;
    var hasRange = task.BudgetMaximum is { } maximum && maximum != task.Budget;
    var postedPrice = task.Budget > 0 ? task.Budget.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : null;
    var formId = $"job-offer-{task.Id}";
}
<div class="job-offer-actions">
    <form method="post" asp-page="/Messages" asp-page-handler="Start">
        <input type="hidden" name="taskId" value="@task.Id" />
        <button type="submit" class="task-chat-action">
            <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8.5 8.5 0 0 1-12.3 7.6L3 21l1.9-5.7A8.5 8.5 0 1 1 21 11.5Z"/></svg>
            Ask about this task
        </button>
    </form>
    @if (Model.OfferStatus is { } status)
    {
        <span class="jobs-offer-status">Offer sent · @status</span>
        <a class="task-chat-action" href="/MyJobs?view=@(status is "withdrawn" or "cancelled" ? "closed" : status == "accepted" ? "active" : "offers")&amp;offerFilter=@(status is "declined" or "rejected" ? "declined" : "pending")#job-@task.Id" data-i18n>Manage my offer</a>
    }
    else
    {
        @if (!hasRange && postedPrice is not null)
        {
            <form method="post" asp-page="/MarketTasks" asp-page-handler="Offer" data-submit-pending="Applying…" data-job-offer-submit>
                <input type="hidden" name="id" value="@task.Id" /><input type="hidden" name="taskRevision" value="@tts.Data.TaskAcceptanceTerms.Revision(task, 0)" />
                <input type="hidden" name="price" value="@postedPrice" />
                <input type="hidden" name="applyAtPostedPay" value="true" />
                <button class="post-submit-button" type="submit" data-work-guard disabled="@Model.WorkLocked">Apply at @task.BudgetDisplay</button>
            </form>
        }
        <button class="job-offer-toggle" type="button" aria-controls="@formId" aria-expanded="false" data-work-guard disabled="@Model.WorkLocked" hidden>Make an offer</button>
    }
    <a class="task-chat-action" asp-page="/Reports" asp-route-taskId="@task.Id" data-i18n>Report this task</a>
</div>
@if (Model.OfferStatus is null) { <p class="job-notice" data-work-lock-notice hidden="@(!Model.WorkLocked)" role="status">@tts.Data.JobAcceptanceRules.Message <a href="/MyJobs?view=active" data-i18n>View current job</a></p> }
@if (Model.OfferStatus is null)
{
    <p class="work-help" data-i18n>Sending an offer means you agree to the listed schedule and work details. If the client accepts unchanged Short Job terms, you can proceed without another confirmation.</p>
    <form id="@formId" class="job-offer-editor" method="post" asp-page="/MarketTasks" asp-page-handler="Offer" data-submit-pending="Sending offer…" data-job-offer-submit>
        <input type="hidden" name="id" value="@task.Id" /><input type="hidden" name="taskRevision" value="@tts.Data.TaskAcceptanceTerms.Revision(task, 0)" />
        <fieldset class="job-offer-guard" data-work-guard disabled="@Model.WorkLocked">
        @if (hasRange && postedPrice is not null)
        {
            <button type="button" class="job-offer-use-budget" data-offer-price="@postedPrice" hidden>Use minimum budget (₱@task.Budget.ToString("N2"))</button>
        }
        <div class="job-offer-fields">
            <label>Your offer (₱)
                <input type="number" name="price" min="1" max="9999999999" step="0.01" required placeholder="Amount" />
            </label>
            <label>Message (optional)<textarea data-gramm="false" data-gramm_editor="false" data-enable-grammarly="false" name="message" maxlength="500" rows="1" placeholder="Add a note to the client"></textarea></label>
            <button class="post-submit-button" type="submit">Send offer</button>
        </div>
        </fieldset>
    </form>
}
