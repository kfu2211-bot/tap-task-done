@model tts.Data.MarketplaceTask
@{
    var hasRange = Model.BudgetMaximum is { } maximum && maximum != Model.Budget;
    var postedPrice = Model.Budget > 0 ? Model.Budget.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : null;
    var formId = $"job-offer-{Model.Id}";
}
<div class="job-offer-actions">
    @if (!hasRange && postedPrice is not null)
    {
        <form method="post" asp-page="/MarketTasks" asp-page-handler="Offer" data-submit-pending="Applying…">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="price" value="@postedPrice" />
            <input type="hidden" name="applyAtPostedPay" value="true" />
            <button class="post-submit-button" type="submit">Apply at @Model.BudgetDisplay</button>
        </form>
    }
    <button class="job-offer-toggle" type="button" aria-controls="@formId" aria-expanded="false" hidden>Make an offer</button>
</div>
<form id="@formId" class="job-offer-editor" method="post" asp-page="/MarketTasks" asp-page-handler="Offer" data-submit-pending="Sending offer…">
    <input type="hidden" name="id" value="@Model.Id" />
    <p>Posted budget <strong>@Model.BudgetDisplay</strong></p>
    <label class="post-field">Your offer (₱)
        <input type="number" name="price" min="1" max="9999999999" step="0.01" required />
    </label>
    @if (hasRange && postedPrice is not null)
    {
        <button type="button" class="job-offer-use-budget" data-offer-price="@postedPrice" hidden>Use minimum budget (₱@Model.Budget.ToString("N2"))</button>
    }
    <label class="post-field">Message (optional)<textarea name="message" maxlength="500" rows="3"></textarea></label>
    <button class="post-submit-button" type="submit">Send offer</button>
</form>
