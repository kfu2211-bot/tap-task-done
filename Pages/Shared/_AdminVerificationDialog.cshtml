<dialog id="adminVerificationDialog" class="admin-verification-dialog" aria-labelledby="adminVerificationTitle" aria-describedby="adminVerificationImpact">
    <h2 id="adminVerificationTitle" data-i18n>Confirm verification change</h2>
    <p data-verification-account translate="no"></p>
    <dl><div><dt data-i18n>Verification type</dt><dd data-verification-type></dd></div><div><dt data-i18n>Change</dt><dd data-verification-change></dd></div><div><dt data-i18n>Reason</dt><dd data-verification-reason translate="no"></dd></div></dl>
    <p id="adminVerificationImpact" class="admin-verification-impact"></p>
    <form method="dialog" class="admin-verification-dialog-actions"><button value="cancel" class="work-button work-button-secondary" autofocus data-i18n>Back to review</button><button value="confirm" class="work-button" data-i18n>Confirm change</button></form>
</dialog>
