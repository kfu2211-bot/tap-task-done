@model tts.Data.TaskLocationInput
@{ var key = "location-" + Guid.NewGuid().ToString("N"); var invariant = System.Globalization.CultureInfo.InvariantCulture; }
<section class="task-location-picker" data-location-picker>
    <label for="@key">Work address or landmark</label>
    <input id="@key" name="location" value="@Model.Address" maxlength="120" required placeholder="Search a barangay, street or landmark in Bacolor" autocomplete="off" data-location-address />
    <input type="hidden" name="latitude" value="@(Model.Latitude?.ToString(invariant))" data-location-latitude />
    <input type="hidden" name="longitude" value="@(Model.Longitude?.ToString(invariant))" data-location-longitude />
    <div class="location-picker-actions"><button type="button" data-location-search>Search location</button><button type="button" data-location-current>Use my current location</button></div>
    <div class="location-search-results" data-location-results></div>
    <div class="location-picker-map" data-location-map aria-label="Choose the exact work destination"></div>
    <div class="location-picker-actions"><button type="button" data-location-confirm>Confirm this pin</button></div>
    <p data-location-status role="status">Search, use your location, or click/drag the pin, then confirm the exact work destination.</p>
    <small>Current location is optional and needs permission. Confirm the work address, which may differ from where you are now. Search: Photon / © OpenStreetMap contributors.</small>
</section>
