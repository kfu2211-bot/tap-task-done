<style>
    html.workspace-shell-loading :is(.sidebar, .mytasks-sidebar) :is(nav, .sidebar-view-switch, .sidebar-user, .sidebar-account, .mytasks-user) { visibility: hidden !important; }
    html.workspace-shell-loading :is(.sidebar, .mytasks-sidebar) > :is(.sidebar-user, .sidebar-account, .mytasks-user) { display: none !important; }
</style>
<script>
    if (document.querySelector('script[src*="sidebar-account.js"]')) {
        document.documentElement.classList.add('workspace-shell-loading');
        // Leave navigation usable if the script fails to initialize.
        setTimeout(() => document.documentElement.classList.remove('workspace-shell-loading'), 6000);
    }
</script>
