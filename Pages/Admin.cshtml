@page
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Center - Tap, Task, Done</title>
    <link rel="stylesheet" href="/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/admin-extras.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/admin-auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/admin-flow.css" asp-append-version="true" /><link rel="stylesheet" href="/css/admin-actions.css" asp-append-version="true" /><link rel="stylesheet" href="/css/admin-complete.css" asp-append-version="true" /><link rel="stylesheet" href="/css/admin-view-fix.css" asp-append-version="true" /><link rel="stylesheet" href="/css/admin-workflow.css" asp-append-version="true" /><link rel="stylesheet" href="/css/admin-account-link.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/admin-mobile-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/presentation-polish.css" asp-append-version="true" />
    <script src="/js/admin-auth.js" asp-append-version="true"></script>
</head>
<body>
    <div class="admin-shell">
        <aside class="admin-sidebar" aria-label="Admin navigation">
            <a class="admin-brand" href="/Admin"><span>✓</span><strong>Tap, Task, Done</strong></a>
            <nav id="adminNavigation">
                <a class="active" href="#overview" data-admin-view="overview">⌂ <span>Overview</span></a>
                <a href="#verifications" data-admin-view="verifications">♢ <span>Verifications</span></a>
                <a href="#reports" data-admin-view="reports">⚑ <span>Safety Reports</span></a>
                <a href="#users" data-admin-view="users">♧ <span>Users</span></a>
                <a href="#activity" data-admin-view="activity">◷ <span>Activity Log</span></a><a href="#notifications" data-admin-view="notifications">◉ <span>Notifications</span></a>
                <a href="#settings" data-admin-view="settings">⚙ <span>Settings</span></a>
            </nav>
            <p class="demo-badge">Local demo data</p>
        </aside>
        <main class="admin-main">
            <header class="admin-topbar">
                <button id="mobileMenu" class="mobile-menu" type="button" aria-label="Open navigation">☰</button>
                <h1 id="adminPageTitle">Admin Center</h1>
                <div class="admin-top-actions"><button id="adminAlerts" class="admin-alerts" type="button" title="Open urgent reports">Alerts <b id="adminAlertCount">0</b></button><button id="adminLogout" class="admin-user" type="button" title="Sign out from Admin Center"><span>AD</span><strong>Admin</strong><em>Sign out</em></button></div>
            </header>
            <div class="admin-content">
                <section class="admin-view" data-view="overview" id="overview">
                    <section class="admin-intro"><div><p class="eyebrow">COMMUNITY OPERATIONS</p><h2>Good morning, <span id="adminGreeting">Admin</span></h2><p>Review requests, reports, and account activity in one place.</p></div><span class="local-note">Local demo data</span></section>
                    <section class="stat-grid"><button class="stat-card teal" type="button" data-go-to="verifications"><span>♢</span><div><strong id="verificationCount">0</strong><small>Pending verification</small></div><b>›</b></button><button class="stat-card amber" type="button" data-go-to="reports"><span>⚑</span><div><strong id="reportCount">0</strong><small>Open reports</small></div><b>›</b></button><button class="stat-card teal" type="button" data-go-to="users"><span>♧</span><div><strong id="verifiedCount">0</strong><small>Verified users</small></div><b>›</b></button><button class="stat-card red" type="button" data-go-to="reports"><span>!</span><div><strong id="urgentCount">0</strong><small>Urgent reviews</small></div><b>›</b></button></section>
                    <section class="admin-card overview-card"><div class="card-heading"><div><h2>What needs attention</h2><p>Open a section to review the complete details.</p></div></div><div id="overviewHighlights"></div></section>
                </section>
                <section class="admin-view" data-view="verifications" id="verifications" hidden><div class="section-title"><div><p class="eyebrow">IDENTITY CHECKS</p><h2>Verification requests</h2><p>Review ID details, then approve or reject the request.</p></div></div><article class="admin-card"><div class="card-tools"><input id="verificationSearch" type="search" placeholder="Search by name or email" /><select id="verificationFilter"><option value="Pending">Pending</option><option value="All">All statuses</option><option value="Approved">Approved</option><option value="Rejected">Rejected</option></select></div><div class="table-labels verification-grid"><span>User</span><span>ID type</span><span>Submitted</span><span>Status</span><span>Action</span></div><div id="verificationQueue"></div><p id="verificationEmpty" class="empty-state" hidden>No verification requests match this filter.</p></article></section>
                <section class="admin-view" data-view="reports" id="reports" hidden><div class="section-title"><div><p class="eyebrow">COMMUNITY SAFETY</p><h2>Safety reports</h2><p>Read report and evidence details before resolving or dismissing it.</p></div></div><article class="admin-card"><div class="card-tools"><input id="reportSearch" type="search" placeholder="Search person, reason, or task" /><select id="reportFilter"><option value="Open">Open reports</option><option value="All">All statuses</option><option value="Urgent">Urgent</option><option value="Resolved">Resolved</option><option value="Dismissed">Dismissed</option></select></div><div class="table-labels report-grid"><span>Reported user</span><span>Reason</span><span>Submitted</span><span>Status</span><span>Action</span></div><div id="reportQueue"></div><p id="reportEmpty" class="empty-state" hidden>No safety reports match this filter.</p></article></section>
                <section class="admin-view" data-view="users" id="users" hidden><div class="section-title"><div><p class="eyebrow">ACCOUNT MANAGEMENT</p><h2>Users</h2><p>Search local demo accounts and update their account status.</p></div></div><article class="admin-card"><div class="card-tools"><input id="userSearch" type="search" placeholder="Search users" /></div><div id="userList"></div></article></section>
                <section class="admin-view" data-view="activity" id="activity" hidden><div class="section-title"><div><p class="eyebrow">ADMIN AUDIT</p><h2>Activity log</h2><p>Every local admin decision is listed here.</p></div></div><article class="admin-card activity-card"><div class="card-tools"><input id="activitySearch" type="search" placeholder="Search activity" /><button id="exportActivity" class="review-button" type="button">Export local CSV</button></div><div id="activityList"></div><p id="activityEmpty" class="empty-state" hidden>No activity recorded yet.</p></article></section><section class="admin-view" data-view="notifications" id="notifications" hidden><div class="section-title"><div><p class="eyebrow">ADMIN INBOX</p><h2>Notifications</h2><p>New requests and important local admin updates.</p></div></div><article class="admin-card"><div class="card-tools"><button id="markAdminNoticesRead" class="review-button" type="button">Mark all as read</button></div><div id="adminNotificationList"></div><p id="adminNotificationEmpty" class="empty-state" hidden>No admin notifications yet.</p></article></section>
                <section class="admin-view" data-view="settings" id="settings" hidden><div class="section-title"><div><p class="eyebrow">LOCAL PREFERENCES</p><h2>Admin settings</h2><p>These preferences are saved only in this browser.</p></div></div><article class="admin-card settings-card"><label><input id="urgentNotifications" type="checkbox" /> Show urgent-report alerts</label><label><input id="showResolved" type="checkbox" checked /> Include resolved items in review lists</label><button id="saveAdminSettings" class="primary-action" type="button">Save settings</button><span id="settingsSaved" aria-live="polite"></span></article><article class="admin-card" id="adminAccountPanel"><h2>Admin account</h2><p>Update this local demo admin profile and password.</p><form id="adminAccountForm" class="admin-account-form"><label>Display name<input id="adminDisplayName" required /></label><label>New password<input id="adminNewPassword" type="password" minlength="8" placeholder="Leave blank to keep current password" /></label><button class="primary-action" type="submit">Save admin account</button><span id="adminAccountSaved" aria-live="polite"></span></form></article><article class="admin-card" id="staffPanel"><h2>Admin roles</h2><p>Local demo staff roles. Only System Admin can manage account settings.</p><div id="staffList"></div></article><article class="admin-card implementation-note"><h2>Before production</h2><p>Later, replace browser data with role-based authentication, database records, encrypted document storage, and a protected server-side audit log.</p></article></section>
            </div>
        </main>
    </div>
    <div class="admin-modal hidden" id="reviewModal" aria-hidden="true"><div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><button id="modalClose" class="modal-close" type="button" aria-label="Close">×</button><p id="modalType" class="eyebrow">REVIEW</p><h2 id="modalTitle">Review request</h2><div id="modalDescription" class="modal-details"></div><label class="modal-note-label" for="adminNote">Admin note <span>(local demo)</span></label><textarea id="adminNote" placeholder="Add a short reason for this decision"></textarea><div class="modal-actions"><button id="rejectAction" class="secondary-action" type="button">Reject / dismiss</button><button id="approveAction" class="primary-action" type="button">Approve / resolve</button></div></div></div>
    <script src="/js/admin.js" asp-append-version="true"></script><script src="/js/admin-actions.js" asp-append-version="true"></script><script src="/js/admin-account-link.js" asp-append-version="true"></script>
</body>
</html>
