@page
@model tts.Pages.AdminModel
@{ Layout = null; }
@{
    var inboxKind = Request.Query["inboxKind"].ToString();
    var inboxRecord = long.TryParse(Request.Query["inboxRecord"], out var recordId) && recordId > 0;
    string QueueUrl(string page, string kind) => inboxRecord && inboxKind == kind
        ? Url.Page(page, new { embedded = true, recordId })!
        : Url.Page(page, new { embedded = true })!;
}
<!DOCTYPE html>
<html lang="en">
<head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Center - Tap, Task, Done</title>
    <link rel="stylesheet" href="/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/admin-extras.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/admin-auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/admin-flow.css" asp-append-version="true" /><link rel="stylesheet" href="/css/admin-actions.css" asp-append-version="true" /><link rel="stylesheet" href="/css/admin-complete.css" asp-append-version="true" /><link rel="stylesheet" href="/css/admin-view-fix.css" asp-append-version="true" /><link rel="stylesheet" href="/css/admin-workflow.css" asp-append-version="true" /><link rel="stylesheet" href="/css/admin-account-link.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/admin-mobile-polish.css" asp-append-version="true" />
    <script>window.tapTaskDoneGetAdminSession = () => ({ name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(User.Identity?.Name ?? "Admin")) }); window.tapTaskDoneGetAdminAccount = window.tapTaskDoneGetAdminSession; window.tapTaskDoneEndAdminSession = () => document.getElementById("adminLogoutForm").submit(); window.registeredUsers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RegisteredUsers, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })); window.registeredUsersUnavailable = @(Model.UsersUnavailable ? "true" : "false");</script>
<link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/admin-polish.css" asp-append-version="true" />
<script>window.adminSummary = { verifications: @(Model.PendingVerifications?.ToString() ?? "null"), verificationAvailable: @(Model.VerificationAvailable ? "true" : "false"), reports: @(Model.OpenReports?.ToString() ?? "null") };</script>
<script>window.databaseAdminActivity = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Activities, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })); window.adminActivityIncomplete = @(Model.ActivityIncomplete ? "true" : "false");</script>
<link rel="stylesheet" href="/css/admin-design.css" asp-append-version="true" /><partial name="_AccountTheme" /></head>
<body>
    <form id="adminLogoutForm" method="post" asp-page="/Admin" asp-page-handler="Logout"></form>
    <div class="admin-shell">
        <aside class="admin-sidebar" aria-label="Admin navigation">
            <a class="admin-brand" href="/Admin"><span>✓</span><strong>Tap, Task, Done</strong></a>
            <nav id="adminNavigation">
                <a class="active" href="#overview" data-admin-view="overview"><svg class="admin-ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10l9-7 9 7v10h-6v-6H9v6H3z"/></svg><span>Overview</span></a>
                <a href="#verifications" data-admin-view="verifications"><svg class="admin-ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4-4 7-8 9-4-2-8-5-8-9V6z M8 12l3 3 5-6"/></svg><span>Verification requests</span></a>
                <a href="#reports" data-admin-view="reports"><svg class="admin-ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 21V4c5-3 9 3 14 0v10c-5 3-9-3-14 0"/></svg><span>Safety Reports</span></a>
                <a href="#deletions" data-admin-view="deletions"><svg class="admin-ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16 M9 6V3h6v3 M6 6l1 15h10l1-15 M10 10v7 M14 10v7"/></svg><span>Deletion requests</span></a>
                <a href="#users" data-admin-view="users"><svg class="admin-ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2 M20 21v-2a4 4 0 0 0-2-3.5 M17 4a4 4 0 0 1 0 8 M9.5 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8z"/></svg><span>Users</span></a>
                <a href="#activity" data-admin-view="activity"><svg class="admin-ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12h5l3-8 4 16 3-8h5"/></svg><span>Activity Log</span></a><a href="#notifications" data-admin-view="notifications"><svg class="admin-ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 6-1 7-3 9h18c-2-2-3-3-3-9 M10 21h4"/></svg><span>Notifications</span></a>
                <a href="#settings" data-admin-view="settings"><svg class="admin-ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3h4l1 3 3 1 3 3-2 2v2l2 2-3 3-3-1-1 3h-4l-1-3-3 1-3-3 2-2v-2l-2-2 3-3 3-1z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg><span>Settings</span></a>
            </nav>
        </aside>
        <main class="admin-main">
            <header class="admin-topbar">
                <button id="mobileMenu" class="mobile-menu" type="button" aria-label="Open navigation">☰</button>
                <h1 id="adminPageTitle">Admin Center</h1>
                <div class="admin-top-actions"><button id="adminAlerts" class="admin-alerts" type="button" title="Open admin notifications"><svg class="admin-ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 6-1 7-3 9h18c-2-2-3-3-3-9 M10 21h4"/></svg><span>Alerts</span> <b id="adminAlertCount">0</b></button><button id="adminLogout" class="admin-user" type="button" title="Sign out from Admin Center"><span>AD</span><strong>Admin</strong><em>Sign out</em></button></div>
            </header>
            <div class="admin-content">
                <section class="admin-view" data-view="overview" id="overview">
                    <section class="admin-intro"><div><h2>Welcome, <span id="adminGreeting">Admin</span></h2><p>Review identity checks, safety reports, and recent admin decisions.</p></div></section>
                    <section class="stat-grid"><button class="stat-card teal" type="button" data-go-to="verifications"><span><svg class="admin-ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4-4 7-8 9-4-2-8-5-8-9V6z M8 12l3 3 5-6"/></svg></span><div><strong id="verificationCount">—</strong><small>Pending verification</small></div><b>›</b></button><button class="stat-card amber" type="button" data-go-to="reports"><span><svg class="admin-ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 21V4c5-3 9 3 14 0v10c-5 3-9-3-14 0"/></svg></span><div><strong id="reportCount">—</strong><small>Open reports</small></div><b>›</b></button><button class="stat-card teal" type="button" data-go-to="users"><span><svg class="admin-ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2 M20 21v-2a4 4 0 0 0-2-3.5 M17 4a4 4 0 0 1 0 8 M9.5 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8z"/></svg></span><div><strong id="verifiedCount">—</strong><small>Registered users</small></div><b>›</b></button></section>
                    <div class="overview-panels">
                        <section class="admin-card overview-card" aria-labelledby="reviewQueueTitle">
                            <div class="card-heading"><h2 id="reviewQueueTitle">Review queue</h2><a href="#reports" data-go-to="reports">View queue</a></div>
                            <ul class="overview-activity overview-review-list">
                                @foreach (var entry in Model.QueueReports)
                                {
                                    var priority = entry.Priority == 3 ? "High" : entry.Priority == 1 ? "Low" : "Normal";
                                    <li>
                                        <div><strong>Report #@entry.Report.Id · @entry.Report.Reason</strong><small>@(entry.Report.Status == "reviewing" ? "Under review" : "New")</small></div>
                                        <span class="overview-priority priority-@entry.Priority">@priority</span>
                                        <a class="review-button" asp-page="/Admin" asp-route-inboxKind="report" asp-route-inboxRecord="@entry.Report.Id" asp-fragment="reports">Review</a>
                                    </li>
                                }
                            </ul>
                            @if (Model.QueueReportsUnavailable) { <p>Safety reports could not be loaded.</p> }
                            else if (Model.QueueReports.Count == 0 && Model.PendingVerifications == 0) { <p class="empty-state">No pending items.</p> }
                            @if (Model.PendingVerifications > 0)
                            {
                                <a href="#verifications" data-go-to="verifications">Review pending verifications (@Model.PendingVerifications)</a>
                            }
                        </section>
                        <section class="admin-card overview-card" aria-labelledby="recentAdminTitle">
                            <div class="card-heading"><h2 id="recentAdminTitle">Recent activity</h2><a href="#activity" data-go-to="activity">View log</a></div>
                            @if (Model.Activities.Any())
                            {
                                <ul class="overview-activity">
                                    @foreach (var entry in Model.Activities.Take(4))
                                    {
                                        <li><strong>@entry.Action</strong><small>@entry.Detail · @(string.IsNullOrWhiteSpace(entry.Admin) ? "Unknown admin" : entry.Admin) · @tts.Data.DisplayTime.Philippine(entry.Time) PHT</small></li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="empty-state">@(Model.ActivityIncomplete ? "Activity is unavailable." : "No admin decisions recorded yet.")</p>
                            }
                        </section>
                    </div>
                </section>
                <section class="admin-view" data-view="verifications" id="verifications" hidden><iframe src="@QueueUrl("/AdminIdentity", "verification")" title="Verification requests" id="adminIdentityFrame" class="admin-reports-frame admin-auto-frame" scrolling="no" loading="lazy"></iframe><div hidden aria-hidden="true"><input id="verificationSearch" type="search" /><select id="verificationFilter"><option value="Pending">Pending</option><option value="All">All</option></select><div id="verificationQueue"></div><p id="verificationEmpty" hidden></p></div></section>
                <section class="admin-view" data-view="reports" id="reports" hidden>
                    <iframe src="@QueueUrl("/AdminReports", "report")" title="Safety reports" id="adminReportsFrame" class="admin-reports-frame admin-auto-frame" scrolling="no"></iframe>
                    <div hidden aria-hidden="true"><input id="reportSearch" type="search" /><select id="reportFilter"><option value="Open">Open</option><option value="All">All</option><option value="Urgent">Urgent</option><option value="Resolved">Resolved</option><option value="Dismissed">Dismissed</option></select><div id="reportQueue"></div><p id="reportEmpty" hidden></p></div>
                </section>
                <section class="admin-view" data-view="deletions" id="deletions" hidden><iframe src="@QueueUrl("/AdminDeletions", "deletion")" title="Account deletion requests" id="adminDeletionsFrame" class="admin-reports-frame admin-auto-frame" scrolling="no" loading="lazy"></iframe></section><section class="admin-view" data-view="users" id="users" hidden><iframe src="/AdminUsers?embedded=true" title="Account management" class="admin-reports-frame admin-users-frame" id="adminUsersFrame" scrolling="no" loading="lazy"></iframe><div hidden><input id="userSearch"/><div id="userList"></div></div></section>
                <section class="admin-view" data-view="activity" id="activity" hidden><article class="admin-card activity-card"><div class="card-tools"><input id="activitySearch" type="search" placeholder="Search by admin, action, or record" aria-label="Search activity" /><button id="exportActivity" class="review-button" type="button">Export CSV</button></div><div class="activity-row activity-columns" aria-hidden="true"><strong>Date and time</strong><strong>Recorded by</strong><strong>Action</strong><strong>Related record</strong></div><div id="activityList"></div><p id="activityEmpty" class="empty-state" hidden>No activity recorded yet.</p></article></section><section class="admin-view" data-view="notifications" id="notifications" data-admin-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" hidden>
    <article class="admin-card">
        <div class="admin-inbox-toolbar">
            <div role="group" aria-label="Filter notifications">
                <button class="review-button" type="button" data-inbox-filter="all" aria-pressed="true">All</button>
                <button class="review-button" type="button" data-inbox-filter="unread" aria-pressed="false">Unread</button>
            </div>
            <button class="review-button" type="button" id="adminInboxReadAll">Mark all as read</button>
        </div>
        @if (Model.InboxIncomplete) { <p class="admin-inbox-warning" role="status">Some notifications could not be loaded. <a href="/Admin#notifications" data-inbox-retry>Retry</a></p> }
        @foreach (var item in Model.Inbox.OrderByDescending(i => i.Time))
        {
            var sectionName = item.Kind == "report" ? "reports" : item.Kind == "verification" ? "verifications" : "deletions";
            var label = item.Kind == "report" ? "Safety report" : item.Kind == "verification" ? "Verification request" : "Deletion request for account";
            <a class="admin-inbox-entry" data-inbox-key="@($"{item.Kind}:{item.Id}:{item.Time.Ticks}")" data-high-report="@(item.Kind == "report" && item.Priority == 3 && item.Status == "open" ? item.Id : null)" asp-page="/Admin" asp-route-inboxKind="@item.Kind" asp-route-inboxRecord="@item.Id" asp-fragment="@sectionName">
                <strong><span class="admin-inbox-unread" hidden>Unread</span> @label #@item.Id</strong>
                <span>@item.Status.Replace("-", " ") · @tts.Data.DisplayTime.Philippine(item.Time) @if(item.Priority == 3) { <text> · High priority</text> }</span>
            </a>
        }
        <span id="adminInboxStatus" role="status"></span><p id="adminInboxEmpty" class="empty-state" role="status" hidden></p>
    </article>
</section>
                <section class="admin-view admin-settings" data-view="settings" id="settings" hidden>
                    <div class="admin-settings-grid">
                        <article class="admin-card">
                            <h3>My account</h3>
                            <dl class="admin-account-details">
                                <dt>Name</dt><dd>@(User.Identity?.Name ?? "Admin")</dd>
                                <dt>Email</dt><dd>@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "Unavailable")</dd>
                                <dt>Role</dt><dd>@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Unavailable")</dd>
                            </dl>
                        </article>
                        <article class="admin-card">
                            <h3>Security &amp; devices</h3>
                            <p>Review sign-in alerts and active sessions for your admin account.</p>
                            <a class="review-button admin-security-link" href="/Security">Manage security</a>
                        </article>
                        <article class="admin-card settings-card settings-wide">
                            <h3>Workspace preferences</h3>
                            <p>Preferences are saved in this browser.</p>
                            <label class="admin-setting-switch"><input id="urgentNotifications" type="checkbox" role="switch" /> Show notification alerts in the header</label>
                            <button id="saveAdminSettings" class="primary-action" type="button">Save preferences</button>
                            <span id="settingsSaved" role="status"></span>
                        </article>
                        @if (User.IsInRole("admin"))
                        {
                            <article class="admin-card settings-wide">
                                <h3>Staff access</h3>
                                <p>Choose an existing account and save its access level. Admins can manage staff. Moderators can review cases.</p>
                                <form method="post" asp-page-handler="StaffRole" class="admin-staff-form">
                                    <label>Account email<input type="email" name="email" required maxlength="254" /></label>
                                    <label>Access level<select name="role" required>
                                        <option value="" disabled selected>Choose access</option>
                                        <option value="admin">Admin</option>
                                        <option value="moderator">Moderator</option>
                                        <option value="client">Regular user</option>
                                    </select></label>
                                    <button type="submit" class="primary-action">Save access</button>
                                </form>
                                @if (Model.StaffNotice is not null) { <p class="admin-staff-notice" role="status">@Model.StaffNotice</p> }
                                @if (Model.StaffUnavailable) { <p>Staff accounts are temporarily unavailable.</p> }
                                else if (Model.Staff.Count == 0) { <p>No staff accounts found.</p> }
                                else
                                {
                                    <h4 class="admin-staff-list-title">Current staff</h4>
                                    <ul class="admin-staff-list">
                                        @foreach (var staff in Model.Staff)
                                        {
                                            <li>
                                                <div><strong>@(string.IsNullOrWhiteSpace(staff.Name) ? staff.Email : staff.Name)</strong><small>@staff.Email</small></div>
                                                <span class="admin-staff-role">@(staff.Role == "admin" ? "Admin" : "Moderator")</span>
                                                <div><small>Last activity</small><span>@(staff.LastSeen is DateTime seen ? tts.Data.DisplayTime.Philippine(seen) + " PHT" : Model.StaffHistoryUnavailable ? "Unavailable" : "No session recorded")</span></div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </article>
                        }
                    </div>
                </section>
            </div>
        </main>
    </div>
    <div class="admin-modal hidden" id="reviewModal" aria-hidden="true"><div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><button id="modalClose" class="modal-close" type="button" aria-label="Close">×</button><p id="modalType" class="eyebrow">REVIEW</p><h2 id="modalTitle">Review request</h2><div id="modalDescription" class="modal-details"></div><label class="modal-note-label" for="adminNote">Admin note <span>(local demo)</span></label><textarea id="adminNote" placeholder="Add a short reason for this decision"></textarea><div class="modal-actions"><button id="rejectAction" class="secondary-action" type="button">Reject / dismiss</button><button id="approveAction" class="primary-action" type="button">Approve / resolve</button></div></div></div>
    <script src="/js/login-security-alert.js" asp-append-version="true" defer></script><script src="/js/admin.js" asp-append-version="true"></script><script src="/js/admin-actions.js" asp-append-version="true"></script><script src="/js/admin-account-link.js" asp-append-version="true"></script>
    <script>
        window.addEventListener('message', event => {
            const frames = new Map([['admin-reports-height', 'adminReportsFrame'], ['admin-users-height', 'adminUsersFrame'], ['admin-identity-height', 'adminIdentityFrame'], ['admin-deletions-height', 'adminDeletionsFrame']]);
            const frame = document.getElementById(frames.get(event.data?.type));
            if (!frame || event.origin !== window.location.origin || event.source !== frame.contentWindow) return;
            const height = Number(event.data.height);
            if (Number.isFinite(height) && height > 0 && height < 1000000) frame.style.height = Math.ceil(height) + 'px';
        });
    </script>
</body>
</html>
