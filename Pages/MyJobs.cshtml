@page
@using tts.Data
@model tts.Pages.MyJobsModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en"><head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" /><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>My Jobs - Tap, Task, Done</title><link rel="stylesheet" href="/css/settings.css" asp-append-version="true" /><link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" /><script defer src="/js/sidebar-account.js" asp-append-version="true"></script>
    <script defer src="/js/profile-photo.js" asp-append-version="true"></script><link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" /><link rel="stylesheet" href="/css/my-jobs.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/sidebar-consistency.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/workspace-spacing.css" asp-append-version="true" />
<partial name="_AccountTheme" /></head>
<body class="my-jobs-page"><div class="settings-layout"><aside class="sidebar"><a class="brand" asp-page="/Landing" aria-label="Tap, Task, Done landing page" style="text-decoration:none"><span class="brand-icon">✓</span><strong>Tap, Task, Done</strong></a><nav class="sidebar-menu"></nav><div class="sidebar-account"><span class="account-avatar">U</span><div><strong id="sidebarName">User</strong><span id="sidebarEmail">user@email.com</span></div></div></aside>
<main><header><h1>My Jobs</h1></header><section class="settings-content jobs-page"><div class="jobs-intro"><div><h2>My Jobs</h2><p>Review booking requests, sent offers, and assigned work.</p></div></div>
@if (Request.Query["legacy"] == "1") {
<div class="jobs-data-note"><p>Older jobs saved on this browser only. They have not been imported. <a href="/MyJobs">Back to database jobs</a></p></div><div class="job-tabs"><button class="selected" data-filter="requests" aria-pressed="true">Booking requests</button><button data-filter="offers" aria-pressed="false">My offers</button><button data-filter="active" aria-pressed="false">My active jobs</button><button data-filter="completed" aria-pressed="false">Completed</button></div><div id="jobsList" class="jobs-list" aria-live="polite"></div><script src="/js/my-jobs.js" asp-append-version="true"></script>
} else {
var selected = Request.Query["view"].ToString(); if (selected != "scheduled" && selected != "active" && selected != "completed" && selected != "requests" && selected != "offers" && selected != "cancelled") selected = "requests";
var pendingBookings = Model.Bookings.Where(b => b.Booking.Status == "pending").ToList();
var cancelledBookings = Model.Bookings.Where(b => b.Booking.Status == "cancelled" && !Model.Jobs.Any(j => j.Task.Id == b.Task.Id)).ToList();
var pendingOnly = selected == "offers" && Request.Query["pending"] == "1";
var now = DateTime.UtcNow;
var visible = Model.Jobs.Where(j => selected == "cancelled" ? j.Task.Status == "cancelled" : selected == "offers" ? (pendingOnly ? j.Offer.Status == "pending" && j.Task.Status == "open" && (j.Task.PostExpiresUtc == null || j.Task.PostExpiresUtc > now) : j.Offer.Status != "accepted" && j.Task.Status != "cancelled") : selected == "scheduled" ? j.Offer.Status == "accepted" && TaskSchedule.IsUpcoming(j.Task, now) : selected == "active" ? !TaskSchedule.IsUpcoming(j.Task, now) && j.Offer.Status == "accepted" && j.Task.Status != "completed" && j.Task.Status != "cancelled" && j.Task.Status != "expired" : j.Offer.Status == "accepted" && j.Task.Status == "completed").ToList();
var typeFilter = Request.Query["jobType"].ToString();
if (!JobTypes.Valid(typeFilter)) typeFilter = "";
if (typeFilter != "") {
    pendingBookings = pendingBookings.Where(b => b.Task.JobType == typeFilter).ToList();
    cancelledBookings = cancelledBookings.Where(b => b.Task.JobType == typeFilter).ToList();
    visible = visible.Where(j => j.Task.JobType == typeFilter).ToList();
}
@if (!string.IsNullOrWhiteSpace(Model.Notice)) { <div class="job-notice" role="status">@Model.Notice</div> }
<section class="jobs-activity" data-work-lock-state="@(Model.WorkLocked ? "true" : "false")" aria-label="Work activity">
<p class="job-notice" data-work-lock-notice hidden="@(!Model.WorkLocked)" role="status">@JobAcceptanceRules.Message</p>
<nav class="job-tabs" aria-label="Work activity"><a class="@(selected == "requests" ? "selected" : "")" aria-current="@(selected == "requests" ? "page" : null)" href="/MyJobs?view=requests&amp;jobType=@typeFilter">Booking requests (@pendingBookings.Count)</a><a class="@(selected == "offers" ? "selected" : "")" aria-current="@(selected == "offers" ? "page" : null)" href="/MyJobs?view=offers&amp;jobType=@typeFilter">My offers</a><a class="@(selected == "scheduled" ? "selected" : "")" aria-current="@(selected == "scheduled" ? "page" : null)" href="/MyJobs?view=scheduled&amp;jobType=@typeFilter">Scheduled</a><a class="@(selected == "active" ? "selected" : "")" aria-current="@(selected == "active" ? "page" : null)" href="/MyJobs?view=active&amp;jobType=@typeFilter">My active jobs</a><a class="@(selected == "completed" ? "selected" : "")" aria-current="@(selected == "completed" ? "page" : null)" href="/MyJobs?view=completed&amp;jobType=@typeFilter">Completed</a><a class="@(selected == "cancelled" ? "selected" : "")" aria-current="@(selected == "cancelled" ? "page" : null)" href="/MyJobs?view=cancelled&amp;jobType=@typeFilter">Cancelled</a></nav>
<form method="get" class="job-type-filter"><input type="hidden" name="view" value="@selected" /><input type="hidden" name="pending" value="@(pendingOnly ? "1" : "")" /><label>Job type<select name="jobType"><option value="">All job types</option><option value="short" selected="@(typeFilter == "short")">Short Job</option><option value="long" selected="@(typeFilter == "long")">Long Job</option><option value="multi-day" selected="@(typeFilter == "multi-day")">Multi-Day Job</option></select></label><button type="submit">Filter</button></form>
<div class="jobs-section-heading"><h2>@(pendingOnly ? "Pending offers" : selected switch { "offers" => "My offers", "scheduled" => "Scheduled jobs", "active" => "Active jobs", "completed" => "Completed jobs", "cancelled" => "Cancelled jobs", _ => "Booking requests" })</h2>@if (pendingOnly) { <a href="/MyJobs?view=offers&amp;jobType=@typeFilter">View all offers</a> }</div>
<div class="jobs-list">
@if (Model.Unavailable) { <div class="jobs-empty"><h3>Jobs are unavailable</h3><p>Check the database connection and try again.</p></div> }
else if (selected == "requests") {
    if (pendingBookings.Count == 0) { <div class="jobs-empty"><h3>No booking requests yet</h3><p>Requests from clients will appear here.</p></div> }
    foreach (var booking in pendingBookings) { <article class="job-card"><div class="job-card-head"><div><h2>@booking.Task.Title</h2><p>@booking.Task.Description</p></div><span class="job-status">Pending</span></div><div class="job-meta"><span>@booking.Task.JobTypeDisplay</span><span>@booking.Task.Location</span><span>Task budget @booking.Task.BudgetDisplay</span><span><a asp-page="/ReviewProfile" asp-route-id="@booking.Task.ClientId" asp-route-role="client">@booking.ClientName</a></span><span>Schedule: @booking.Task.ScheduleText</span></div><p>Discuss the work first. After accepting, both of you must confirm the final terms in Tracking before travel.</p><form method="post" asp-page="/Messages" asp-page-handler="Start" class="job-message-form"><input type="hidden" name="taskId" value="@booking.Task.Id" /><button type="submit" class="job-progress-button">Message client</button></form><form method="post" asp-page="/BookingRequests" asp-page-handler="Decide" class="job-actions"><input type="hidden" name="id" value="@booking.Booking.Id" /><button class="job-primary" name="decision" value="accept" data-work-guard disabled="@Model.WorkLocked">Accept request</button><button name="decision" value="decline">Decline</button></form></article> }
}
else if (visible.Count == 0 && (selected != "cancelled" || cancelledBookings.Count == 0)) { <div class="jobs-empty"><span class="jobs-empty-icon" aria-hidden="true">▤</span><h3>@(selected == "cancelled" ? "No cancelled jobs" : selected == "offers" ? (pendingOnly ? "No pending offers" : "No offers yet") : selected == "scheduled" ? "No scheduled jobs" : selected == "active" ? "No active jobs yet" : "No completed jobs yet")</h3><p>@(selected == "cancelled" ? "Cancelled tasks will appear here." : selected == "offers" ? (pendingOnly ? "Offers awaiting a client response appear here." : "Find a task and send your first offer.") : selected == "scheduled" ? "Upcoming accepted bookings and jobs appear here." : selected == "active" ? "Jobs due or underway appear here." : "Jobs confirmed by the client will appear here.")</p></div> }
@if (selected == "cancelled") { foreach (var booking in cancelledBookings) { <article class="job-card"><div class="job-card-head"><h2>@booking.Task.Title</h2><span class="job-status">Cancelled</span></div><p><a asp-page="/ReviewProfile" asp-route-id="@booking.Task.ClientId" asp-route-role="client">@booking.ClientName</a></p><p><strong>Cancellation reason:</strong> @booking.Task.CancellationReason</p></article> } }
@foreach (var job in selected == "requests" ? Enumerable.Empty<MyJobsModel.JobItem>() : visible) { <article class="job-card"><div class="job-card-head"><div><h2>@job.Task.Title</h2><p>@job.Task.Description</p></div><div class="job-card-summary"><strong>@job.Offer.Price.ToString("₱#,##0.00")</strong><span class="job-status">@(selected == "offers" ? job.Offer.Status : TaskSchedule.DisplayStatus(job.Task, now))</span></div></div><div class="job-meta"><span>@job.Task.JobTypeDisplay</span>@if (!string.IsNullOrWhiteSpace(job.Task.ScheduleText)) { <span>@job.Task.ScheduleText</span> }<span>@(job.Offer.Status == "accepted" ? job.Task.Location : tts.Data.TaskLocationRules.PublicArea)</span><span><a asp-page="/ReviewProfile" asp-route-id="@job.Task.ClientId" asp-route-role="client">@job.ClientName</a></span></div>
@if (job.Task.Status == "cancelled") { <p><strong>Cancellation reason:</strong> @job.Task.CancellationReason</p> }
@if (job.Offer.Status == "withdrawn") { <p><strong>Withdrawal reason:</strong> @job.Offer.WithdrawalReason</p><p>You cannot send another offer for this same task.</p> }
@if (job.Offer.Status is "accepted" or "pending") { <form method="post" asp-page="/Messages" asp-page-handler="Start" class="job-message-form"><input type="hidden" name="taskId" value="@job.Task.Id" /><button type="submit" class="job-progress-button">Message client</button></form> }
@if (selected == "active") { <div class="job-card-actions"><a class="job-progress-button" href="/Tracking?taskId=@job.Task.Id">View progress</a></div> }
@if (selected == "active" && job.Task.Status == "assigned") { <form method="post" asp-page-handler="Advance" class="job-actions"><input type="hidden" name="id" value="@job.Task.Id" /><input type="hidden" name="action" value="travel" /><p class="job-meta">Travel opens Tracking and asks permission to share location until arrival.</p><button class="job-primary" data-work-guard disabled="@Model.WorkLocked">Start travel</button></form> }
@if (selected is "active" or "scheduled" && job.Task.Status == "assigned") { <details class="job-withdraw"><summary>Withdraw from this job</summary><p>The client will be notified. You cannot reapply to this task.</p><form method="post" asp-page-handler="Withdraw" data-withdraw-job="@job.Task.Title"><input type="hidden" name="id" value="@job.Task.Id" /><label>Reason for withdrawing<textarea name="reason" maxlength="500" required></textarea></label><button type="submit">Review withdrawal</button></form></details> }
@if (job.Offer.Status == "accepted" && JobCancellation.CanRequest(job.Task.Status)) { <p><a href="/Tracking?taskId=@job.Task.Id">Request cancellation in Tracking</a></p> }
@if (selected == "active" && job.Task.Status is "on-the-way" or "arrived" or "in-progress" or "awaiting-confirmation") { <p>If you cannot continue, contact the client to discuss the work and any payment already agreed upon.</p> }

@if (job.Task.Status == "awaiting-confirmation" && job.Offer.Status == "accepted") { <p>Waiting for the client to confirm completion.</p> }</article> }
</div>
</section>
}</section></main></div>
<dialog id="withdrawJobDialog" aria-labelledby="withdrawJobTitle" aria-describedby="withdrawJobDescription">
    <h2 id="withdrawJobTitle">Withdraw from this job?</h2>
    <strong data-job-title></strong>
    <p id="withdrawJobDescription">The client will be notified, and the task will reopen for other freelancers. You cannot undo this or reapply to the same task.</p>
    <form method="dialog">
        <button value="cancel" autofocus>Keep job</button>
        <button value="withdraw">Confirm withdrawal</button>
    </form>
</dialog>
<script defer src="/js/withdraw-job.js" asp-append-version="true"></script>

    <partial name="_TaskHelp" />
</body></html>
