@page
@using tts.Data
@model tts.Pages.MyJobsModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en"><head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" /><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>My Jobs - Tap, Task, Done</title><link rel="stylesheet" href="/css/settings.css" asp-append-version="true" /><link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" /><script defer src="/js/sidebar-account.js" asp-append-version="true"></script>
    <script defer src="/js/profile-photo.js" asp-append-version="true"></script><link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" /><link rel="stylesheet" href="/css/my-jobs.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/sidebar-consistency.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/workspace-spacing.css" asp-append-version="true" />
<partial name="_AccountTheme" /></head>
<body class="my-jobs-page"><div class="settings-layout"><aside class="sidebar"><a class="brand" asp-page="/Landing" aria-label="Tap, Task, Done landing page" style="text-decoration:none"><span class="brand-icon">✓</span><strong>Tap, Task, Done</strong></a><nav class="sidebar-menu"></nav><div class="sidebar-account"><span class="account-avatar">U</span><div><strong id="sidebarName">User</strong><span id="sidebarEmail">user@email.com</span></div></div></aside>
<main><header><h1>My Jobs</h1></header><section class="settings-content jobs-page"><p class="jobs-page-description" data-i18n>Review booking requests, sent offers, and assigned work.</p>
@if (Request.Query["legacy"] == "1") {
<div class="jobs-data-note"><p>Older jobs saved on this browser only. They have not been imported. <a href="/MyJobs" data-i18n>Back to database jobs</a></p></div><div class="job-tabs"><button class="selected" data-filter="requests" aria-pressed="true">Booking requests</button><button data-filter="offers" aria-pressed="false">My offers</button><button data-filter="active" aria-pressed="false">My active jobs</button><button data-filter="completed" aria-pressed="false">Completed</button></div><div id="jobsList" class="jobs-list" aria-live="polite"></div><script src="/js/my-jobs.js" asp-append-version="true"></script>
} else {
var selected = Request.Query["view"].ToString(); if (selected == "cancelled") selected = "closed"; if (selected != "scheduled" && selected != "active" && selected != "completed" && selected != "requests" && selected != "offers" && selected != "closed") selected = "requests";
var closedFilter = Request.Query["closedFilter"].ToString(); if (closedFilter is not ("cancelled" or "expired" or "withdrawn")) closedFilter = "all";
var pendingBookings = Model.Bookings.Where(b => b.Booking.Status == "pending" && b.Task.Status is "open" or "booking-pending").ToList();
var cancelledBookings = Model.Bookings.Where(b => (b.Booking.Status is "cancelled" or "withdrawn" or "declined" || JobActivity.IsClosedTask(b.Task.Status)) && !Model.Jobs.Any(j => j.Task.Id == b.Task.Id) && (closedFilter == "all" || closedFilter == "expired" && b.Task.Status == "expired" || closedFilter == "cancelled" && (b.Task.Status is "cancelled" or "canceled" || b.Booking.Status == "cancelled") || closedFilter == "withdrawn" && b.Booking.Status == "withdrawn")).ToList();
var offerFilter = Request.Query["offerFilter"] == "declined" ? "declined" : "pending";
var pendingOnly = selected == "offers" && offerFilter == "pending";
var now = DateTime.UtcNow;

var visible = Model.Jobs.Where(j => JobActivity.InView(j.Task, j.Offer, selected, pendingOnly, now) && (selected != "offers" || (offerFilter == "pending" ? j.Offer.Status == "pending" : j.Offer.Status is "declined" or "rejected")) && (selected != "closed" || JobActivity.MatchesClosed(j.Task, j.Offer, closedFilter))).ToList();
var typeFilter = Request.Query["jobType"].ToString();
if (!JobTypes.Valid(typeFilter)) typeFilter = "";
if (typeFilter != "") {
    pendingBookings = pendingBookings.Where(b => b.Task.JobType == typeFilter).ToList();
    cancelledBookings = cancelledBookings.Where(b => b.Task.JobType == typeFilter).ToList();
    visible = visible.Where(j => j.Task.JobType == typeFilter).ToList();
}
@if (!string.IsNullOrWhiteSpace(Model.Notice)) { <div class="job-notice" role="status">@Model.Notice</div> }
<section class="jobs-activity" data-work-lock-state="@(Model.WorkLocked ? "true" : "false")" aria-label="Work activity">
<p class="job-notice" data-work-lock-notice hidden="@(!Model.WorkLocked)" role="status">@JobAcceptanceRules.Message</p>
<nav class="job-tabs" aria-label="Work activity"><a class="@(selected == "requests" ? "selected" : "")" aria-current="@(selected == "requests" ? "page" : null)" href="/MyJobs?view=requests&amp;jobType=@typeFilter">Booking requests (@pendingBookings.Count)</a><a class="@(selected == "offers" ? "selected" : "")" aria-current="@(selected == "offers" ? "page" : null)" href="/MyJobs?view=offers&amp;jobType=@typeFilter" data-i18n>My offers</a><a class="@(selected == "scheduled" ? "selected" : "")" aria-current="@(selected == "scheduled" ? "page" : null)" href="/MyJobs?view=scheduled&amp;jobType=@typeFilter" data-i18n>Scheduled</a><a class="@(selected == "active" ? "selected" : "")" aria-current="@(selected == "active" ? "page" : null)" href="/MyJobs?view=active&amp;jobType=@typeFilter" data-i18n>My active jobs</a><a class="@(selected == "completed" ? "selected" : "")" aria-current="@(selected == "completed" ? "page" : null)" href="/MyJobs?view=completed&amp;jobType=@typeFilter" data-i18n>Completed</a><a class="@(selected == "closed" ? "selected" : "")" aria-current="@(selected == "closed" ? "page" : null)" href="/MyJobs?view=closed&amp;jobType=@typeFilter" data-i18n>Closed</a></nav>
@if (selected == "closed") {
    <nav class="closed-job-filters" aria-label="Closed work filters">
    @foreach (var filter in new[] { ("all", "All"), ("cancelled", "Cancelled"), ("expired", "Expired"), ("withdrawn", "Withdrawn") }) {
        <a href="/MyJobs?view=closed&amp;closedFilter=@filter.Item1&amp;jobType=@typeFilter" aria-current="@(closedFilter == filter.Item1 ? "page" : null)">@filter.Item2</a>
    }
    </nav>
}
@if (selected == "offers") {
<nav class="closed-job-filters" aria-label="Offer status"><a href="/MyJobs?view=offers&amp;offerFilter=pending&amp;jobType=@typeFilter" aria-current="@(offerFilter == "pending" ? "page" : null)" data-i18n>Pending</a><a href="/MyJobs?view=offers&amp;offerFilter=declined&amp;jobType=@typeFilter" aria-current="@(offerFilter == "declined" ? "page" : null)" data-i18n>Declined</a></nav>
<p class="jobs-page-description" data-i18n>Pending offers await the client’s response. Accepted work moves to Scheduled or My active jobs.</p>
}
<form method="get" class="job-type-filter"><input type="hidden" name="view" value="@selected" /><input type="hidden" name="closedFilter" value="@closedFilter" /><input type="hidden" name="offerFilter" value="@offerFilter" /><input type="hidden" name="pending" value="@(pendingOnly ? "1" : "")" /><label>Job type<select name="jobType"><option value="">All job types</option><option value="short" selected="@(typeFilter == "short")">Short Job</option><option value="long" selected="@(typeFilter == "long")">Long Job</option><option value="multi-day" selected="@(typeFilter == "multi-day")">Multi-Day Job</option></select></label><button type="submit">Filter</button></form>
<div class="jobs-section-heading"><h2>@(pendingOnly ? "Pending offers" : selected switch { "offers" => "My offers", "scheduled" => "Scheduled jobs", "active" => "Active jobs", "completed" => "Completed jobs", "closed" => "Closed jobs", _ => "Booking requests" })</h2></div>
<div class="jobs-list">
@if (Model.Unavailable) { <div class="jobs-empty"><h3>Jobs are unavailable</h3><p data-i18n>Check the database connection and try again.</p></div> }
else if (selected == "requests") {
    if (pendingBookings.Count == 0) { <div class="jobs-empty"><h3>No booking requests yet</h3><p data-i18n>Requests from clients will appear here.</p></div> }
    foreach (var booking in pendingBookings) { <article class="job-card"><div class="job-card-head"><div><h2>@booking.Task.Title</h2><p>@booking.Task.Description</p></div><span class="job-status" data-i18n>Pending</span></div><div class="job-meta"><span>@booking.Task.JobTypeDisplay</span><span>@booking.Task.Location</span><span>Task budget @booking.Task.BudgetDisplay</span><span><a asp-page="/ReviewProfile" asp-route-id="@booking.Task.ClientId" asp-route-role="client">@booking.ClientName</a></span><span>Schedule: @booking.Task.ScheduleText</span></div><p data-i18n>Discuss the work first. After accepting, both of you must confirm the final terms in Tracking before travel.</p><form method="post" asp-page="/Messages" asp-page-handler="Start" class="job-message-form"><input type="hidden" name="taskId" value="@booking.Task.Id" /><button type="submit" class="job-progress-button">Message client</button></form><form method="post" asp-page="/BookingRequests" asp-page-handler="Decide" class="job-actions"><input type="hidden" name="id" value="@booking.Booking.Id" /><button class="job-primary" name="decision" value="accept" data-work-guard disabled="@Model.WorkLocked">Accept request</button><button name="decision" value="decline">Decline</button></form></article> }
}
else if (visible.Count == 0 && (selected != "closed" || cancelledBookings.Count == 0)) { <div class="jobs-empty"><span class="jobs-empty-icon" aria-hidden="true">▤</span><h3>@(selected == "closed" ? "No closed jobs" : selected == "offers" ? (pendingOnly ? "No pending offers" : "No offers yet") : selected == "scheduled" ? "No scheduled jobs" : selected == "active" ? "No active jobs yet" : "No completed jobs yet")</h3><p>@(selected == "closed" ? "Cancelled, expired, and withdrawn work appears here." : selected == "offers" ? (pendingOnly ? "Offers awaiting a client response appear here." : "Find a task and send your first offer.") : selected == "scheduled" ? "Upcoming accepted bookings and jobs appear here." : selected == "active" ? "Jobs due or underway appear here." : "Jobs confirmed by the client will appear here.")</p></div> }
@if (selected == "closed") { foreach (var booking in cancelledBookings) { <article class="job-card"><div class="job-card-head"><h2>@booking.Task.Title</h2><span class="job-status">Task: @TaskProgress.Label(booking.Task.Status)</span></div><p><a asp-page="/ReviewProfile" asp-route-id="@booking.Task.ClientId" asp-route-role="client">@booking.ClientName</a></p><p><strong>Booking:</strong> @booking.Booking.Status</p><p><strong>Cancellation reason:</strong> @booking.Task.CancellationReason</p><a class="job-progress-button" href="/JobRecord?taskId=@booking.Task.Id" data-i18n>View record</a></article> } }
@foreach (var job in selected == "requests" ? Enumerable.Empty<MyJobsModel.JobItem>() : visible) { <article class="job-card" id="job-@job.Task.Id"><div class="job-card-head"><div><small class="job-reference">Task #@job.Task.Id · Client: @job.ClientName</small><h2>@job.Task.Title</h2><p>@job.Task.Description</p></div><div class="job-card-summary"><strong>@job.Offer.Price.ToString("₱#,##0.00")</strong><span class="job-status" data-status="@job.Task.Status">Task: @TaskSchedule.DisplayStatus(job.Task, now)</span><span class="job-status offer-status" data-status="@job.Offer.Status">Your offer: @job.Offer.Status</span></div></div><div class="job-meta"><span>@job.Task.JobTypeDisplay</span>@if (!string.IsNullOrWhiteSpace(job.Task.ScheduleText)) { <span>@job.Task.ScheduleText</span> }<span>@(job.Offer.Status == "accepted" ? job.Task.Location : tts.Data.TaskLocationRules.PublicArea)</span><span><a asp-page="/ReviewProfile" asp-route-id="@job.Task.ClientId" asp-route-role="client">@job.ClientName</a></span></div>
<div class="job-card-actions"><a class="job-progress-button" href="/JobRecord?taskId=@job.Task.Id" data-i18n>View record</a></div>
@if (selected == "offers") { <div class="offer-application-details"><p><strong>Sent:</strong> @DisplayTime.Philippine(job.Offer.CreatedAt)</p>@if (!string.IsNullOrWhiteSpace(job.Offer.Message)) { <p><strong>Your message:</strong> @job.Offer.Message</p> }</div> }
@if (job.Task.Status == "cancelled") { <p><strong>Cancellation reason:</strong> @job.Task.CancellationReason</p> }
@if (job.Offer.Status == "withdrawn") { <p><strong>Withdrawal reason:</strong> @job.Offer.WithdrawalReason</p><p data-i18n>You cannot send another offer for this same task.</p> }
@if (job.Offer.Status is "accepted" or "pending") { <form method="post" asp-page="/Messages" asp-page-handler="Start" class="job-message-form"><input type="hidden" name="taskId" value="@job.Task.Id" /><button type="submit" class="job-progress-button">Message client</button></form> }
@if (selected == "active") { <div class="job-card-actions"><a class="job-progress-button" href="/Tracking?taskId=@job.Task.Id" data-i18n>View progress</a></div> }
@if (job.Offer.Status == "accepted" && job.Task.Status is "completed" or "cancelled") { <div class="job-card-actions"><a class="job-progress-button" href="/Tracking?taskId=@job.Task.Id" data-i18n>View history</a></div> }
@if (selected == "active" && job.Task.Status == "assigned") { <form method="post" asp-page-handler="Advance" class="job-actions"><input type="hidden" name="id" value="@job.Task.Id" /><input type="hidden" name="action" value="travel" /><p class="job-meta" data-i18n>Travel opens Tracking and asks permission to share location until arrival.</p><button class="job-primary" data-work-guard disabled="@Model.WorkLocked">Start travel</button></form> }
@if (selected is "active" or "scheduled" && job.Task.Status == "assigned") { <details class="job-withdraw"><summary>Withdraw from this job</summary><p data-i18n>The client will be notified. You cannot reapply to this task.</p><form method="post" asp-page-handler="Withdraw" data-withdraw-job="@job.Task.Title"><input type="hidden" name="id" value="@job.Task.Id" /><label>Reason for withdrawing<textarea name="reason" maxlength="500" required></textarea></label><button type="submit">Review withdrawal</button></form></details> }
@if (job.Offer.Status == "accepted" && JobCancellation.CanRequest(job.Task.Status)) { <p><a href="/Tracking?taskId=@job.Task.Id" data-i18n>Request cancellation in Tracking</a></p> }
@if (selected == "active" && job.Task.Status is "on-the-way" or "arrived" or "in-progress" or "awaiting-confirmation") { <p data-i18n>If you cannot continue, contact the client to discuss the work and any payment already agreed upon.</p> }

@if (job.Task.Status == "awaiting-confirmation" && job.Offer.Status == "accepted") { <p data-i18n>Waiting for the client to confirm completion.</p> }</article> }
</div>
</section>
}</section></main></div>
<dialog id="withdrawJobDialog" aria-labelledby="withdrawJobTitle" aria-describedby="withdrawJobDescription">
    <h2 id="withdrawJobTitle">Withdraw from this job?</h2>
    <strong data-job-title></strong>
    <p id="withdrawJobDescription" data-i18n>The client will be notified, and the task will reopen for other freelancers. You cannot undo this or reapply to the same task.</p>
    <form method="dialog">
        <button value="cancel" autofocus>Keep job</button>
        <button value="withdraw">Confirm withdrawal</button>
    </form>
</dialog>
<script defer src="/js/withdraw-job.js" asp-append-version="true"></script>

    <partial name="_TaskHelp" />
</body></html>
