@page
@using tts.Data
@model tts.Pages.MyJobsModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en"><head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" /><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>My Jobs - Tap, Task, Done</title><link rel="stylesheet" href="/css/settings.css" asp-append-version="true" /><link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" /><script defer src="/js/sidebar-account.js" asp-append-version="true"></script>
    <script defer src="/js/profile-photo.js" asp-append-version="true"></script><link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" /><link rel="stylesheet" href="/css/my-jobs.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/sidebar-consistency.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/workspace-spacing.css" asp-append-version="true" />
</head>
<body class="my-jobs-page"><div class="settings-layout"><aside class="sidebar"><div class="brand"><span class="brand-icon">✓</span><strong>Tap, Task, Done</strong></div><nav class="sidebar-menu"></nav><div class="sidebar-account"><span class="account-avatar">U</span><div><strong id="sidebarName">User</strong><span id="sidebarEmail">user@email.com</span></div></div></aside>
<main><header><h1>My Jobs</h1></header><section class="settings-content jobs-page"><div class="jobs-intro"><div><span class="jobs-overline">FREELANCER WORKSPACE</span><h2>Your work, all in one place</h2><p>Keep track of your offers and jobs.</p></div><a class="jobs-find-button" href="/FindPost?mode=jobs">Find jobs <span aria-hidden="true">→</span></a></div>
@if (Request.Query["legacy"] == "1") {
<div class="jobs-data-note"><p>Older jobs saved on this browser only. They have not been imported. <a href="/MyJobs">Back to database jobs</a></p></div><div class="job-tabs"><button class="selected" data-filter="requests" aria-pressed="true">Booking requests</button><button data-filter="offers" aria-pressed="false">My offers</button><button data-filter="active" aria-pressed="false">My active jobs</button><button data-filter="completed" aria-pressed="false">Completed</button></div><div id="jobsList" class="jobs-list" aria-live="polite"></div><script src="/js/my-jobs.js" asp-append-version="true"></script>
} else {
var selected = Request.Query["view"].ToString(); if (selected != "active" && selected != "completed" && selected != "requests" && selected != "offers" && selected != "cancelled") selected = "requests";
var pendingBookings = Model.Bookings.Where(b => b.Booking.Status == "pending").ToList();
var cancelledBookings = Model.Bookings.Where(b => b.Booking.Status == "cancelled" && !Model.Jobs.Any(j => j.Task.Id == b.Task.Id)).ToList();
var visible = Model.Jobs.Where(j => selected == "cancelled" ? j.Task.Status == "cancelled" : selected == "offers" ? j.Offer.Status != "accepted" && j.Task.Status != "cancelled" : selected == "active" ? j.Offer.Status == "accepted" && j.Task.Status != "completed" && j.Task.Status != "cancelled" : j.Offer.Status == "accepted" && j.Task.Status == "completed").ToList();
@if (!string.IsNullOrWhiteSpace(Model.Notice)) { <div class="job-notice" role="status">@Model.Notice</div> }
<div class="jobs-section-heading"><h2>Work activity</h2><p>View your offers and accepted jobs.</p></div>
<nav class="job-tabs" aria-label="Work activity"><a class="@(selected == "requests" ? "selected" : "")" href="/MyJobs?view=requests">Booking requests (@pendingBookings.Count)</a><a class="@(selected == "offers" ? "selected" : "")" href="/MyJobs?view=offers">My offers</a><a class="@(selected == "active" ? "selected" : "")" href="/MyJobs?view=active">My active jobs</a><a class="@(selected == "completed" ? "selected" : "")" href="/MyJobs?view=completed">Completed</a><a class="@(selected == "cancelled" ? "selected" : "")" href="/MyJobs?view=cancelled">Cancelled</a></nav>
<div class="jobs-list">
@if (Model.Unavailable) { <div class="jobs-empty"><h3>Jobs are unavailable</h3><p>Check the database connection and try again.</p></div> }
else if (selected == "requests") {
    if (pendingBookings.Count == 0) { <div class="jobs-empty"><h3>No booking requests yet</h3><p>Requests from clients will appear here.</p></div> }
    foreach (var booking in pendingBookings) { <article class="job-card"><div class="job-card-head"><div><h2>@booking.Task.Title</h2><p>@booking.Task.Description</p></div><span class="job-status">Pending</span></div><div class="job-meta"><span>@booking.Task.Location</span><span>Task budget ₱@booking.Task.Budget</span><span>Client: <span data-account-id="@booking.Task.ClientId">@booking.ClientName</span></span><span>Schedule: @booking.Task.ScheduleText</span></div><p>Accepting means agreeing to the work details, schedule, and proposed budget. Contact the client after accepting.</p><form method="post" asp-page="/BookingRequests" asp-page-handler="Decide" class="job-actions"><input type="hidden" name="id" value="@booking.Booking.Id" /><button class="job-primary" name="decision" value="accept">Accept request</button><button name="decision" value="decline">Decline</button></form></article> }
}
else if (visible.Count == 0 && (selected != "cancelled" || cancelledBookings.Count == 0)) { <div class="jobs-empty"><span class="jobs-empty-icon" aria-hidden="true">▤</span><h3>@(selected == "cancelled" ? "No cancelled jobs" : selected == "offers" ? "No offers yet" : selected == "active" ? "No active jobs yet" : "No completed jobs yet")</h3><p>@(selected == "cancelled" ? "Cancelled tasks will appear here." : selected == "offers" ? "Find a task and send your first offer." : selected == "active" ? "Accepted offers will appear here." : "Jobs confirmed by the client will appear here.")</p><a href="/FindPost?mode=jobs">Find jobs →</a></div> }
@if (selected == "cancelled") { foreach (var booking in cancelledBookings) { <article class="job-card"><div class="job-card-head"><h2>@booking.Task.Title</h2><span class="job-status">Cancelled</span></div><p>Client: <span data-account-id="@booking.Task.ClientId">@booking.ClientName</span></p><p><strong>Cancellation reason:</strong> @booking.Task.CancellationReason</p></article> } }
@foreach (var job in selected == "requests" ? Enumerable.Empty<MyJobsModel.JobItem>() : visible) { <article class="job-card"><div class="job-card-head"><div><h2>@job.Task.Title</h2><p>@job.Task.Description</p></div><span class="job-status">@(selected == "offers" ? job.Offer.Status : TaskProgress.Label(job.Task.Status))</span></div><div class="job-meta"><span>@job.Task.Location</span><span>Offer ₱@job.Offer.Price</span><span>Client: <span data-account-id="@job.Task.ClientId">@job.ClientName</span></span></div>
@if (job.Task.Status == "cancelled") { <p><strong>Cancellation reason:</strong> @job.Task.CancellationReason</p> }
@if (job.Offer.Status == "withdrawn") { <p><strong>Withdrawal reason:</strong> @job.Offer.WithdrawalReason</p><p>You cannot send another offer for this same task.</p> }
@if (job.Offer.Status == "accepted") { <p class="job-card-link"><a href="/Messages?taskId=@job.Task.Id">Message client</a></p> }
@if (selected == "active") { <div class="job-card-actions"><a class="job-progress-button" href="/Tracking?taskId=@job.Task.Id">View progress</a></div> }
@if (selected == "active" && job.Task.Status == "assigned") { <form method="post" asp-page-handler="Advance" class="job-actions"><input type="hidden" name="id" value="@job.Task.Id" /><input type="hidden" name="action" value="travel" /><p class="job-meta">Travel opens Tracking and asks permission to share location until arrival.</p><button class="job-primary">Start travel</button></form> }
@if (selected == "active" && job.Task.Status == "assigned") { <details class="job-withdraw"><summary>Withdraw from this job</summary><p>The client will be notified and the task will reopen for other freelancers. You cannot undo this or reapply to the same task.</p><form method="post" asp-page-handler="Withdraw" onsubmit="return confirm('Withdraw from this job? This cannot be undone.');"><input type="hidden" name="id" value="@job.Task.Id" /><label>Reason for withdrawing<textarea name="reason" maxlength="500" required></textarea></label><button type="submit">Confirm withdrawal</button></form></details> }
@if (selected == "active" && job.Task.Status is "on-the-way" or "arrived" or "in-progress" or "awaiting-confirmation") { <p>If you cannot continue, contact the client to discuss the work and any payment already agreed upon.</p> }

@if (job.Task.Status == "awaiting-confirmation" && job.Offer.Status == "accepted") { <p>Waiting for the client to confirm completion.</p> }</article> }
</div>
}</section></main></div></body></html>
