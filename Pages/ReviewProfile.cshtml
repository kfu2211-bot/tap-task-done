@page
@model tts.Pages.ReviewProfileModel
@{ Layout = null; }
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@Model.DisplayName - Service Ratings</title>
<partial name="_AccountTheme" />
<link rel="stylesheet" href="/css/review-profile.css" asp-append-version="true" />
<script defer src="/js/provider-status.js" asp-append-version="true"></script>
</head>
<body>
<main class="review-profile @(Model.ProfileRole == "Client" ? "client-review-profile" : "")">
<header class="profile-topbar">
    <a class="profile-brand" href="/Dashboard"><span aria-hidden="true">✓</span> Tap, Task, Done</a>
    <h1>@(Model.ProfileRole == "Client" ? "Client profile" : "Freelancer profile")</h1>
</header>
<a class="profile-back" href="@(Model.ProfileRole == "Client" ? "/FindPost?mode=jobs" : "/FindPost")"><span aria-hidden="true">←</span> @(Model.ProfileRole == "Client" ? "Find Jobs" : "Find a freelancer")</a>
<div class="profile-layout">
<div class="profile-main">
<section class="review-profile-card profile-overview">
    <div class="profile-identity">
        <div class="profile-avatar" aria-hidden="true">@Model.DisplayName.FirstOrDefault()</div>
        <div><h2>@Model.DisplayName</h2><partial name="_ProfileRating" model="new tts.Data.ProfileRating(Model.Reviews.Count > 0 ? Model.Reviews.Average(r => r.Rating) : 0, Model.Reviews.Count, Model.Unavailable)" /><a class="work-button work-button-secondary" href="#service-ratings" data-i18n>Service Ratings</a><p class="profile-role">@Model.ProfileRole</p>
            @if (!string.IsNullOrWhiteSpace(Model.Location)) { <p class="profile-location">@Model.Location</p> }
        </div>
    </div>
</section>
<section class="review-profile-card profile-review-list" id="service-ratings">
<div class="profile-section-heading"><h2 data-i18n>Service Ratings</h2></div>
@if (Model.CanSwitchRatingRole) { <nav class="service-rating-roles" aria-label="Profile rating role"><a href="@Url.Page("/ReviewProfile",new { id=Model.ProfileId,role="client" })" aria-current="@(Model.ProfileRole == "Client" ? "page" : null)" data-i18n>As client</a><a href="@Url.Page("/ReviewProfile",new { id=Model.ProfileId,role="freelancer" })" aria-current="@(Model.ProfileRole == "Freelancer" ? "page" : null)" data-i18n>As freelancer</a></nav> }
<p data-i18n>@(Model.ProfileRole == "Client" ? "Ratings from freelancers" : "Ratings from clients")</p>
@if(Model.Unavailable) { <p role="alert" data-i18n>Ratings are temporarily unavailable. Please try again.</p> }
else { <div class="service-rating-layout profile-ratings-layout"><partial name="_ServiceRatingSummary" model="Model.RatingItems" /><partial name="_ServiceRatingsList" model="new tts.Data.ServiceRatingsView(Model.RatingItems,false)" /></div> }
</section>
</div>
@if (Model.ProfileRole == "Freelancer")
{
<aside class="profile-aside">
<section class="review-profile-card profile-booking">
    <h2>Service rate</h2>
    <strong class="profile-rate">@(Model.ServiceRate is int rate ? $"₱{rate:N0}" : "Rate not set")</strong>
    <p class="profile-availability" data-provider-status="@Model.ProfileId">@Model.Availability</p>
    @if (Model.CanOpenBooking)
    {
        <a class="review-profile-action" href="/FindPost?providerId=@Model.ProfileId">View booking details <span aria-hidden="true">→</span></a>
    }
</section>
@if (Model.ServiceGroups.Count > 0)
{
<section class="review-profile-card profile-services">
    <h2>Services offered</h2>
    @foreach (var group in Model.ServiceGroups)
    {
        <div class="profile-service-group"><h3>@group.Key</h3>
        @if (group.Value.Length > 0) { <ul>@foreach (var service in group.Value) { <li>@service</li> }</ul> }
        </div>
    }
</section>
}
</aside>
}
</div>
</main>
</body>
</html>
