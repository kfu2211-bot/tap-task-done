@page
@model tts.Pages.ReviewProfileModel
@{ Layout = null; }
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@Model.DisplayName - Reviews</title>
<link rel="stylesheet" href="/css/review-profile.css" asp-append-version="true" />
<partial name="_AccountTheme" />
</head>
<body>
<main class="review-profile">
<header><a href="/Dashboard">Tap, Task, Done</a><h1>@(Model.ProfileRole == "Client" ? "Client profile" : "Freelancer profile")</h1></header>
<a href="@(Model.ProfileRole == "Client" ? "/FindPost?mode=jobs" : "/FindPost")">@(Model.ProfileRole == "Client" ? "Find Jobs" : "Find a freelancer")</a>
<section class="review-profile-card">
    <div class="review-profile-heading">
        <div><h2>@Model.DisplayName</h2><p>@Model.ProfileRole</p></div>
        @if (!Model.Unavailable && Model.Reviews.Count > 0)
        {
            <div><strong class="review-profile-score">★ @Model.Reviews.Average(r => r.Rating).ToString("0.0")</strong><p>@Model.Reviews.Count reviews</p></div>
        }
    </div>
    @if (Model.ProfileRole == "Freelancer")
    {
        <p class="review-profile-services">@Model.Service</p>
        <p>Service rate <strong>@(Model.ServiceRate is int rate ? $"₱{rate:N0}" : "Rate not set")</strong></p>
        <a class="review-profile-action" href="/FindPost?providerId=@Model.ProfileId">View booking details</a>
    }
</section>
<section class="review-profile-card">
<h2>@(Model.ProfileRole == "Client" ? "Reviews from freelancers" : "Reviews from clients")</h2>
@if (Model.Unavailable) { <p role="status">Reviews are temporarily unavailable. Please try again later.</p> }
else if (Model.Reviews.Count == 0) { <p>No reviews yet.</p> }
@foreach (var review in Model.Reviews)
{
    <article class="review-profile-entry">
        <div><strong>@review.Name</strong><time>@tts.Data.DisplayTime.PhilippineDate(review.CreatedAt)</time></div>
        <p class="review-profile-stars" aria-label="@review.Rating out of 5 stars">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</p>
        @if (!string.IsNullOrWhiteSpace(review.Feedback)) { <p class="review-profile-feedback">@review.Feedback</p> }
    </article>
}
</section>
</main>
</body>
</html>
