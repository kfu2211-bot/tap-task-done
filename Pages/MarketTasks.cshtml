@page
@model tts.Pages.MarketTasksModel
@{ Layout = null; var view = Request.Query["view"].ToString(); }
<!DOCTYPE html>
<html lang="en"><head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" /><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Tasks - Tap, Task, Done</title>
<link rel="stylesheet" href="/css/settings.css" asp-append-version="true" /><link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" /><link rel="stylesheet" href="/css/market-tasks.css" asp-append-version="true" /><script defer src="/js/sidebar-account.js" asp-append-version="true"></script>
    <script defer src="/js/profile-photo.js" asp-append-version="true"></script><script defer src="/js/market-task-filters.js" asp-append-version="true"></script><link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" /><link rel="stylesheet" href="/css/task-rating.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/sidebar-consistency.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/workspace-spacing.css" asp-append-version="true" />
<link rel="stylesheet" href="/lib/maplibre-gl/maplibre-gl.css" asp-append-version="true" /><link rel="stylesheet" href="/css/task-location-picker.css" asp-append-version="true" /><script defer src="/lib/maplibre-gl/maplibre-gl.js" asp-append-version="true"></script><script defer src="/js/task-location-picker.js" asp-append-version="true"></script><link rel="stylesheet" href="/css/job-offer-form.css" asp-append-version="true" /><script defer src="/js/job-offer-form.js" asp-append-version="true"></script><partial name="_AccountTheme" /><link rel="stylesheet" href="/css/compact-task-cards.css" asp-append-version="true" /></head>
<body class="client-tasks-workspace"><div class="settings-layout"><aside class="sidebar"><a class="brand" asp-page="/Landing" aria-label="Tap, Task, Done landing page" style="text-decoration:none"><span class="brand-icon">✓</span><strong>Tap, Task, Done</strong></a><nav class="sidebar-menu"><a href="/Dashboard"><span class="menu-icon">⌂</span><span data-i18n>Home</span></a><a href="/FindPost"><span class="menu-icon">⌕</span><span data-i18n>Find &amp; Post</span></a><a href="/MarketTasks?view=mine"><span class="menu-icon">▤</span><span data-i18n>My Tasks</span></a></nav><div class="sidebar-account"><span class="account-avatar">U</span><div><strong id="sidebarName">User</strong><span id="sidebarEmail"></span></div></div></aside><main class="market-main"><header class="market-header"><h1>@(view == "jobs" ? "Find Jobs" : view == "post" ? "Post a Task" : "My Tasks")</h1></header><div class="market-content">@if (view is "jobs" or "post") { <div class="market-intro"><div><span class="market-eyebrow">@(view == "jobs" ? "FREELANCER WORKSPACE" : "CLIENT WORKSPACE")</span><h2>@(view == "jobs" ? "Find your next job" : view == "post" ? "Tell us what you need" : "Manage your posted tasks")</h2><p class="muted">@(view == "jobs" ? "Explore open tasks and make an offer that works for you." : view == "post" ? "Share the details, then confirm your task so freelancers can see it." : "Track your posted tasks and review freelancer offers in one place.")</p></div>@if (view == "jobs" || view == "post") { <a class="workspace-action workspace-action-secondary" href="/FindPost?mode=post" data-i18n>Back to Post a Task</a> }</div> }
@if (!string.IsNullOrEmpty(Model.Notice)) { <p class="notice" role="status">@Model.Notice</p> }
@if (Model.LoadUnavailable) { <section class="workflow-empty" data-empty-kind="error" role="alert"><h3 data-i18n>Tasks are temporarily unavailable</h3><p data-i18n>Your tasks could not be loaded. Try again.</p><a class="work-button work-button-secondary" href="/MarketTasks?view=mine" data-i18n>Try again</a></section> }
@if (view == "post" && !Model.LoadUnavailable) {
<section class="card"><h2>Post a task</h2>@if (Model.WorkRole is "client" or "both") {
<form method="post" asp-page-handler="Create" data-submit-pending="Saving draft…"><label>Title<input name="title" maxlength="120" required /></label><label>Work details<textarea name="description" maxlength="5000" required></textarea></label><label>Category<select name="category"><option>Cleaning</option><option>Repairs</option><option>Errands</option><option>Moving</option><option>Gardening</option><option>Painting</option><option>Tutoring</option><option>Pet Care</option><option>Other / General</option></select></label><partial name="_TaskLocationPicker" model="new tts.Data.TaskLocationInput(ShowArrivalInstructions: true)" /><label>Task Budget (₱)<input name="budget" type="number" min="1" max="9999999999" step="0.01" required placeholder="e.g. 800" /></label><small data-i18n>Enter the total amount you’re offering for this task.</small><label>Post closing date<input type="date" name="postEndDate" min="@MarketTasksModel.TodayInPhilippines.ToString("yyyy-MM-dd")" max="9999-12-30" required /><small data-i18n>Open through this date (Philippine time).</small></label><partial name="_JobTypeInput" model="new tts.Data.JobTypeInput()" /><label><span data-i18n>Arrival time (Philippine time)</span><input name="schedule" type="datetime-local" required /></label><button>Save task</button></form>
} else { <p data-i18n>Set your work role to Client or Client &amp; Freelancer in Settings to post a task.</p> }</section> }
@if (view != "jobs" && view != "post" && !Model.LoadUnavailable) { <section class="market-section" id="my-tasks-section"><p class="client-tasks-intro" data-i18n>Track your posted tasks and review freelancer offers.</p><div class="task-list-count"><span id="task-filter-count" aria-live="polite">@Model.MyTasks.Count @(Model.MyTasks.Count == 1 ? "task" : "tasks")</span></div><label class="client-job-type-filter">Job type<select id="myTasksTypeFilter"><option value="">All job types</option><option value="short">Short Job</option><option value="long">Long Job</option><option value="multi-day">Multi-Day Job</option></select></label><div class="task-filters" role="group" aria-label="Filter tasks by status" hidden><button type="button" data-filter="all" aria-pressed="true">All</button><button type="button" data-filter="needs-confirmation" aria-pressed="false">Needs confirmation</button><button type="button" data-filter="new-offers" aria-pressed="false">New offers</button><button type="button" data-filter="open" aria-pressed="false">Open</button><button type="button" data-filter="scheduled" aria-pressed="false">Scheduled</button><button type="button" data-filter="active" aria-pressed="false">Active</button><button type="button" data-filter="completed" aria-pressed="false">Completed</button><button type="button" data-filter="closed" aria-pressed="false">Closed</button></div><label class="client-closed-filter" hidden>Closed status<select id="clientClosedFilter"><option value="all">All closed</option><option value="cancelled">Cancelled</option><option value="expired">Expired</option><option value="moderated">Removed by admin</option></select></label><div class="task-filter-empty workflow-empty" data-empty-kind="filtered" hidden role="status"><h3 data-i18n>No tasks match these filters</h3><p data-i18n>Try a different status or job type.</p><button class="work-button work-button-secondary" type="button" data-reset-task-filters data-i18n>Clear filters</button></div>@if (Model.MyTasks.Count == 0) { <div class="market-empty"><span class="market-empty-icon">▤</span><h3>No tasks yet</h3><p data-i18n>Post your first task to connect with a freelancer.</p><a class="market-primary" href="/FindPost?mode=post" data-i18n>+ Post a task</a></div> }
@foreach(var item in Model.MyTasks) { var task = item.Task; <article class="card task-card" data-pending-offers="@(task.Status == "open" && Model.Offers.Any(o => o.Offer.TaskId == task.Id && o.Offer.Status == "pending") ? "true" : "false")" id="task-@task.Id" data-job-type="@task.JobType" data-task-status="@(tts.Data.TaskSchedule.IsUpcoming(task, DateTime.UtcNow) ? "scheduled" : task.Status)"><details class="task-disclosure" open="@(Request.Query["reviewTask"].ToString() == task.Id.ToString())">
    <summary class="task-list-summary">
        <span class="task-list-title"><span class="task-title-line"><strong>@task.Title</strong><span class="task-status-badge" data-status="@tts.Data.TaskSchedule.DisplayStatus(task, DateTime.UtcNow)">@tts.Data.TaskSchedule.DisplayStatus(task, DateTime.UtcNow)</span></span><small>Task #@task.Id · @task.CategoryDisplay@if (!string.IsNullOrWhiteSpace(task.ScheduleText)) { <text> · @tts.Data.TaskSchedule.Display(task.ScheduleText)</text> }</small></span>
        <strong class="task-list-budget">@task.BudgetDisplay</strong>

        <svg class="task-list-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
    </summary>
    <div class="task-list-detail">
@if (Model.SourceTasks.TryGetValue(task.Id, out var sourceTaskId)) { <p>Created from <a href="/JobRecord?taskId=@sourceTaskId">task #@sourceTaskId</a>. <a href="/JobRecord?taskId=@task.Id" data-i18n>View this task’s record</a></p> }
<p class="task-description">@task.Description</p><div class="task-meta"><div><span data-i18n>Job type</span><strong>@task.JobTypeDisplay</strong></div><div><span data-i18n>Category</span><strong>@task.CategoryDisplay</strong></div><div><span data-i18n>Location</span><strong>@task.Location</strong></div><div><span data-i18n>Budget</span><strong>@task.BudgetDisplay</strong></div><div><span data-i18n>Preferred schedule</span><strong>@tts.Data.TaskSchedule.Display(task.ScheduleText)</strong></div></div>
@if(task.Status == "expired") { <p data-i18n>This post expired without an accepted offer.</p> } @if(task.Status == "booking-pending") { <p data-i18n>This is a private booking request. Waiting for your chosen freelancer to accept or decline.</p> }
@if(task.Status is "cancelled" or "moderated") { <div class="task-cancellation"><strong>@(task.Status == "moderated" ? "Moderation reason" : "Cancellation reason")</strong><p>@(string.IsNullOrWhiteSpace(task.CancellationReason) ? "No reason provided." : task.CancellationReason)</p></div> }
@{ var hasAcceptedOffer = Model.Offers.Any(o => o.Offer.TaskId == task.Id && o.Offer.Status == "accepted"); var canBookAgain = hasAcceptedOffer || Model.Bookings.Any(b => b.Booking.TaskId == task.Id); }
<partial name="_ClientTaskActions" model="new tts.Data.ClientTaskActions(task, hasAcceptedOffer, canBookAgain)" />
@if(task.Status == "open" && task.PostExpiresUtc.HasValue) { <p class="task-closing">Post closes @tts.Data.DisplayTime.Philippine(task.PostExpiresUtc.Value).</p> }
<div class="task-secondary-actions task-management-actions">
@if(task.Status is "pending-confirmation" or "booking-pending" or "open" or "assigned" or "on-the-way" or "arrived" or "in-progress" or "awaiting-confirmation") { <details class="cancel-task"><summary>Cancel task</summary><p data-i18n>Cancellation closes this task and notifies affected freelancers. This cannot be undone.</p>@if(task.Status is "assigned" or "on-the-way" or "arrived" or "in-progress" or "awaiting-confirmation") { <p data-i18n>Please discuss any work or payment already agreed upon with the freelancer.</p> }<form method="post" asp-page-handler="Cancel" data-cancel-task="@task.Title"><input type="hidden" name="id" value="@task.Id" /><label>Reason for cancellation<textarea name="reason" maxlength="500" required placeholder="Explain why this task is being cancelled"></textarea></label><button type="submit">Confirm cancellation</button></form></details> }
@if(task.Status == "pending-confirmation") { <details class="edit-task work-editor"><summary>Edit task</summary><form method="post" asp-page-handler="Edit" class="task-edit-form"><input type="hidden" name="id" value="@task.Id" /><label>Title<input name="title" value="@task.Title" maxlength="120" required /></label><label>Work details<textarea name="description" maxlength="5000" rows="3" required>@task.Description</textarea></label><label>Category<input name="category" value="@task.Category" maxlength="60" required /></label><partial name="_TaskLocationPicker" model="new tts.Data.TaskLocationInput(task.Location, Model.Destinations.GetValueOrDefault(task.Id)?.Latitude, Model.Destinations.GetValueOrDefault(task.Id)?.Longitude, true, task.ArrivalInstructions)" /><label>Task Budget (₱)<input name="budget" type="number" value="@(task.BudgetMaximum.HasValue && task.BudgetMaximum.Value != task.Budget ? null : task.Budget.ToString(System.Globalization.CultureInfo.InvariantCulture))" min="1" max="9999999999" step="0.01" required placeholder="e.g. 800" /></label><small data-i18n>Enter the total amount you’re offering for this task.</small><label>Post closing date<input type="date" name="postEndDate" min="@MarketTasksModel.TodayInPhilippines.ToString("yyyy-MM-dd")" max="9999-12-30" value="@(task.PostExpiresUtc?.AddHours(8).AddDays(-1).ToString("yyyy-MM-dd"))" required /><small data-i18n>Open through this date (Philippine time).</small></label><partial name="_JobTypeInput" model="new tts.Data.JobTypeInput(task.JobType, task.WorkEndUtc)" /><label><span data-i18n>Arrival time (Philippine time)</span><input name="schedule" type="datetime-local" value="@tts.Data.TaskSchedule.StartUtc(task.ScheduleText)?.AddHours(8).ToString("yyyy-MM-ddTHH:mm")" required /></label><button type="submit">Save changes</button></form></details><form method="post" asp-page-handler="Confirm" data-confirm-task data-submit-pending="Publishing…" ><input type="hidden" name="id" value="@task.Id" /><button class="work-button">Confirm and open task</button></form> }</div>
@if(task.Status == "awaiting-confirmation") { <p data-i18n>The freelancer marked this work finished. Confirm after checking the result.</p> }
@foreach(var booking in Model.Bookings.Where(b => b.Booking.TaskId == task.Id)) { <div class="task-record-note task-booking-record"><div><strong>Booking request to @booking.Name</strong><span>@booking.Booking.Status.Replace("-", " ")</span></div><a class="task-chat-action" href="/Messages?taskId=@task.Id&amp;freelancerId=@booking.Booking.FreelancerId" data-i18n>Discuss this request</a></div> }
@if(task.Status == "completed") {
    if(Model.ReviewsUnavailable) { <p data-i18n>Reviews are unavailable until the review database table is set up.</p> }
    else if(Model.Reviews.TryGetValue(task.Id, out var review)) { <p>Your review: ★ @review.Rating / 5</p><p>@review.Feedback</p> }
    else if(Model.Offers.Any(o => o.Offer.TaskId == task.Id && o.Offer.Status == "accepted")) { <details class="task-review"><summary><span class="task-review-icon" aria-hidden="true">★</span><span class="task-review-heading"><strong>Rate freelancer</strong><small data-i18n>Share your experience with this task</small></span><span class="task-review-toggle" aria-hidden="true">+</span></summary><form method="post" asp-page-handler="Review"><input type="hidden" name="id" value="@task.Id" /><partial name="_StarRating" /><label>Feedback (optional)<textarea name="feedback" maxlength="1000" placeholder="Tell us about your experience"></textarea></label><button type="submit">Submit review</button></form></details> }
}
@foreach(var itemOffer in Model.Offers.Where(o => o.Offer.TaskId == task.Id)) { <div class="offer"><div class="offer-heading"><div><span class="offer-label" data-i18n>Freelancer offer</span><strong data-account-id="@itemOffer.Offer.FreelancerId">@itemOffer.Name</strong><a class="task-chat-action" href="/Messages?taskId=@task.Id&amp;freelancerId=@itemOffer.Offer.FreelancerId"><svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8.5 8.5 0 0 1-12.3 7.6L3 21l1.9-5.7A8.5 8.5 0 1 1 21 11.5Z"/></svg>Discuss offer</a></div><span class="offer-status" data-status="@itemOffer.Offer.Status">@itemOffer.Offer.Status.Replace("-", " ")</span></div><div class="offer-details"><span>@itemOffer.Service</span><span>₱@itemOffer.Offer.Price</span></div>@if (!string.IsNullOrWhiteSpace(itemOffer.Offer.Message)) { <p class="offer-message">@itemOffer.Offer.Message</p> }@if(itemOffer.Offer.Status == "withdrawn") { <p><strong>Withdrawal reason:</strong> @itemOffer.Offer.WithdrawalReason</p> }@if(task.Status == "open" && itemOffer.Offer.Status == "pending") { <p class="work-help" data-i18n>To counter an offer, discuss the amount first. The freelancer updates the offer, then you accept the revised price.</p><a class="work-button work-button-secondary" href="/Messages?taskId=@task.Id&amp;freelancerId=@itemOffer.Offer.FreelancerId" data-i18n>Discuss counter-offer</a><form method="post" asp-page-handler="Accept"><input type="hidden" name="id" value="@itemOffer.Offer.Id" /><input type="hidden" name="revision" value="@tts.Data.OfferRevision.For(itemOffer.Offer)" /><button class="work-button">Accept offer</button></form> }</div> }
    <partial name="_PreAcceptanceSchedule" model="task" />
    </div></details></article> }</section> }
@if(view == "jobs") { <section><h2>Find open jobs</h2>@if(Model.WorkRole is not ("freelancer" or "both")) { <p data-i18n>Set your work role to Freelancer or Client &amp; Freelancer in Settings to find jobs.</p> } else if(Model.OpenTasks.Count == 0) { <p data-i18n>No open tasks from other clients yet.</p> }
@foreach(var item in Model.OpenTasks) { var task = item.Task; var existing = Model.Offers.FirstOrDefault(o => o.Offer.TaskId == task.Id); <article class="card" data-work-lock-state="@(Model.WorkLocked ? "true" : "false")" id="task-@task.Id"><h3>@task.Title</h3><p>@task.Description</p><p>@task.Category · @tts.Data.TaskLocationRules.PublicArea · Budget @task.BudgetDisplay · @task.ScheduleText</p><p><a asp-page="/ReviewProfile" asp-route-id="@task.ClientId" asp-route-role="client">@item.ClientName</a></p><partial name="_JobOfferForm" model="new tts.Data.JobOfferView(task, existing?.Offer.Status, Model.WorkLocked)" /></article> }
</section> }
</div></main></div>
<dialog id="cancelTaskDialog" aria-labelledby="cancelTaskTitle" aria-describedby="cancelTaskDescription">
    <h2 id="cancelTaskTitle">Cancel this task?</h2>
    <strong data-task-title></strong>
    <p id="cancelTaskDescription" data-i18n>This will close the task and notify affected freelancers. This action cannot be undone.</p>
    <form method="dialog">
        <button value="keep" autofocus>Keep task</button>
        <button value="cancel-task">Cancel task</button>
    </form>
</dialog>

    <partial name="_TaskHelp" />
</body></html>
