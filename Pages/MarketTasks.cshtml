@page
@model tts.Pages.MarketTasksModel
@{ Layout = null; var view = Request.Query["view"].ToString(); }
<!DOCTYPE html>
<html lang="en"><head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" /><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Tasks - Tap, Task, Done</title>
<link rel="stylesheet" href="/css/settings.css" asp-append-version="true" /><link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" /><link rel="stylesheet" href="/css/market-tasks.css" asp-append-version="true" /><script defer src="/js/sidebar-account.js" asp-append-version="true"></script><script defer src="/js/market-task-filters.js" asp-append-version="true"></script><link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" /><link rel="stylesheet" href="/css/task-rating.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/sidebar-consistency.css" asp-append-version="true" />
</head>
<body><div class="settings-layout"><aside class="sidebar"><div class="brand"><span class="brand-icon">✓</span><strong>Tap, Task, Done</strong></div><nav class="sidebar-menu"><a href="/Dashboard"><span class="menu-icon">⌂</span><span>Home</span></a><a href="/FindPost"><span class="menu-icon">⌕</span><span>Find &amp; Post</span></a><a href="/MarketTasks?view=mine"><span class="menu-icon">▤</span><span>My Tasks</span></a><a href="/Settings"><span class="menu-icon">⚙</span><span>Settings</span></a></nav><div class="sidebar-account"><span class="account-avatar">U</span><div><strong id="sidebarName">User</strong><span id="sidebarEmail"></span></div></div></aside><main class="market-main"><header class="market-header"><h1>@(view == "jobs" ? "Find Jobs" : view == "post" ? "Post a Task" : "My Tasks")</h1></header><div class="market-content"><div class="market-intro"><div><span class="market-eyebrow">@(view == "jobs" ? "FREELANCER WORKSPACE" : "CLIENT WORKSPACE")</span><h2>@(view == "jobs" ? "Find your next job" : view == "post" ? "Tell us what you need" : "Manage your posted tasks")</h2><p class="muted">@(view == "jobs" ? "Explore open tasks and send an offer that works for you." : view == "post" ? "Share the details, then confirm your task so freelancers can see it." : "Track your posted tasks and review freelancer offers in one place.")</p></div>@if (view == "jobs" || view == "post") { <a href="/FindPost">← Back to Find &amp; Post</a> } else if (Model.MyTasks.Count > 0) { <a class="market-primary" href="/MarketTasks?view=post">+ Post a task</a> }</div>
@if (!string.IsNullOrEmpty(Model.Notice)) { <p class="notice" role="status">@Model.Notice</p> }
@if (view == "post") {
<section class="card"><h2>Post a task</h2>@if (Model.WorkRole is "client" or "both") {
<form method="post" asp-page-handler="Create"><label>Title<input name="title" maxlength="120" required /></label><label>Description<textarea name="description" maxlength="5000" required></textarea></label><label>Category<select name="category"><option>Cleaning</option><option>Repairs</option><option>Errands</option><option>Moving</option><option>Gardening</option><option>Painting</option><option>Tutoring</option><option>Pet Care</option><option>Other / General</option></select></label><label>Location<input name="location" maxlength="120" required /></label><label>Budget (₱)<input name="budget" type="number" min="1" max="9999999999" step="0.01" required /></label><label>Preferred schedule<input name="schedule" maxlength="120" placeholder="e.g. Saturday morning" /></label><button>Save task</button></form>
} else { <p>Set your work role to Client or Client &amp; Freelancer in Settings to post a task.</p> }</section> }
@if (view != "jobs" && view != "post") { <section class="market-section" id="my-tasks-section"><div class="market-section-title"><h2>My Tasks</h2><span id="task-filter-count" aria-live="polite">@Model.MyTasks.Count @(Model.MyTasks.Count == 1 ? "task" : "tasks")</span></div><div class="task-filters" role="group" aria-label="Filter tasks by status" hidden><button type="button" data-filter="all" aria-pressed="true">All</button><button type="button" data-filter="needs-action" aria-pressed="false">Needs action</button><button type="button" data-filter="open" aria-pressed="false">Open</button><button type="button" data-filter="active" aria-pressed="false">Active</button><button type="button" data-filter="completed" aria-pressed="false">Completed</button><button type="button" data-filter="cancelled" aria-pressed="false">Cancelled</button></div><p class="task-filter-empty" hidden>No tasks in this category yet.</p>@if (Model.MyTasks.Count == 0) { <div class="market-empty"><span class="market-empty-icon">▤</span><h3>No tasks yet</h3><p>Post your first task to connect with a freelancer.</p><a class="market-primary" href="/MarketTasks?view=post">+ Post a task</a></div> }
@foreach(var item in Model.MyTasks) { var task = item.Task; <article class="card task-card" data-task-status="@task.Status"><h3>@task.Title</h3><p class="task-description">@task.Description</p><div class="task-meta"><div><span>Category</span><strong>@task.Category</strong></div><div><span>Location</span><strong>@task.Location</strong></div><div><span>Budget</span><strong>₱@task.Budget</strong></div><div><span>Preferred schedule</span><strong>@(string.IsNullOrWhiteSpace(task.ScheduleText) ? "Not specified" : task.ScheduleText)</strong></div></div><div class="task-status"><span>Status</span><strong class="task-status-badge">@task.Status.Replace("-", " ")</strong></div>
@if(task.Status == "cancelled") { <p><strong>Cancellation reason:</strong> @task.CancellationReason</p> }
<div class="task-actions">@if(Model.Offers.Any(o => o.Offer.TaskId == task.Id && o.Offer.Status == "accepted")) { <a class="task-action-message" href="/Messages?taskId=@task.Id">Message freelancer</a> }
@if(task.Status is "assigned" or "in-progress" or "awaiting-confirmation" or "disputed" or "completed") { <a class="task-action-dispute" href="/Disputes?taskId=@task.Id">View or raise a dispute</a> }
@if(task.Status is "pending-confirmation" or "open" or "assigned" or "in-progress" or "awaiting-confirmation") { <details class="cancel-task"><summary>Cancel task</summary><p>Cancellation closes this task and notifies affected freelancers. This cannot be undone.</p>@if(task.Status is "assigned" or "in-progress" or "awaiting-confirmation") { <p>Please discuss any work or payment already agreed upon with the freelancer.</p> }<form method="post" asp-page-handler="Cancel" onsubmit="return confirm('Cancel this task? This cannot be undone.');"><input type="hidden" name="id" value="@task.Id" /><label>Reason for cancellation<textarea name="reason" maxlength="500" required placeholder="Explain why this task is being cancelled"></textarea></label><button type="submit">Confirm cancellation</button></form></details> }
@if(task.Status == "pending-confirmation") { <form method="post" asp-page-handler="Confirm"><input type="hidden" name="id" value="@task.Id" /><button>Confirm and open task</button></form> }</div>
@if(task.Status == "awaiting-confirmation") { <p>The freelancer marked this work finished. Confirm after checking the result.</p><form method="post" asp-page-handler="ConfirmCompletion"><input type="hidden" name="id" value="@task.Id" /><button>Confirm completion</button></form> }
@foreach(var booking in Model.Bookings.Where(b => b.Booking.TaskId == task.Id)) { <p>Booking request to @booking.Name: @booking.Booking.Status</p> }
@if(task.Status == "completed") {
    if(Model.ReviewsUnavailable) { <p>Reviews are unavailable until the review database table is set up.</p> }
    else if(Model.Reviews.TryGetValue(task.Id, out var review)) { <p>Your review: ★ @review.Rating / 5</p><p>@review.Feedback</p> }
    else if(Model.Offers.Any(o => o.Offer.TaskId == task.Id && o.Offer.Status == "accepted")) { <details class="task-review"><summary><span class="task-review-icon" aria-hidden="true">★</span><span class="task-review-heading"><strong>Rate freelancer</strong><small>Share your experience with this task</small></span><span class="task-review-toggle" aria-hidden="true">+</span></summary><form method="post" asp-page-handler="Review"><input type="hidden" name="id" value="@task.Id" /><label>Rating<select name="rating" required><option value="">Choose a rating</option><option value="5">5 - Excellent</option><option value="4">4 - Good</option><option value="3">3 - Fair</option><option value="2">2 - Poor</option><option value="1">1 - Very poor</option></select></label><label>Feedback (optional)<textarea name="feedback" maxlength="1000" placeholder="Tell us about your experience"></textarea></label><button type="submit">Submit review</button></form></details> }
}
@foreach(var itemOffer in Model.Offers.Where(o => o.Offer.TaskId == task.Id)) { <div class="offer"><div class="offer-heading"><div><span class="offer-label">Freelancer offer</span><strong>@itemOffer.Name</strong></div><span class="offer-status">@itemOffer.Offer.Status.Replace("-", " ")</span></div><div class="offer-details"><span>@itemOffer.Service</span><span>₱@itemOffer.Offer.Price</span></div>@if (!string.IsNullOrWhiteSpace(itemOffer.Offer.Message)) { <p class="offer-message">@itemOffer.Offer.Message</p> }@if(itemOffer.Offer.Status == "withdrawn") { <p><strong>Withdrawal reason:</strong> @itemOffer.Offer.WithdrawalReason</p> }@if(task.Status == "open" && itemOffer.Offer.Status == "pending") { <form method="post" asp-page-handler="Accept"><input type="hidden" name="id" value="@itemOffer.Offer.Id" /><button>Accept offer</button></form> }</div> }
</article> }</section> }
@if(view == "jobs") { <section><h2>Find open jobs</h2>@if(Model.WorkRole is not ("freelancer" or "both")) { <p>Set your work role to Freelancer or Client &amp; Freelancer in Settings to find jobs.</p> } else if(Model.OpenTasks.Count == 0) { <p>No open tasks from other clients yet.</p> }
@foreach(var item in Model.OpenTasks) { var task = item.Task; var existing = Model.Offers.FirstOrDefault(o => o.Offer.TaskId == task.Id); <article class="card"><h3>@task.Title</h3><p>@task.Description</p><p>@task.Category · @task.Location · Budget ₱@task.Budget · @task.ScheduleText</p><p>Client: @item.ClientName</p>@if(existing != null) { <p>Offer: @existing.Offer.Status</p> } else { <form method="post" asp-page-handler="Offer"><input type="hidden" name="id" value="@task.Id" /><label>Your price (₱)<input type="number" name="price" min="1" step="0.01" required /></label><label>Message (optional)<textarea name="message" maxlength="500"></textarea></label><button>Send offer</button></form> }</article> }
<h2>My offers</h2>@if(!Model.Offers.Any(o => o.Offer.FreelancerId == Model.CurrentUserId)) { <p>No offers sent yet.</p> } @foreach(var sent in Model.Offers.Where(o => o.Offer.FreelancerId == Model.CurrentUserId)) { <div class="card">@(Model.OfferTaskTitles.TryGetValue(sent.Offer.TaskId, out var title) ? title : "Task unavailable") · ₱@sent.Offer.Price · @sent.Offer.Status</div> }</section> }
</div></main></div></body></html>
