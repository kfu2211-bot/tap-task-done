@page
@model FindPostModel

@{
    Layout = null;

    var mode = Request.Query["mode"].ToString();

    if (string.IsNullOrEmpty(mode))
    {
        mode = "freelancer";
    }
}

<!DOCTYPE html>
<html lang="en">

<head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" />

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Find & Post - Tap, Task, Done</title>

    <link rel="stylesheet"
          href="/css/findpost.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/readability.css" asp-append-version="true" />
    <script defer src="/js/sidebar-account.js" asp-append-version="true"></script>
    <script defer src="/js/profile-photo.js" asp-append-version="true"></script>

<link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/findpost-light.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/sidebar-consistency.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/workspace-spacing.css" asp-append-version="true" />
</head>

<body>

    <div class="app-shell">


        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <aside class="sidebar">


            <!-- LOGO -->

            <div class="sidebar-logo">

                <div class="logo-check">
                    ✓
                </div>

                <span>
                    Tap, Task, Done
                </span>

            </div>


            <!-- NAVIGATION -->

            <nav class="sidebar-navigation">

                <a href="/Dashboard"
                   class="sidebar-item">

                    <span class="sidebar-icon">
                        ⌂
                    </span>

                    <span>
                        Home
                    </span>

                </a>


                <a href="/FindPost"
                   class="sidebar-item active">

                    <span class="sidebar-icon">
                        ⌕
                    </span>

                    <span>
                        Find &amp; Post
                    </span>

                </a>


                <a href="/MyTasks"
                   class="sidebar-item">

                    <span class="sidebar-icon">
                          ▤
                    </span>

                    <span>
                        My Tasks
                    </span>

                </a>


                <!-- MESSAGES - CONNECTED -->

                <a href="/Messages"
                   class="sidebar-item">

                    <span class="sidebar-icon">
                        □
                    </span>

                    <span>
                        Messages
                    </span>

                </a>


                <a href="/IdentityVerification"
                   class="sidebar-item">

                    <span class="sidebar-icon">
                        ✓
                    </span>

                    <span>
                        Identity Verification
                    </span>

                </a>


                <!-- TRACKING - CONNECTED -->

                <a href="/Tracking"
                   class="sidebar-item">

                    <span class="sidebar-icon">
                          ➤
                    </span>

                    <span>
                        Tracking
                    </span>

                </a>


                <!-- REVIEWS - CONNECTED -->

                <a href="/Reviews"
                   class="sidebar-item">

                    <span class="sidebar-icon">
                        ☆
                    </span>

                    <span>
                        Reviews
                    </span>

                </a>

            </nav>


            <!-- USER -->

            <div class="sidebar-user">


                <div class="user-avatar"
                     id="userAvatar">

                    JD

                </div>


                <div class="user-details">

                    <strong id="sidebarName">
                        Jordan Dela Cruz
                    </strong>

                    <span id="sidebarEmail">
                        jordan@gmail.com
                    </span>

                </div>


                <button class="user-more"
                        id="userMoreButton"
                        type="button">

                    ⋮

                </button>


            </div>


        </aside>



        <!-- ================================================= -->
        <!-- MAIN AREA -->
        <!-- ================================================= -->

        <main class="main-area">
<section class="search-demo-banner" style="margin:16px 24px;padding:14px 18px;border:1px solid #cde0cf;border-radius:10px;background:#edf5ed;color:#193e30">
@if (Model.DemoMode) { <strong>DEMO SEARCH · 13 sample freelancers and 8 sample jobs</strong><p style="margin:6px 0">Search-only classroom examples. Bookings, offers and posting are disabled. <a href="/FindPost">Back to real records</a></p> }
else { <span>Testing search and matching? <a href="/FindPost?demo=1">Open demo search data</a></span> }
</section>


            <!-- TOP BAR -->

            <header class="topbar">


                <h1>
                    Find &amp; Post
                </h1>


                <button class="notification-button"
                        id="notificationButton"
                        type="button">

                    ♧

                </button>


            </header>



            <!-- ================================================= -->
            <!-- PAGE CONTENT -->
            <!-- ================================================= -->

            <div class="page-content">


                <!-- ================================================= -->
                <!-- MODE SWITCHER -->
                <!-- ================================================= -->

                <div class="mode-switcher">


                    <button class="mode-button @(mode == "freelancer" ? "active" : "")"
                            id="findFreelancerButton"
                            type="button">

                        Find a Freelancer

                    </button>


                    <button class="mode-button @(mode == "post" ? "active" : "")"
                            id="postTaskButton"
                            type="button">

                        Post a Task

                    </button>


                    <button class="mode-button @(mode == "jobs" ? "active" : "")"
                            id="findJobsButton"
                            type="button">

                        Find Jobs

                    </button>


                </div>




                <!-- ================================================= -->
                <!-- FIND FREELANCER AREA -->
                <!-- ================================================= -->

                <section id="findFreelancerSection"
                         class="find-layout @(mode != "freelancer" ? "hidden" : "")">


                    <!-- FILTER PANEL -->

                    <aside class="filter-panel">

                        <div id="otherCategoryNotice" hidden><strong>Others: unique skills</strong><p>Available services that do not match the listed categories. Search by a specific skill, or <a href="/FindPost">browse all services</a>.</p></div>

                        <div class="filter-group">

                            <label for="serviceSearch">
                                Service
                            </label>

                            <div class="input-wrapper">

                                <span>
                                    ⌕
                                </span>

                                <input type="text"
                                       id="serviceSearch"
                                       placeholder="Search service..." />

                            </div>

                        </div>



                        <div class="filter-group">

                            <label for="locationInput">
                                Location
                            </label>

                            <div class="input-wrapper">

                                <span>
                                    ♧
                                </span>

                                <input type="text"
                                       id="locationInput"
                                       placeholder="City or province, e.g. Makati" />

                            </div>

                        </div>



                        <div class="filter-group">

                            <label for="budgetInput">
                                Budget
                            </label>

                            <div class="input-wrapper">

                                <span>
                                    ₱
                                </span>

                                <input type="text"
                                       id="budgetInput"
                                       placeholder="Maximum budget, e.g. 1500" inputmode="decimal" />

                            </div>

                        </div>



                        <div class="filter-group"><label for="availabilityFilter">Availability</label><div class="input-wrapper"><select id="availabilityFilter" style="width:100%;height:100%;padding:0 12px;border:0;background:transparent;color:inherit;font:inherit"><option value="">Any availability</option><option value="Available">Available</option><option value="Busy">Busy</option><option value="Day off">Day off</option></select></div></div>
                        <button class="search-button"
                                id="searchButton"
                                type="button">

                            <span>
                                ⌕
                            </span>

                            Search

                        </button>


                    </aside>



                    <!-- RESULTS AREA -->

                    <div class="results-area">


                        <section class="provider-search-intro">
                            <span>Find a trusted provider</span>
                            <h2>Compare freelancers before you send a request.</h2>
                            <p>Search profiles by service, location, budget, and availability.</p>
                            @if (!string.IsNullOrEmpty(Model.Notice) && mode != "jobs") { <p role="status">@Model.Notice</p> }
                        </section>



                        <!-- AVAILABLE FREELANCERS -->

                        <section class="freelancers-section">


                            <div class="section-heading">

                                <h2>
                                    Available freelancers
                                </h2>

                            </div>



                            <div class="freelancer-list"
                                 id="freelancerList">
                                @foreach (var provider in Model.Providers)
                                {
                                    <article class="freelancer-card" data-id="@provider.Id" data-service="@provider.Service" data-location="@provider.Location" data-rate="@provider.Rate" data-availability="@provider.Availability" data-demo="@(Model.DemoMode ? "true" : "false")">
                                        <div class="freelancer-left"><div class="freelancer-avatar">@(provider.Name.Length > 0 ? provider.Name.Substring(0, 1).ToUpperInvariant() : "F")</div><div class="freelancer-info"><strong>@provider.Name</strong><span>@provider.Service</span></div></div>
                                        <div class="freelancer-right"><div class="freelancer-rating"><strong>@(Model.RatingsUnavailable ? "Ratings unavailable" : Model.Ratings.TryGetValue(provider.Id, out var rating) ? $"★ {rating.Average:0.0} ({rating.Count})" : "No ratings yet")</strong></div><div class="freelancer-price">@(provider.Rate.HasValue ? $"₱{provider.Rate}" : "Rate not set")</div><button class="arrow-button" type="button" data-name="@provider.Name">View profile</button></div>
                                    </article>
                                }
                                @* Retired sample directory; search displays database profiles only.

                                <!-- OFRACIO -->

                                <article class="freelancer-card"
