                                *@
                            </div>


                            <!-- NO RESULTS -->

                            <div class="no-results"
                                 id="noResults" data-unavailable="@Model.DirectoryUnavailable.ToString().ToLowerInvariant()">

                                No freelancers found.

                            </div>

                            <section id="providerDetailPanel" class="provider-detail-panel hidden" aria-live="polite">
                                <div class="provider-detail-heading"><div><span>Selected provider</span><h2 id="selectedProviderName">Provider</h2><p id="selectedProviderMeta">Choose a provider to see details.</p></div><button id="closeProviderDetail" type="button" aria-label="Close provider details">×</button></div>
                                <div class="provider-detail-stats"><span id="selectedProviderRating">★ —</span><span id="selectedProviderPrice">Price —</span><span id="selectedProviderAvailability" class="available-now">Availability —</span></div>
                                @if (Model.DemoMode) { <p class="provider-detail-help">Demo profile for search and matching only. Booking requests are disabled.</p> }
                                else if (Model.WorkRole is "client" or "both") {
                                <p class="provider-detail-help">Request work directly from this freelancer. Your request is private and will appear in their My Jobs → Booking requests.</p>
                                <form method="post" asp-page="/BookingRequests" asp-page-handler="Direct" class="direct-booking-form">
                                    <input type="hidden" name="freelancerId" id="bookingFreelancerId" />
                                    <label for="bookingTitle">What do you need help with?</label><input id="bookingTitle" name="title" maxlength="120" required placeholder="e.g. Clean a two-bedroom home" />
                                    <label for="bookingDescription">Work details</label><textarea id="bookingDescription" name="description" maxlength="5000" rows="3" required placeholder="Describe the work, scope, and any special requirements"></textarea>
                                    <label for="bookingLocation">Work location</label><input id="bookingLocation" name="location" maxlength="120" required placeholder="City and work location" />
                                    <label for="bookingSchedule">Preferred date and time (Philippine time)</label>
                                    <input id="bookingSchedule" name="schedule" type="datetime-local" step="60" min="@DateTime.UtcNow.AddHours(8).ToString("yyyy-MM-ddTHH:mm")" required aria-describedby="bookingScheduleHelp" />
                                    <small id="bookingScheduleHelp">Choose a date from the calendar and select a time. Schedule uses Philippine time (UTC+8).</small>
                                    <label for="bookingBudget">Proposed budget (₱)</label><input id="bookingBudget" name="budget" type="number" min="1" max="9999999999" step="0.01" required />
                                    <p>The displayed rate is a guide. The freelancer can accept or decline your proposed work and budget.</p>
                                    <p id="bookingPrivacyNotice">Private booking: only your selected freelancer will receive this request. It will not appear in Find Jobs.</p>
                                    <button id="sendBookingRequestButton" type="submit" class="send-booking-request" disabled>Send booking request</button>
                                </form>
                                } else { <p class="provider-detail-help">To book a freelancer, choose Client or Client &amp; Freelancer as your work role in <a href="/Settings">Settings</a>.</p> }
                            </section>


                        </section>


                    </div>


                </section>



                <!-- ================================================= -->
                <!-- POST TASK -->
                <!-- ================================================= -->

                <section id="postTaskSection"
                         class="empty-mode-section @(mode != "post" ? "hidden" : "")">

                    <div class="mode-placeholder hidden" id="postTaskStart">
                        <div class="placeholder-icon">+</div>
                        <h2>Post a Task</h2>
                        <p>Create a task and let trusted freelancers find you.</p>
                        <button type="button" id="startPostTaskButton">Create a task</button>
                    </div>

                    <form data-demo-post="@(Model.DemoMode ? "true" : "false")" class="post-task-panel" id="databasePostTaskForm" method="post" asp-page="/MarketTasks" asp-page-handler="Create">
                        <input type="hidden" name="schedule" id="databaseSchedule" />
                        <div class="post-task-heading">
                            <div>
                                <h2>Post a Task</h2>
                                <p>Tell trusted local freelancers exactly what you need.</p>
                            </div>
                            <span class="post-step">Task details</span>
                        </div>

                        <label class="post-field">
                            <span>Task title</span>
                            <input id="taskTitleInput" name="title" type="text" maxlength="100" required placeholder="e.g. Fix a leaking kitchen faucet" />
                        </label>

                        <fieldset class="post-category-field">
                            <legend>Category</legend>
                            <div class="post-categories">
                                <label><input type="radio" name="category" value="Cleaning" required /><span>Cleaning</span></label>
                                <label><input type="radio" name="category" value="Repairs" /><span>Repairs</span></label>
                                <label><input type="radio" name="category" value="Errands" /><span>Errands</span></label>
                                <label><input type="radio" name="category" value="Moving" /><span>Moving</span></label>
                                <label><input type="radio" name="category" value="Gardening" /><span>Gardening</span></label>
                                <label><input type="radio" name="category" value="Painting" /><span>Painting</span></label>
                                <label><input type="radio" name="category" value="Tutoring" /><span>Tutoring</span></label>
                                <label><input type="radio" name="category" value="Pet Care" /><span>Pet Care</span></label>
                                <label><input type="radio" name="category" value="Other / General" /><span>Other / General</span></label>
                            </div>
                        </fieldset>

                        <label class="post-field">
                            <span>Description</span>
                            <textarea id="taskDescriptionInput" name="description" maxlength="500" required placeholder="Describe the task, including important details or materials needed."></textarea>
                        </label>

                        <div class="post-field-grid">
                            <label class="post-field">
                                <span>Location</span>
                                <input id="taskLocationInput" name="location" type="text" maxlength="120" required placeholder="e.g. Metro Manila" />
                            </label>
                            <label class="post-field">
                                <span>Budget</span>
                                <input id="taskBudgetInput" name="budget" type="number" min="1" max="9999999999" step="0.01" required placeholder="e.g. 600" />
                            </label>
                        </div>

                        <label class="post-field">
                            <span>Preferred date and time <em>Optional</em></span>
                            <div class="quick-schedule-picker" aria-label="Preferred date and time">
                                <label class="quick-schedule-field"><span>Preferred date</span><input id="preferredDateInput" type="date" /></label>
                                <label class="quick-schedule-field"><span>Preferred time</span><input id="preferredTimeInput" type="time" /></label>
                                <div class="quick-schedule-actions" aria-label="Quick date options">
                                    <button type="button" id="scheduleTodayButton">Today</button>
                                    <button type="button" id="scheduleTomorrowButton">Tomorrow</button>
                                    <button type="button" id="scheduleChooseDateButton">Choose date</button>
                                    <button type="button" id="scheduleClearButton" class="schedule-clear-button">Clear schedule</button>
                                </div>
                            </div>
                            <small class="schedule-help">You can change this anytime before a freelancer accepts, or leave it empty to schedule later.</small>
                        </label>

                        <div class="post-form-actions">
                            <button class="post-cancel-button" type="button" id="cancelPostTaskButton">Cancel</button>
                            <button class="post-submit-button" type="submit">Post task</button>
                        </div>
                    </form>

                    <section class="post-task-success hidden" id="postTaskSuccess" aria-live="polite">
                        <div class="success-heading">
                            <div class="success-check">✓</div>
                            <div>
                                <span class="success-eyebrow">YOUR TASK IS LIVE</span>
                                <h2>Task posted successfully</h2>
                                <p>Trusted freelancers can now view and send an offer for your task.</p>
                            </div>
                        </div>
                        <div class="posted-task-summary">
                            <div class="posted-summary-row"><span>Task</span><strong id="postedTaskTitle">—</strong></div>
                            <div class="posted-summary-row"><span>Budget</span><strong id="postedTaskBudget">—</strong></div>
                            <div class="posted-summary-row"><span>Category</span><strong id="postedTaskCategory">—</strong></div>
                            <div class="posted-summary-row"><span>Location</span><strong id="postedTaskLocation">—</strong></div>
                            <div class="posted-summary-row posted-schedule"><span>Preferred schedule</span><strong id="postedTaskSchedule">To be scheduled</strong></div>
                        </div>
                        <div class="success-next-steps" aria-label="What happens next">
                            <span class="next-step active"><b>1</b><i>Task is open</i></span>
                            <span class="next-line"></span>
                            <span class="next-step"><b>2</b><i>Receive offers</i></span>
                            <span class="next-line"></span>
                            <span class="next-step"><b>3</b><i>Choose a provider</i></span>
                        </div>
                        <div class="success-actions">
                            <button class="view-tasks-button" type="button" id="viewPostedTaskButton">View my tasks</button>
                            <button class="post-another-button" type="button" id="postAnotherTaskButton">Post another task</button>
                        </div>
                    </section>


                </section>



                <!-- ================================================= -->
                <!-- FIND JOBS -->
                <!-- ================================================= -->

                <section id="findJobsSection"
                         class="empty-mode-section @(mode != "jobs" ? "hidden" : "")">

                    @if (!string.IsNullOrEmpty(Model.Notice)) { <p role="status">@Model.Notice</p> }
                    <div class="jobs-workspace">
                        <div class="jobs-heading"><div><span class="jobs-eyebrow">FREELANCER OPPORTUNITIES</span><h2>Find your next job</h2><p>Explore tasks posted by clients and send an offer that works for you.</p></div><span class="jobs-count">@Model.OpenTasks.Count open @(Model.OpenTasks.Count == 1 ? "task" : "tasks")</span></div>
                        @if (Model.DirectoryUnavailable) { <div class="jobs-empty"><h3>Jobs are unavailable right now</h3><p>Please try again later.</p></div> }
                        else if (Model.WorkRole is not ("freelancer" or "both")) { <div class="jobs-empty"><h3>Ready to find work?</h3><p>Set your work role to Freelancer or Client &amp; Freelancer to find jobs and send offers.</p><a href="/Settings">Open settings</a></div> }
                        else if (Model.OpenTasks.Count == 0) { <div class="jobs-empty"><span class="jobs-empty-icon" aria-hidden="true">⌕</span><h3>No open jobs yet</h3><p>When another client confirms a task, it will appear here. Check back later for new opportunities.</p></div> }
                        @foreach (var item in Model.OpenTasks) {
                            var task = item.Task;
                            var existing = Model.Offers.FirstOrDefault(o => o.Offer.TaskId == task.Id);
                            <article class="jobs-card"><div class="jobs-card-top"><span class="jobs-tag">@task.Category</span><strong>₱@task.Budget</strong></div><h3>@task.Title</h3><p>@task.Description</p><div class="jobs-meta"><span>⌖ @task.Location</span><span>◷ @(string.IsNullOrWhiteSpace(task.ScheduleText) ? "Schedule to be arranged" : task.ScheduleText)</span><span>Client: @item.ClientName</span></div>
                            @if (Model.DemoMode) { <p class="jobs-offer-status">Demo task · Offers disabled</p> }
                            else if (existing != null) { <p class="jobs-offer-status">Offer sent · @existing.Offer.Status</p> }
                            else { <details class="jobs-offer"><summary>Send an offer</summary><form method="post" asp-page="/MarketTasks" asp-page-handler="Offer"><input type="hidden" name="id" value="@task.Id" /><label class="post-field">Your price (₱)<input type="number" name="price" min="1" max="9999999999" step="0.01" required /></label><label class="post-field">Message (optional)<textarea name="message" maxlength="500"></textarea></label><button class="post-submit-button">Send offer</button></form></details> }</article>
                        }
                        <section class="jobs-offers"><h3>My offers</h3>
                        @if (Model.Offers.Count == 0) { <p>Your sent offers will appear here so you can check their status.</p> }
                        @foreach (var sent in Model.Offers) { <div class="sent-offer"><div><strong>@(Model.OfferTaskTitles.TryGetValue(sent.Offer.TaskId, out var offerTitle) ? offerTitle : "Task details unavailable")</strong><span>Offer: ₱@sent.Offer.Price</span></div><span class="sent-offer-status">@sent.Offer.Status.Replace("-", " ")</span></div> }</section>
                    </div>


                </section>


            </div>


        </main>


    </div>



    <!-- ================================================= -->
    <!-- SIMPLE MESSAGE POPUP -->
    <!-- ================================================= -->

    <div class="message-overlay hidden"
         id="messageOverlay">

        <div class="message-popup">

            <button class="popup-close"
                    id="popupClose"
                    type="button">

                ×

            </button>

            <div class="popup-icon">
                ✓
            </div>

            <h3 id="popupTitle">
                Done
            </h3>

            <p id="popupMessage">
                Action completed.
            </p>

            <button class="popup-button"
                    id="popupOkay"
                    type="button">

                Okay

            </button>

        </div>

    </div>



    <script src="~/js/findpost.js" asp-append-version="true"></script>

</body>

</html>
