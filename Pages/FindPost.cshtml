@page
@model FindPostModel

@{
    Layout = null;

    var mode = Request.Query["mode"].ToString();

    if (string.IsNullOrEmpty(mode))
    {
        mode = "freelancer";
    }
    if (mode == "jobs" && Model.WorkRole == "client") { mode = "freelancer"; }
    if (mode == "post" && Model.WorkRole == "freelancer") { mode = "jobs"; }
}

<!DOCTYPE html>
<html lang="en">

<head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" />

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Find & Post - Tap, Task, Done</title>

    <link rel="stylesheet"
          href="/css/findpost.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/readability.css" asp-append-version="true" />
    <script defer src="/js/sidebar-account.js" asp-append-version="true"></script>
    <script defer src="/js/profile-photo.js" asp-append-version="true"></script>

<link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/findpost-light.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/sidebar-consistency.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/workspace-spacing.css" asp-append-version="true" />
<link rel="stylesheet" href="/lib/maplibre-gl/maplibre-gl.css" asp-append-version="true" /><link rel="stylesheet" href="/css/task-location-picker.css" asp-append-version="true" /><script defer src="/lib/maplibre-gl/maplibre-gl.js" asp-append-version="true"></script><script defer src="/js/task-location-picker.js" asp-append-version="true"></script><link rel="stylesheet" href="/css/post-task-polish.css" asp-append-version="true" /><partial name="_AccountTheme" /></head>

<body>

    <div class="app-shell">


        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <aside class="sidebar">


            <!-- LOGO -->

            <div class="sidebar-logo">

                <div class="logo-check">
                    ✓
                </div>

                <span>
                    Tap, Task, Done
                </span>

            </div>


            <!-- NAVIGATION -->

            <nav class="sidebar-navigation">

                <a href="/Dashboard"
                   class="sidebar-item">

                    <span class="sidebar-icon">
                        ⌂
                    </span>

                    <span>
                        Home
                    </span>

                </a>


                <a href="/FindPost"
                   class="sidebar-item active">

                    <span class="sidebar-icon">
                        ⌕
                    </span>

                    <span>
                        Find &amp; Post
                    </span>

                </a>


                <a href="/MyTasks"
                   class="sidebar-item">

                    <span class="sidebar-icon">
                          ▤
                    </span>

                    <span>
                        My Tasks
                    </span>

                </a>


                <!-- MESSAGES - CONNECTED -->

                <a href="/Messages"
                   class="sidebar-item">

                    <span class="sidebar-icon">
                        □
                    </span>

                    <span>
                        Messages
                    </span>

                </a>


                <a href="/IdentityVerification"
                   class="sidebar-item">

                    <span class="sidebar-icon">
                        ✓
                    </span>

                    <span>
                        Identity Verification
                    </span>

                </a>


                <!-- TRACKING - CONNECTED -->

                <a href="/Tracking"
                   class="sidebar-item">

                    <span class="sidebar-icon">
                          ➤
                    </span>

                    <span>
                        Tracking
                    </span>

                </a>


                <!-- REVIEWS - CONNECTED -->

                <a href="/Reviews"
                   class="sidebar-item">

                    <span class="sidebar-icon">
                        ☆
                    </span>

                    <span>
                        Reviews
                    </span>

                </a>

            </nav>


            <!-- USER -->

            <div class="sidebar-user">


                <div class="user-avatar"
                     id="userAvatar">

                    JD

                </div>


                <div class="user-details">

                    <strong id="sidebarName">
                        Jordan Dela Cruz
                    </strong>

                    <span id="sidebarEmail">
                        jordan@gmail.com
                    </span>

                </div>


                <button class="user-more"
                        id="userMoreButton"
                        type="button">

                    ⋮

                </button>


            </div>


        </aside>



        <!-- ================================================= -->
        <!-- MAIN AREA -->
        <!-- ================================================= -->

        <main class="main-area">



            <!-- TOP BAR -->

            <header class="topbar">


                <h1>
                    Find &amp; Post
                </h1>


                <button class="notification-button"
                        id="notificationButton"
                        type="button">

                    ♧

                </button>


            </header>



            <!-- ================================================= -->
            <!-- PAGE CONTENT -->
            <!-- ================================================= -->

            <div class="page-content">


                <!-- ================================================= -->
                <!-- MODE SWITCHER -->
                <!-- ================================================= -->

                <div class="mode-switcher">


                    <button class="mode-button @(mode == "freelancer" ? "active" : "")"
                            id="findFreelancerButton"
                            type="button">

                        Find a Freelancer

                    </button>


                    <button class="mode-button @(mode == "post" ? "active" : "")"
                            id="postTaskButton"
                            hidden="@(Model.WorkRole == "freelancer")"
                            type="button">

                        Post a Task

                    </button>


                    <button class="mode-button @(mode == "jobs" ? "active" : "")"
                            id="findJobsButton"
                            hidden="@(Model.WorkRole == "client")"
                            type="button">

                        Find Jobs

                    </button>


                </div>




                <!-- ================================================= -->
                <!-- FIND FREELANCER AREA -->
                <!-- ================================================= -->

                <section id="findFreelancerSection"
                         class="find-layout @(mode != "freelancer" ? "hidden" : "")">


                    <!-- FILTER PANEL -->

                    <aside class="filter-panel">

                        <div id="otherCategoryNotice" hidden><strong>Others: unique skills</strong><p>Available services that do not match the listed categories. Search by a specific skill, or <a href="/FindPost">browse all services</a>.</p></div>

                        <div class="filter-group">

                            <label for="serviceSearch">
                                Service
                            </label>

                            <div class="input-wrapper">

                                <span>
                                    ⌕
                                </span>

                                <select id="serviceSearch" aria-label="Service category"><option value="">All services</option>@foreach (var category in new[] { "Cleaning", "Repairs", "Errands", "Moving", "Gardening", "Painting", "Tutoring", "Pet Care", "Other/General" }) { <option value="@category">@category</option> }</select>

                            </div>

                        </div>



                        <div class="filter-group">

                            <label for="locationInput">
                                Location
                            </label>

                            <div class="input-wrapper">

                                <span>
                                    ♧
                                </span>

                                <select id="locationInput" aria-label="Service area" style="width:100%;min-width:0">
                                    <option value="">All 5 supported areas</option>
                                    @foreach (var area in tts.Pages.BacolorServiceAreas.Names)
                                    {
                                        <option value="@area">@area</option>
                                    }
                                </select>

                            </div>

                        </div>



                        <div class="filter-group" hidden>

                            <label for="budgetInput">
                                Budget
                            </label>

                            <div class="input-wrapper">

                                <span>
                                    ₱
                                </span>

                                <input type="text"
                                       id="budgetInput"
                                       placeholder="Maximum budget, e.g. 1500" inputmode="decimal" />

                            </div>

                        </div>



                        <div class="filter-group"><label for="availabilityFilter">Availability</label><div class="input-wrapper"><select id="availabilityFilter" style="width:100%;height:100%;padding:0 12px;border:0;background:transparent;color:inherit;font:inherit"><option value="">Any availability</option><option value="Available">Available</option><option value="Busy">Busy</option><option value="Working">Working</option><option value="Day off">Day off</option></select></div></div>
                        <button class="search-button"
                                id="searchButton"
                                type="button">

                            <span>
                                ⌕
                            </span>

                            Search

                        </button>


                    </aside>



                    <!-- RESULTS AREA -->

                    <div class="results-area">


                        <section class="provider-search-intro">
                            @if (User.Identity?.IsAuthenticated == true && !Model.IdentityApproved) { <partial name="_IdentityWorkNotice" /> }
                            <span>Find a trusted provider</span>
                            <h2>Compare freelancers before you send a request.</h2>
                            <p>Search profiles by service, location, budget, and availability.</p>
                            @if (!string.IsNullOrEmpty(Model.Notice) && mode != "jobs") { <p role="status">@Model.Notice</p> }
                        </section>



                        <!-- AVAILABLE FREELANCERS -->

                        <section class="freelancers-section">


                            <div class="section-heading">

                                <h2>
                                    Freelancers
                                </h2>

                            </div>



                            <div class="freelancer-list"
                                 id="freelancerList">
                                @foreach (var provider in Model.Providers)
                                {
                                    <article class="freelancer-card" data-id="@provider.Id" data-service="@provider.Service" data-location="@provider.Location" data-service-areas="@string.Join("|", tts.Pages.BacolorServiceAreas.InLocation(provider.Location))" data-rate="@provider.Rate" data-rate-maximum="@(provider.RateMaximum ?? provider.Rate)" data-availability="@provider.Availability" data-saved-availability="@provider.SavedAvailability">
                                        <div class="freelancer-left"><div class="freelancer-avatar" style="position:relative;overflow:hidden"><img src="@Url.Page("/ProfilePhoto", new { providerId = provider.Id })" alt="" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" onerror="this.hidden=true" />@(provider.Name.Length > 0 ? provider.Name.Substring(0, 1).ToUpperInvariant() : "F")</div><div class="freelancer-info"><strong>@provider.Name</strong><span>@provider.Service</span><span class="provider-availability">@provider.Availability</span></div></div>
                                        <div class="freelancer-right"><div class="freelancer-rating"><strong>@(Model.RatingsUnavailable ? "Ratings unavailable" : Model.Ratings.TryGetValue(provider.Id, out var rating) ? $"★ {rating.Average:0.0} ({rating.Count})" : "No ratings yet")</strong></div><div class="freelancer-price">@(provider.Rate.HasValue ? $"₱{provider.Rate:N0} – ₱{(provider.RateMaximum ?? provider.Rate):N0}" : "Rate not set")</div><button class="arrow-button" type="button" data-name="@provider.Name">View profile</button></div>
                                    </article>
                                }

                            </div>


                            <!-- NO RESULTS -->

                            <div class="no-results"
                                 id="noResults" data-unavailable="@Model.DirectoryUnavailable.ToString().ToLowerInvariant()">

                                No freelancers found.

                            </div>

                            <section id="providerDetailPanel" class="provider-detail-panel hidden" aria-live="polite">
                                <div class="provider-detail-heading"><div><span>Selected provider</span><h2 id="selectedProviderName">Provider</h2><p id="selectedProviderMeta">Choose a provider to see details.</p></div><button id="closeProviderDetail" type="button" aria-label="Close provider details">×</button></div>
                                <div class="provider-detail-stats"><span id="selectedProviderRating">★ —</span><span id="selectedProviderPrice">Price —</span><span id="selectedProviderAvailability" class="available-now">Availability —</span></div>
                                @if (tts.Pages.BookingRequestsModel.CanBook(Model.WorkRole)) {
                                <p class="provider-detail-help">Request work directly from this freelancer. Your request is private and will appear in their My Jobs → Booking requests.</p>
                                <form method="post" asp-page="/BookingRequests" asp-page-handler="Direct" class="direct-booking-form">
                                    <input type="hidden" name="freelancerId" id="bookingFreelancerId" />
                                    <div class="booking-fields">
                                    <label for="bookingTitle">What do you need help with?</label><input id="bookingTitle" name="title" maxlength="120" required placeholder="e.g. Clean a two-bedroom home" />
                                    <label for="bookingDescription">Work details</label><textarea id="bookingDescription" name="description" maxlength="5000" rows="3" required placeholder="Describe the work, scope, and any special requirements"></textarea>
                                    <label for="bookingSchedule">Preferred date and time (Philippine time)</label>
                                    <input id="bookingSchedule" name="schedule" type="datetime-local" step="60" min="@DateTime.UtcNow.AddHours(8).ToString("yyyy-MM-ddTHH:mm")" required aria-describedby="bookingScheduleHelp" />
                                    <small id="bookingScheduleHelp">Choose a date from the calendar and select a time. Schedule uses Philippine time (UTC+8).</small>
                                    <label for="bookingBudget">Minimum proposed budget (₱)</label><input id="bookingBudget" name="budget" type="number" min="1" max="9999999999" step="0.01" required />
                                    <label for="bookingBudgetMaximum">Maximum proposed budget (₱)</label><input id="bookingBudgetMaximum" name="budgetMaximum" type="number" min="1" max="9999999999" step="0.01" required />
                                    <p>The freelancer’s rate is a guide. Discuss and confirm the final price together before travel.</p>
                                    </div>
                                    <div class="booking-location">
                                        <partial name="_TaskLocationPicker" model="new tts.Data.TaskLocationInput()" />
                                    </div>
                                    <div class="booking-footer">
                                    <p id="bookingPrivacyNotice">Private booking: only your selected freelancer will receive this request. It will not appear in Find Jobs.</p>
                                    <button id="sendBookingRequestButton" type="submit" class="send-booking-request" disabled>Send booking request</button>
                                    </div>
                                </form>
                                } else { <p class="provider-detail-help">To book a freelancer, choose Client or Client &amp; Freelancer as your work role in <a href="/Settings">Settings</a>.</p> }
                            </section>


                        </section>


                    </div>


                </section>



                <!-- ================================================= -->
                <!-- POST TASK -->
                <!-- ================================================= -->

                <section id="postTaskSection"
                         class="empty-mode-section @(mode != "post" ? "hidden" : "")">

                    <div class="mode-placeholder hidden" id="postTaskStart">
                        <div class="placeholder-icon">+</div>
                        <h2>Post a Task</h2>
                        <p>Create a task and let trusted freelancers find you.</p>
                        <button type="button" id="startPostTaskButton">Create a task</button>
                    </div>

                    <form class="post-task-panel" id="databasePostTaskForm" method="post" asp-page="/MarketTasks" asp-page-handler="Create">
                        <input type="hidden" name="schedule" id="databaseSchedule" />
                        <div class="post-task-heading">
                            <div>
                                <h2>Post a Task</h2>
                                <p>Find trusted help in Bacolor, Pampanga.</p>
                            </div>
                            <span class="post-step">Task details</span>
                        </div>
                        @if (User.Identity?.IsAuthenticated == true && !Model.IdentityApproved) { <partial name="_IdentityWorkNotice" /> }

                        <label class="post-field">
                            <span>Task title</span>
                            <input id="taskTitleInput" name="title" type="text" maxlength="100" required placeholder="e.g. Fix a leaking kitchen faucet" />
                        </label>

                        <fieldset class="post-category-field">
                            <legend>Category</legend>
                            <div class="post-categories">
                                <label><input type="radio" name="category" value="Cleaning" required /><span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m14 3 3 3-7 8-3-3zM7 11l-4 7c3 3 6 3 9 0l-2-4"/></svg><span>Cleaning</span><i aria-hidden="true">✓</i></span></label>
                                <label><input type="radio" name="category" value="Repairs" /><span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 6a5 5 0 0 0-6 6L3 17a3 3 0 0 0 4 4l5-5a5 5 0 0 0 6-6l-4 3-3-3z"/></svg><span>Repairs</span><i aria-hidden="true">✓</i></span></label>
                                <label><input type="radio" name="category" value="Errands" /><span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h3l3 12h10l2-8H7M10 20h1M18 20h1"/></svg><span>Errands</span><i aria-hidden="true">✓</i></span></label>
                                <label><input type="radio" name="category" value="Moving" /><span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 5h12v12H2zM14 10h4l4 4v3h-8"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg><span>Moving</span><i aria-hidden="true">✓</i></span></label>
                                <label><input type="radio" name="category" value="Gardening" /><span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 3C8 3 3 8 5 15c5 5 14 1 15-12ZM3 21 15 9"/></svg><span>Gardening</span><i aria-hidden="true">✓</i></span></label>
                                <label><input type="radio" name="category" value="Painting" /><span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 3h13v6H4zM17 5h4v8H11v3M9 16h4v6H9z"/></svg><span>Painting</span><i aria-hidden="true">✓</i></span></label>
                                <label><input type="radio" name="category" value="Tutoring" /><span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5C8 2 4 3 2 4v16c4-2 7-1 10 1 3-2 6-3 10-1V4c-4-2-7-1-10 1Zm0 0v16"/></svg><span>Tutoring</span><i aria-hidden="true">✓</i></span></label>
                                <label><input type="radio" name="category" value="Pet Care" /><span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="16" rx="6" ry="5"/><circle cx="4" cy="9" r="2"/><circle cx="9" cy="5" r="2"/><circle cx="16" cy="5" r="2"/><circle cx="21" cy="10" r="2"/></svg><span>Pet Care</span><i aria-hidden="true">✓</i></span></label>
                                <label><input type="radio" name="category" value="Other / General" /><span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8 12h8M12 8v8"/></svg><span>Other / General</span><i aria-hidden="true">✓</i></span></label>
                            </div>
                        </fieldset>

                        <label class="post-field">
                            <span>Description</span>
                            <textarea id="taskDescriptionInput" name="description" maxlength="500" required placeholder="Describe the task, including important details or materials needed."></textarea>
                        </label>

                        <div class="post-work-details">
                            <label class="post-field">
                                <span>Minimum budget (₱)</span>
                                <span class="post-budget-control"><span aria-hidden="true">₱</span><input id="taskBudgetInput" name="budget" type="number" min="1" max="9999999999" step="0.01" required placeholder="e.g. 600" /></span><small>Your proposed minimum budget.</small>
                            </label>
                            <label class="post-field"><span>Maximum budget (₱)</span><span class="post-budget-control"><span aria-hidden="true">₱</span><input name="budgetMaximum" type="number" min="1" max="9999999999" step="0.01" required placeholder="e.g. 1000" /></span><small>Must be at least the minimum budget.</small></label>
                            <label class="post-field post-duration"><span>Post closing date</span><input type="date" name="postEndDate" min="@MarketTasksModel.TodayInPhilippines.ToString("yyyy-MM-dd")" max="9999-12-30" required /><small>After publishing, your post stays open through this date (Philippine time).</small></label>
                            <partial name="_TaskLocationPicker" model="new tts.Data.TaskLocationInput()" />
                        </div>

                        <label class="post-field">
                            <span>Preferred date and time <em>Optional</em></span>
                            <div class="quick-schedule-picker" aria-label="Preferred date and time">
                                <label class="quick-schedule-field"><span>Preferred date</span><input id="preferredDateInput" type="date" /></label>
                                <label class="quick-schedule-field"><span>Preferred time</span><input id="preferredTimeInput" type="time" /></label>
                                <div class="quick-schedule-actions" aria-label="Quick date options">
                                    <button type="button" id="scheduleTodayButton">Today</button>
                                    <button type="button" id="scheduleTomorrowButton">Tomorrow</button>
                                    <button type="button" id="scheduleChooseDateButton">Choose date</button>
                                    <button type="button" id="scheduleClearButton" class="schedule-clear-button">Clear schedule</button>
                                </div>
                            </div>
                            <small class="schedule-help">You can change this anytime before a freelancer accepts, or leave it empty to schedule later.</small>
                        </label>

                        <div class="post-form-actions"><small>You can edit your task before publishing.</small>
                            <button class="post-cancel-button" type="button" id="cancelPostTaskButton">Cancel</button>
                            <button class="post-submit-button" type="submit">Review task</button>
                        </div>
                    </form>

                    <section class="post-task-success hidden" id="postTaskSuccess" aria-live="polite">
                        <div class="success-heading">
                            <div class="success-check">✓</div>
                            <div>
                                <span class="success-eyebrow">YOUR TASK IS LIVE</span>
                                <h2>Task posted successfully</h2>
                                <p>Trusted freelancers can now view and make an offer for your task.</p>
                            </div>
                        </div>
                        <div class="posted-task-summary">
                            <div class="posted-summary-row"><span>Task</span><strong id="postedTaskTitle">—</strong></div>
                            <div class="posted-summary-row"><span>Budget</span><strong id="postedTaskBudget">—</strong></div>
                            <div class="posted-summary-row"><span>Category</span><strong id="postedTaskCategory">—</strong></div>
                            <div class="posted-summary-row"><span>Location</span><strong id="postedTaskLocation">—</strong></div>
                            <div class="posted-summary-row posted-schedule"><span>Preferred schedule</span><strong id="postedTaskSchedule">To be scheduled</strong></div>
                        </div>
                        <div class="success-next-steps" aria-label="What happens next">
                            <span class="next-step active"><b>1</b><i>Task is open</i></span>
                            <span class="next-line"></span>
                            <span class="next-step"><b>2</b><i>Receive offers</i></span>
                            <span class="next-line"></span>
                            <span class="next-step"><b>3</b><i>Choose a provider</i></span>
                        </div>
                        <div class="success-actions">
                            <button class="view-tasks-button" type="button" id="viewPostedTaskButton">View my tasks</button>
                            <button class="post-another-button" type="button" id="postAnotherTaskButton">Post another task</button>
                        </div>
                    </section>


                </section>



                <!-- ================================================= -->
                <!-- FIND JOBS -->
                <!-- ================================================= -->

                <section id="findJobsSection"
                         class="empty-mode-section @(mode != "jobs" ? "hidden" : "")">

                    @if (!string.IsNullOrEmpty(Model.Notice)) { <p role="status">@Model.Notice</p> }
                    <div class="jobs-workspace">
                        <div class="jobs-heading"><div><span class="jobs-eyebrow">FREELANCER OPPORTUNITIES</span><h2>Find your next job</h2><p>Explore tasks posted by clients and make an offer that works for you.</p></div><span class="jobs-count" id="jobsFilterCount">@Model.OpenTasks.Count open @(Model.OpenTasks.Count == 1 ? "task" : "tasks")</span></div>
                        @if (User.Identity?.IsAuthenticated == true && !Model.IdentityApproved) { <partial name="_IdentityWorkNotice" /> }
                        @if (!Model.DirectoryUnavailable && (Model.WorkRole is "freelancer" or "both")) {
                            <div class="jobs-category-filter"><label for="jobsCategoryFilter">Filter by service / profession</label><select id="jobsCategoryFilter"><option value="">All categories</option>@foreach (var category in new[] { "Cleaning", "Repairs", "Errands", "Moving", "Gardening", "Painting", "Tutoring", "Pet Care", "Other / General" }) { <option value="@category">@category</option> }</select></div>
                        }
                        @if (Model.DirectoryUnavailable) { <div class="jobs-empty"><h3>Jobs are unavailable right now</h3><p>Please try again later.</p></div> }
                        else if (Model.WorkRole is not ("freelancer" or "both")) { <div class="jobs-empty"><h3>Ready to find work?</h3><p>Set your work role to Freelancer or Client &amp; Freelancer to find jobs and send offers.</p><a href="/Settings">Open settings</a></div> }
                        else if (Model.OpenTasks.Count == 0) { <div class="jobs-empty"><span class="jobs-empty-icon" aria-hidden="true">⌕</span><h3>No open jobs yet</h3><p>When another client confirms a task, it will appear here. Check back later for new opportunities.</p></div> }
                        @foreach (var item in Model.OpenTasks) {
                            var task = item.Task;
                            var existing = Model.Offers.FirstOrDefault(o => o.Offer.TaskId == task.Id);
                            <article class="jobs-card" data-job-category="@task.Category"><div class="jobs-card-top"><span class="jobs-tag">@task.Category</span><strong>@task.BudgetDisplay</strong></div><h3>@task.Title</h3><p>@task.Description</p><form method="post" asp-page="/Messages" asp-page-handler="Start"><input type="hidden" name="taskId" value="@task.Id" /><button type="submit" class="task-chat-action"><svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8.5 8.5 0 0 1-12.3 7.6L3 21l1.9-5.7A8.5 8.5 0 1 1 21 11.5Z"/></svg>Ask about this task</button></form><div class="jobs-meta"><span>⌖ @tts.Data.TaskLocationRules.PublicArea</span><span>◷ @(string.IsNullOrWhiteSpace(task.ScheduleText) ? "Schedule to be arranged" : task.ScheduleText)</span><span>Client: <span data-account-id="@task.ClientId">@item.ClientName</span></span></div>
                            @if (existing != null) { <p class="jobs-offer-status">Offer sent · @existing.Offer.Status</p> }
                            else { <details class="jobs-offer"><summary>Make an offer</summary><form method="post" asp-page="/MarketTasks" asp-page-handler="Offer"><input type="hidden" name="id" value="@task.Id" /><label class="post-field">Your price (₱)<input type="number" name="price" min="1" max="9999999999" step="0.01" required /></label><label class="post-field">Message (optional)<textarea name="message" maxlength="500"></textarea></label><button class="post-submit-button">Make an offer</button></form></details> }</article>
                        }
                        <div id="jobsFilterEmpty" class="jobs-empty" hidden role="status"><h3>No jobs in this category yet</h3><p>Choose another category or view all jobs.</p><button type="button" id="jobsFilterReset" class="task-chat-action">View all jobs</button></div>
                        <section class="jobs-offers"><h3>My offers</h3>
                        @if (Model.Offers.Count == 0) { <p>Your sent offers will appear here so you can check their status.</p> }
                        @foreach (var sent in Model.Offers) { <div class="sent-offer"><div><strong>@(Model.OfferTaskTitles.TryGetValue(sent.Offer.TaskId, out var offerTitle) ? offerTitle : "Task details unavailable")</strong><span>Offer: ₱@sent.Offer.Price</span></div><span class="sent-offer-status">@sent.Offer.Status.Replace("-", " ")</span></div> }</section>
                    </div>


                </section>


            </div>


        </main>


    </div>



    <!-- ================================================= -->
    <!-- SIMPLE MESSAGE POPUP -->
    <!-- ================================================= -->

    <div class="message-overlay hidden"
         id="messageOverlay">

        <div class="message-popup">

            <button class="popup-close"
                    id="popupClose"
                    type="button">

                ×

            </button>

            <div class="popup-icon">
                ✓
            </div>

            <h3 id="popupTitle">
                Done
            </h3>

            <p id="popupMessage">
                Action completed.
            </p>

            <button class="popup-button"
                    id="popupOkay"
                    type="button">

                Okay

            </button>

        </div>

    </div>



    <script src="~/js/findpost.js" asp-append-version="true"></script>

</body>

</html>
