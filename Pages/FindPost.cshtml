                                <!-- DANTE -->

                                <article class="freelancer-card"
                                         data-service="electrician electrical repair" data-location="Metro Manila" data-rate="750" data-availability="Available" data-demo="true">

                                    <div class="freelancer-left">


                                        <div class="freelancer-avatar">
                                            Da
                                        </div>


                                        <div class="freelancer-info">

                                            <strong>
                                                Dante
                                            </strong>

                                            <span>
                                                Electrician
                                            </span>

                                        </div>


                                    </div>



                                    <div class="freelancer-right">


                                        <div class="freelancer-rating">

                                            <span class="star">
                                                ★
                                            </span>

                                            <strong>
                                                4.7
                                            </strong>

                                            <small>
                                                (288)
                                            </small>

                                        </div>


                                        <div class="freelancer-jobs">
                                            132 jobs
