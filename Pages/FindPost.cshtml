                                </article>



                                <!-- LEA -->

                                <article class="freelancer-card"
                                         data-service="errand runner errands delivery" data-location="Metro Manila" data-rate="300" data-availability="Available" data-demo="true">

                                    <div class="freelancer-left">


                                        <div class="freelancer-avatar">
                                            Le
                                        </div>


                                        <div class="freelancer-info">

                                            <strong>
                                                Lea
                                            </strong>

                                            <span>
                                                Errand Runner
                                            </span>

                                        </div>


                                    </div>



                                    <div class="freelancer-right">


                                        <div class="freelancer-rating">

                                            <span class="star">
                                                ★
                                            </span>

                                            <strong>
                                                4.9
                                            </strong>

                                            <small>
                                                (512)
                                            </small>

                                        </div>


                                        <div class="freelancer-jobs">
                                            340 jobs
                                        </div>


                                        <div class="freelancer-price">
