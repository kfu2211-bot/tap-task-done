                                        </div>


                                        <div class="freelancer-jobs">
                                            100 jobs
                                        </div>


                                        <div class="freelancer-price">
                                            ₱600
                                        </div>


                                        <button class="arrow-button"
                                                type="button"
                                                data-name="Ofrac­io">
                                            View profile

                                        </button>


                                    </div>

                                </article>



                                <!-- MARISOL -->

                                <article class="freelancer-card"
                                         data-service="house cleaner cleaning deep clean" data-location="Metro Manila" data-rate="450" data-availability="Available" data-demo="true">

                                    <div class="freelancer-left">


                                        <div class="freelancer-avatar">
                                            Ma
                                        </div>


                                        <div class="freelancer-info">

                                            <strong>
                                                Marisol
                                            </strong>

                                            <span>
                                                House Cleaner
                                            </span>

                                        </div>


                                    </div>



                                    <div class="freelancer-right">


                                        <div class="freelancer-rating">

