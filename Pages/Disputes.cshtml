@page
@model tts.Pages.DisputesModel
@{ Layout = null; var task = Model.TaskItem!; }
<!DOCTYPE html><html lang="en"><head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" /><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Task dispute</title><link rel="stylesheet" href="/css/settings.css" asp-append-version="true" /><link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" /><link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" /><link rel="stylesheet" href="/css/dispute-light.css" asp-append-version="true" /><script defer src="/js/sidebar-account.js" asp-append-version="true"></script>
</head>
<body class="dispute-page"><div class="settings-layout"><aside class="sidebar"><div class="brand"><span class="brand-icon">✓</span><strong>Tap, Task, Done</strong></div><nav class="sidebar-menu"></nav><div class="sidebar-account"><span class="account-avatar">U</span><div><strong id="sidebarName">User</strong><span id="sidebarEmail"></span></div></div></aside><main><header><h1>Task dispute</h1></header><section class="settings-content dispute-content"><a class="dispute-back" href="/Tracking">← Back to tracking</a><span class="dispute-eyebrow">TASK SUPPORT</span><h2>Task dispute</h2><p class="dispute-task">@task.Title · Status: @task.Status.Replace("-", " ")</p><p>A dispute is for disagreements about this task. Both participants can see the reason and resolution. For safety concerns, use <a href="/Reports">Safety &amp; Reports</a>.</p>
@if (!string.IsNullOrWhiteSpace(Model.Notice)) { <p class="safety-notice" role="status">@Model.Notice</p> }
@if (task.Status is "assigned" or "in-progress" or "awaiting-confirmation") { <form method="post" class="admin-report-card safety-form"><input type="hidden" name="taskId" value="@task.Id" /><label for="reason">What is the disagreement?</label><textarea id="reason" name="reason" maxlength="1000" rows="5" required></textarea><p>Submitting pauses task progress and completion until an admin closes the dispute. Do not include passwords or sensitive ID information.</p><button type="submit">Submit dispute</button></form> }
@foreach (var item in Model.Items) { <article class="admin-report-card"><h2>Dispute #@item.Id · @item.Status</h2><p>Opened @tts.Data.DisplayTime.Philippine(item.CreatedAt)</p><p class="admin-report-description">@item.Reason</p>@if(item.Status == "closed") { <p><strong>Admin resolution:</strong> @item.Resolution</p> }</article> }
@if (Model.Items.Count == 0) { <p>No disputes submitted for this task.</p> }
</section></main></div></body></html>
