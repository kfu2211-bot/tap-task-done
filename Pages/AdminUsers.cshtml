@page
@model tts.Pages.AdminUsersModel
@{ Layout = null; }
<!doctype html>
<html lang="en" class="@(Model.Embedded ? "embedded" : "")">
<head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" asp-append-version="true" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Account management</title>
    <link rel="stylesheet" href="/css/admin-users.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/account-warning.css" asp-append-version="true" /><partial name="_AccountTheme" /></head>
<body>
<main class="users-page">
    @if (!Model.Embedded) { <h1>Users</h1> }
    @if (Model.RelatedReport is { } report)
    {
        <p><a asp-page="/AdminReports" asp-route-embedded="@Model.Embedded" asp-fragment="@($"report-{report.Id}")">← Back to Safety Reports</a></p>
        <h2>Account review for report #@report.Id</h2>
        <p>Reported name: <strong>@report.Target</strong>. Verify the account using the evidence before recording an offense.</p>
    }
    else
    {
        <p class="intro">Look up an account to check its status and moderation history. Start new offense reviews from Safety Reports.</p>
    }
    @if (!string.IsNullOrEmpty(Model.Notice)) { <p class="notice" role="status">@Model.Notice</p> }
    @if (Model.Unavailable) { <div class="empty" role="alert">Account moderation is unavailable. Check the account moderation database setup.</div> }
    else {
        <label class="search"><span class="sr-only">Search users</span><input id="search" type="search" placeholder="Search by name or email" /></label>
        <div class="user-list">
        @foreach (var user in Model.Users) {
            var history = Model.History.Where(h => h.UserId == user.Id).ToList();
            <article class="user-card" data-search="@($"{user.Name} {user.Email}".ToLowerInvariant())">
                <div class="user-head"><div class="user-identity"><span class="avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(user.Name) ? "U" : user.Name.Trim().Substring(0, 1).ToUpperInvariant())</span><div><strong>@user.Name @if(user.Restricted) { <span class="account-warning-symbol" title="Account warning">⚠</span> }</strong><p>@user.Email <span aria-hidden="true">·</span> @user.Role</p></div></div><span class="badge @(user.Suspended ? "suspended" : user.Restricted ? "restricted" : "")">@user.Moderation.Penalty</span></div>
                @if (!tts.Data.AccountModerationRules.IsStaff(user.Role)) {
                    <p><strong>Confirmed offenses: @user.Moderation.Offenses</strong> · Next: @tts.Data.OffensePolicy.NextPenalty(user.Moderation.Offenses + 1)</p>
                    @if(user.Moderation.Target > 0 && !user.Moderation.Permanent) { <p>Recovery progress: @user.Moderation.Completed / @user.Moderation.Target completed tasks. Temporary suspension ends automatically; completion credit starts after it ends.</p> }
                    @if(user.Moderation.Legacy) { <p>Previous actions remain in history; they are not automatically counted as new offenses.</p> }
                    @if (Model.RelatedReport is { } linkedReport ? user.Id != linkedReport.ReporterId && user.Moderation.Offenses < 5 && !user.Moderation.Permanent : user.Suspended || user.Restricted)
                    {
                    <form method="post" data-moderation-account="@user.Name" data-next-penalty="@tts.Data.OffensePolicy.NextPenalty(user.Moderation.Offenses + 1)">
                        <input type="hidden" name="userId" value="@user.Id" /><input type="hidden" name="expectedNumber" value="@(user.Moderation.Offenses + 1)" /><input type="hidden" name="Embedded" value="@Model.Embedded.ToString().ToLowerInvariant()" />
                        <input type="hidden" name="ReportId" value="@Model.ReportId" />
                        <input type="hidden" name="incidentKey" value="@(Model.ReportId.HasValue ? $"report:{Model.ReportId}" : "")" />
                        <label class="reason-label" for="reason-@user.Id">Reason for this decision <span>(required)</span></label>
                        <textarea id="reason-@user.Id" name="reason" required maxlength="500" rows="2" placeholder="Describe the reviewed evidence and decision"></textarea>
                        @if (Model.RelatedReport is not null) { <label class="offense-confirm"><input type="checkbox" name="reviewConfirmed" value="true" /> I reviewed the evidence and confirmed this is a distinct incident.</label> }
                        <div class="actions">@if(Model.RelatedReport is not null) { <button type="submit" class="primary" name="action" value="offense">Confirm offense #@(user.Moderation.Offenses + 1)</button> } @if(Model.RelatedReport is null) { <button type="submit" name="action" value="restore">Lift penalty after review</button> }</div>
                    </form>
                    }
                }
                <details class="history"><summary><span><strong>Admin action history</strong><small>View decisions and notes</small></span><span class="chevron" aria-hidden="true">⌄</span></summary>
                    <div class="history-content">@if (history.Count == 0) { <p class="history-empty">No decisions recorded for this account yet.</p> } else { @foreach (var item in history) { <div class="history-entry"><div><strong>@(item.Action == "warn" ? "Warning" : item.Action == "restrict" ? "Restricted" : item.Action == "suspend" ? "Suspended (legacy)" : item.Action == "offense" ? "Confirmed offense" : "Penalty lifted")</strong><small>@item.Admin · @tts.Data.DisplayTime.Philippine(item.CreatedAt)</small></div><p>@item.Reason</p></div> } }</div>
                </details>
            </article>
        }
        </div>
        <p class="empty" id="noMatches" hidden>No accounts match your search.</p>
    }
</main>
<dialog id="moderationDecision" aria-labelledby="moderationTitle" aria-describedby="moderationDescription">
    <h2 id="moderationTitle"></h2>
    <p id="moderationDescription"></p>
    <p class="moderation-summary"></p>
    <form method="dialog" class="actions">
        <button value="back" autofocus>Back to review</button>
        <button class="primary" value="confirm"></button>
    </form>
</dialog>
<script>
    const decision = document.getElementById('moderationDecision');
    let pendingSubmitter;
    let confirmedSubmitter;
    document.querySelectorAll('form[data-moderation-account]').forEach(form => {
        form.addEventListener('submit', event => {
            const submitter = event.submitter;
            if (!submitter || submitter === confirmedSubmitter) return;
            event.preventDefault();
            pendingSubmitter = submitter;
            const offense = submitter.value === 'offense';
            decision.querySelector('h2').textContent = offense ? submitter.textContent.trim() + '?' : 'Lift this penalty?';
            decision.querySelector('#moderationDescription').textContent = offense
                ? 'This records the incident and applies the penalty shown below. Count each incident only once.'
                : 'This lifts the current penalty. The decision stays in the admin history.';
            decision.querySelector('.moderation-summary').textContent = offense
                ? [form.dataset.moderationAccount, form.elements.incidentKey.value.trim(), form.dataset.nextPenalty].filter(Boolean).join(' · ')
                : form.dataset.moderationAccount;
            decision.querySelector('[value="confirm"]').textContent = offense ? 'Record offense' : 'Lift penalty';
            decision.returnValue = '';
            if (window.frameElement) {
                const frameTop = window.frameElement.getBoundingClientRect().top;
                decision.style.top = Math.max(16, window.parent.innerHeight / 2 - frameTop) + 'px';
                decision.classList.add('moderation-embedded');
            }
            decision.showModal();
        });
    });
    decision.addEventListener('close', () => {
        const submitter = pendingSubmitter;
        pendingSubmitter = null;
        if (!submitter || decision.returnValue !== 'confirm') return;
        confirmedSubmitter = submitter;
        try {
            submitter.form.requestSubmit(submitter);
        } finally {
            confirmedSubmitter = null;
        }
    });

    const search = document.getElementById('search');
    search?.addEventListener('input', () => {
        const query = search.value.trim().toLowerCase();
        const users = [...document.querySelectorAll('[data-search]')];
        users.forEach(user => user.hidden = !user.dataset.search.includes(query));
        document.getElementById('noMatches').hidden = users.some(user => !user.hidden);
    });
    if (document.documentElement.classList.contains('embedded') && window.parent !== window) {
        const reportHeight = () => window.parent.postMessage({ type: 'admin-users-height', height: document.querySelector('.users-page').getBoundingClientRect().height }, window.location.origin);
        new ResizeObserver(reportHeight).observe(document.querySelector('.users-page'));
        document.querySelectorAll('details').forEach(details => details.addEventListener('toggle', reportHeight));
        window.addEventListener('load', reportHeight);
        reportHeight();
    }
</script>
</body></html>
