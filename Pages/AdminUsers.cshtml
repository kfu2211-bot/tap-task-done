@page
@model tts.Pages.AdminUsersModel
@{ Layout = null; }
<!doctype html>
<html lang="en" class="@(Model.Embedded ? "embedded" : "")">
<head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" asp-append-version="true" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Account management</title>
    <link rel="stylesheet" href="/css/admin-users.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/account-warning.css" asp-append-version="true" /><link rel="stylesheet" href="/css/admin-design.css" asp-append-version="true" /><partial name="_AccountTheme" /></head>
<body>
<main class="users-page">
    @if (!Model.Embedded) { <h1>Users</h1> }
    <p class="intro">Manage accounts, penalties and site activity in one place. Philippine time (UTC+8).</p>
    @if (!string.IsNullOrEmpty(Model.Notice)) { <p class="notice" role="status">@Model.Notice</p> }
    @if (Model.Unavailable) { <div class="empty" role="alert" data-i18n>Account moderation is unavailable. Check the account moderation database setup.</div> }
    else {
        <form class="users-toolbar" id="usersTools" method="get" action="/AdminUsers">
            <input type="hidden" name="Embedded" value="@Model.Embedded.ToString().ToLowerInvariant()" />
            <p class="users-total">All users · <strong>@Model.Users.Count</strong> accounts</p>
            <label class="users-search" for="userSearch"><span>Search users</span><input id="userSearch" name="Search" type="search" value="@Request.Query["Search"]" placeholder="Type a name or email" autocomplete="off" aria-describedby="userSearchStatus" /></label>
            <button class="refresh-users" type="submit"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6 7a7 7 0 0 1 12-1l2 3M4 15l2 3a7 7 0 0 0 12-1"/></svg><span>Refresh activity</span></button>
        </form>
        <p id="userSearchStatus" class="session-note" role="status" aria-live="polite"></p>
        @if (Model.SessionsUnavailable) { <p class="notice" role="alert">Site activity is temporarily unavailable. Account management is still available.</p> }
        @if (Model.Users.Count == 0) { <p class="empty">No registered users yet.</p> }
        <div class="user-list">
        @foreach (var user in Model.Users) {
            var history = Model.History.Where(h => h.UserId == user.Id).ToList();
            var latest = Model.LatestSessions.GetValueOrDefault(user.Id);
            var online = Model.OnlineUsers.Contains(user.Id);
            var sessionStatus = latest is null ? "No sessions yet" : tts.Data.UserActivity.Status(latest, Model.Now);
            <article class="user-card" data-user-id="@user.Id" data-user-search="@($"{user.Name} {user.Email}")">
                <div class="user-head"><div class="user-identity"><span class="avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(user.Name) ? "U" : user.Name.Trim().Substring(0, 1).ToUpperInvariant())@if (user.HasPhoto) { <img class="user-avatar-photo" src="@Url.Page("/ProfilePhoto", "Staff", new { userId = user.Id })" alt="" loading="lazy" /> }</span><div><strong>@user.Name @if(user.Restricted) { <span class="account-warning-symbol" title="Account warning">⚠</span> }</strong><p>@user.Email <span aria-hidden="true">·</span> @user.Role</p></div></div><span class="badge @(user.Suspended ? "suspended" : user.Restricted ? "restricted" : "")">@(user.Suspended || user.Restricted ? user.Moderation.Penalty : "No penalty")</span></div>
                <div class="presence-line"><span class="presence-badge @(online ? "is-online" : "")" data-presence>@(Model.SessionsUnavailable ? "Activity unavailable" : online ? "Online" : latest is null ? "Not yet detected" : "Offline")</span></div>
                <dl class="session-summary">
                    <div><dt>Time In</dt><dd data-time-in>@(latest is null ? "—" : tts.Data.DisplayTime.Philippine(latest.StartedUtc))</dd></div>
                    <div><dt>Last Active</dt><dd data-last-active>@(latest is null ? "—" : tts.Data.DisplayTime.Philippine(latest.LastActiveUtc))</dd></div>
                    <div><dt>Time Out</dt><dd data-time-out>@(latest is null ? "—" : latest.LogoutUtc.HasValue ? tts.Data.DisplayTime.Philippine(latest.LogoutUtc.Value) : sessionStatus == "Inactive" ? "~ " + tts.Data.DisplayTime.Philippine(latest.LastActiveUtc) : "—")</dd></div>
                </dl>
                <p class="session-note">Account penalty and online presence are separate. Latest login shown; online checks all devices. ~ means estimated time out. Older logins use the available sign-in cookie time.</p>
                @if (!tts.Data.AccountModerationRules.IsStaff(user.Role)) {
                    <p><strong>Confirmed offenses: @user.Moderation.Offenses</strong> · Next: @tts.Data.OffensePolicy.NextPenalty(user.Moderation.Offenses + 1)</p>
                    <details class="history penalty-panel" open="@(user.Suspended || user.Restricted)"><summary><strong>Penalty &amp; recovery</strong><span class="chevron" aria-hidden="true">⌄</span></summary><div class="history-content">
                    @if(user.Moderation.Target > 0 && !user.Moderation.Permanent) { <p>Recovery progress: @user.Moderation.Completed / @user.Moderation.Target completed tasks. Temporary suspension ends automatically; completion credit starts after it ends.</p> }
                    @if(user.Moderation.Legacy) { <p data-i18n>Previous actions remain in history; they are not automatically counted as new offenses.</p> }
                    @if (user.Suspended || user.Restricted)
                    {
                    <form method="post" data-moderation-account="@user.Name" data-next-penalty="@tts.Data.OffensePolicy.NextPenalty(user.Moderation.Offenses + 1)">
                        <input type="hidden" name="userId" value="@user.Id" /><input type="hidden" name="expectedNumber" value="@(user.Moderation.Offenses + 1)" /><input type="hidden" name="Embedded" value="@Model.Embedded.ToString().ToLowerInvariant()" />
                        <label class="reason-label" for="reason-@user.Id">Reason for this decision <span data-i18n>(required)</span></label>
                        <textarea id="reason-@user.Id" name="reason" required maxlength="500" rows="2" placeholder="Describe the reviewed evidence and decision"></textarea>
                        <div class="actions"><button type="submit" name="action" value="restore">Lift penalty after review</button></div>
                    </form>
                    }
                    @if (!user.Suspended && !user.Restricted) { <p>No current penalty. Review new offenses in <a href="/Admin#reports" target="_top">Safety Reports</a>.</p> }
                    </div></details>
                }
                @if (user.CanDelete)
                {
                    <details class="history unverified-delete">
                        <summary><strong>Delete account</strong><span class="chevron" aria-hidden="true">⌄</span></summary>
                        <div class="history-content">
                        <form method="post" asp-page-handler="DeleteUnverified">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <input type="hidden" name="Embedded" value="@Model.Embedded.ToString().ToLowerInvariant()" />
                            <p>Email verification is incomplete for <strong>@user.Email</strong>.</p>
                            <label><input type="checkbox" name="confirmDeletion" value="true" required /> Permanently delete the personal data, posted tasks and submitted safety reports for this account.</label>
                            <div class="actions"><button type="submit">Delete unverified account</button></div>
                        </form>
                        </div>
                    </details>
                }
                else
                {
                    <details class="history unverified-delete"><summary><strong>Delete account</strong><span class="chevron" aria-hidden="true">⌄</span></summary><div class="history-content"><p>@(tts.Data.AccountModerationRules.IsStaff(user.Role) ? "Staff accounts cannot be deleted here." : "Direct deletion is available only for eligible unverified accounts. Review submitted deletion requests in the deletion queue.")</p><a href="/Admin#deletions" target="_top">View deletion requests</a></div></details>
                }
                <details class="history session-history" data-user-id="@user.Id"><summary><strong>Session history</strong><span class="chevron" aria-hidden="true">⌄</span></summary><div class="history-content"><p class="session-feedback" role="status">Open to load sessions.</p><div class="session-entries"></div><button type="button" class="session-more" hidden>Load more sessions</button></div></details>
                <details class="history"><summary><span><strong>Admin action history</strong><small data-i18n>View decisions and notes</small></span><span class="chevron" aria-hidden="true">⌄</span></summary>
                    <div class="history-content">@if (history.Count == 0) { <p class="history-empty" data-i18n>No decisions recorded for this account yet.</p> } else { @foreach (var item in history) { <div class="history-entry"><div><strong>@(item.Action == "warn" ? "Warning" : item.Action == "restrict" ? "Restricted" : item.Action == "suspend" ? "Suspended (legacy)" : item.Action == "offense" ? "Confirmed offense" : "Penalty lifted")</strong><small>@item.Admin · @tts.Data.DisplayTime.Philippine(item.CreatedAt)</small></div><p>@item.Reason</p></div> } }</div>
                </details>
            </article>
        }
        </div>
        <p id="noUserMatches" class="empty" hidden>No users match your search. Try another name or email.</p>
    }
</main>
<dialog id="moderationDecision" aria-labelledby="moderationTitle" aria-describedby="moderationDescription">
    <h2 id="moderationTitle"></h2>
    <p id="moderationDescription"></p>
    <p class="moderation-summary"></p>
    <form method="dialog" class="actions">
        <button value="back" autofocus>Back to review</button>
        <button class="primary" value="confirm"></button>
    </form>
</dialog>
<script defer src="/js/admin-user-sessions.js" asp-append-version="true"></script>
<script defer src="/js/admin-users-search.js" asp-append-version="true"></script>
<script>
    const decision = document.getElementById('moderationDecision');
    let pendingSubmitter;
    let confirmedSubmitter;
    document.querySelectorAll('form[data-moderation-account]').forEach(form => {
        form.addEventListener('submit', event => {
            const submitter = event.submitter;
            if (form.getAttribute('aria-busy') === 'true') {
                event.preventDefault();
                return;
            }
            if (!submitter) return;
            if (submitter === confirmedSubmitter) {
                if (submitter.value === 'restore') {
                    const action = document.createElement('input');
                    action.type = 'hidden';
                    action.name = submitter.name;
                    action.value = submitter.value;
                    form.append(action);
                    form.setAttribute('aria-busy', 'true');
                    submitter.textContent = 'Lifting penalty…';
                    submitter.classList.add('moderation-loading');
                    submitter.disabled = true;
                    window.addEventListener('pageshow', event => {
                        if (!event.persisted) return;
                        action.remove();
                        form.removeAttribute('aria-busy');
                        submitter.textContent = 'Lift penalty after review';
                        submitter.classList.remove('moderation-loading');
                        submitter.disabled = false;
                    }, { once: true });
                }
                return;
            }
            event.preventDefault();
            pendingSubmitter = submitter;
            const offense = submitter.value === 'offense';
            decision.querySelector('h2').textContent = offense ? submitter.textContent.trim() + '?' : 'Lift this penalty?';
            decision.querySelector('#moderationDescription').textContent = offense
                ? 'This records the incident and applies the penalty shown below. Count each incident only once.'
                : 'This lifts the current penalty. The decision stays in the admin history.';
            decision.querySelector('.moderation-summary').textContent = offense
                ? [form.dataset.moderationAccount, form.elements.incidentKey.value.trim(), form.dataset.nextPenalty].filter(Boolean).join(' · ')
                : form.dataset.moderationAccount;
            decision.querySelector('[value="confirm"]').textContent = offense ? 'Record offense' : 'Lift penalty';
            decision.returnValue = '';
            if (window.frameElement) {
                const frameTop = window.frameElement.getBoundingClientRect().top;
                decision.style.top = Math.max(16, window.parent.innerHeight / 2 - frameTop) + 'px';
                decision.classList.add('moderation-embedded');
            }
            decision.showModal();
        });
    });
    decision.addEventListener('close', () => {
        const submitter = pendingSubmitter;
        pendingSubmitter = null;
        if (!submitter || decision.returnValue !== 'confirm') return;
        confirmedSubmitter = submitter;
        try {
            submitter.form.requestSubmit(submitter);
        } finally {
            confirmedSubmitter = null;
        }
    });

    document.querySelectorAll('.unverified-delete form').forEach(form => {
        const button = form.querySelector('button[type="submit"]');
        const label = button.textContent;
        form.addEventListener('submit', event => {
            if (button.disabled) {
                event.preventDefault();
                return;
            }
            form.setAttribute('aria-busy', 'true');
            button.textContent = 'Deleting account…';
            button.classList.add('moderation-loading');
            button.disabled = true;
        });
        window.addEventListener('pageshow', () => {
            form.removeAttribute('aria-busy');
            button.textContent = label;
            button.classList.remove('moderation-loading');
            button.disabled = false;
        });
    });

    document.querySelectorAll('.user-avatar-photo').forEach(photo => {
        photo.addEventListener('error', () => photo.remove(), { once: true });
        if (photo.complete && !photo.naturalWidth) photo.remove();
    });

    if (document.documentElement.classList.contains('embedded') && window.parent !== window) {
        const reportHeight = () => window.parent.postMessage({ type: 'admin-users-height', height: document.querySelector('.users-page').getBoundingClientRect().height }, window.location.origin);
        new ResizeObserver(reportHeight).observe(document.querySelector('.users-page'));
        document.querySelectorAll('details').forEach(details => details.addEventListener('toggle', reportHeight));
        window.addEventListener('load', reportHeight);
        reportHeight();
    }
</script>
</body></html>
