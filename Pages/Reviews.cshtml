@page
@model tts.Pages.ReviewsModel

@{
    Layout = null;
    var ratingsGiven = Model.View == "given";
}

<!DOCTYPE html>
<html lang="en">

<head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" />

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Service Ratings</title>

    <link rel="stylesheet"
          href="/css/reviews.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/readability.css" asp-append-version="true" />
    <script defer src="/js/sidebar-account.js" asp-append-version="true"></script>
    <script defer src="/js/profile-photo.js" asp-append-version="true"></script>

<link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/reviews-polish.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/sidebar-consistency.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/workspace-spacing.css" asp-append-version="true" />
<partial name="_AccountTheme" /></head>

<body class="compact-page-layout">

    <div class="reviews-page">

        <!-- =========================================
             SIDEBAR
        ========================================== -->

        <aside class="sidebar">

            <a class="sidebar-logo" asp-page="/Landing" aria-label="Tap, Task, Done landing page" style="text-decoration:none">

                <div class="logo-check">
                    ✓
                </div>

                <span>
                    Tap, Task, Done
                </span>

            </a>


            <nav class="sidebar-nav" data-home-view="@Model.RoleFilter">

                <a href="/Dashboard" class="nav-item">
                    <span class="nav-icon">⌂</span>
                    <span data-i18n>Home</span>
                </a>

                <a href="/FindPost" class="nav-item">
                    <span class="nav-icon">⌕</span>
                    <span data-i18n>Find &amp; Post</span>
                </a>

                <a href="/MyTasks" class="nav-item">
                    <span class="nav-icon">▤</span>
                    <span data-i18n>My Tasks</span>
                </a>

                <a href="/Messages" class="nav-item">
                    <span class="nav-icon">□</span>
                    <span data-i18n>Messages</span>
                </a>

                <a href="/IdentityVerification" class="nav-item">
                    <span class="nav-icon">✓</span>
                    <span data-i18n>Identity Verification</span>
                </a>

                <a href="/Tracking" class="nav-item">
                    <span class="nav-icon">➤</span>
                    <span data-i18n>Tracking</span>
                </a>

                <a href="/Reviews" class="nav-item active">
                    <span class="nav-icon">☆</span>
                    <span data-i18n>Service Ratings</span>
                </a>

            </nav>


            <!-- USER -->

            <div class="sidebar-user">

                <div class="user-avatar" id="sidebarAvatar">
                    JD
                </div>

                <div class="user-info">

                    <strong id="sidebarName">
                        Jhon
                    </strong>

                    <span id="sidebarEmail">
                        jhon@gmail.com
                    </span>

                </div>

                <button class="user-menu">
                    ⋮
                </button>

            </div>

        </aside>


        <!-- =========================================
             MAIN CONTENT
        ========================================== -->

        <main class="main-content">

            <!-- HEADER -->

            <header class="top-header">

                <h1>
                    Service Ratings
                </h1>

                <button class="notification-button app-notification-trigger">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-2 7-2 9h16c0-2-2-2-2-9M10 20h4"/></svg>
                </button>

            </header>


            <!-- =====================================
                 REVIEWS CONTENT
            ====================================== -->

            @if (!Model.Legacy)
            {
            <section class="reviews-live service-ratings-page">
                <p class="compact-page-description" data-i18n>Feedback from completed tasks, clearly organized.</p>
                @if (!string.IsNullOrEmpty(Model.Notice)) { <p role="status">@Model.Notice</p> }
                @if (Model.FocusTaskId is not null) {
                    <section class="service-rating-focus"><strong translate="no">@Model.FocusTaskTitle · #@Model.FocusTaskId</strong><div class="work-primary-actions"><a class="work-button work-button-secondary" href="@Url.Page("/Reviews", new { asRole=Model.RoleFilter })" data-i18n>All service ratings</a><a class="work-button work-button-secondary" href="/Tracking?taskId=@Model.FocusTaskId" data-i18n>Task history</a>@if(Model.CanRate) { <a class="work-button" href="/Tracking?taskId=@Model.FocusTaskId#completed-reviews">@(Model.FocusIsClient ? "Rate freelancer" : "Rate client")</a> }</div></section>
                }
                <header class="service-rating-context">
                    <div><span class="service-rating-context-label" data-i18n>@(Model.RoleFilter == "client" ? "Client view" : "Freelancer view")</span><h2 data-i18n>@Model.ContextTitle</h2><p data-i18n>@Model.ContextHelp</p></div>
                    @if (Model.CanSwitchRoles && Model.FocusTaskId is null) {
                        <nav class="service-rating-roles" aria-label="Rating workspace">
                            @foreach (var role in new[] { ("client","As client"),("freelancer","As freelancer") }) {
                                <a href="@Url.Page("/Reviews",new { view=Model.View,asRole=role.Item1 })" aria-current="@(Model.RoleFilter == role.Item1 ? "page" : null)" data-i18n>@role.Item2</a>
                            }
                        </nav>
                    }
                </header>
                <nav class="service-rating-tabs" aria-label="Rating direction"><a href="@Url.Page("/Reviews",new { view="received",asRole=Model.RoleFilter,taskId=Model.FocusTaskId })" aria-current="@(Model.View == "received" ? "page" : null)"><span data-i18n>Ratings received</span> (@Model.ReceivedCount)</a><a href="@Url.Page("/Reviews",new { view="given",asRole=Model.RoleFilter,taskId=Model.FocusTaskId })" aria-current="@(Model.View == "given" ? "page" : null)"><span data-i18n>Ratings given</span> (@Model.GivenCount)</a></nav>
                @if(Model.Unavailable) { <div class="workflow-empty" role="alert"><p data-i18n>Ratings are temporarily unavailable. Please try again.</p><a class="work-button work-button-secondary" href="/Reviews" data-i18n>Try again</a></div> }
                else { <div class="service-rating-layout"><partial name="_ServiceRatingSummary" model="Model.Items" /><partial name="_ServiceRatingsList" model="new tts.Data.ServiceRatingsView(Model.Items,true,ratingsGiven)" /></div> }
            </section>
            }
            else
            {
            <p style="margin: 24px"><a href="/Reviews" data-i18n>← Back to MySQL reviews</a> · Older browser-only reviews are not imported.</p>
            <section class="reviews-content">


                <!-- =================================
                     RATING SUMMARY
                ================================== -->

                <div class="rating-summary">

                    <div class="rating-number">
                        4.6
                    </div>

                    <div class="rating-stars">
                        ★ ★ ★ ★ ★
                    </div>

                    <div class="reviews-count">
                        241 reviews given
                    </div>


                    <div class="rating-divider"></div>


                    <!-- 5 STARS -->

                    <div class="rating-row">

                        <span>5★</span>

                        <div class="rating-bar">
                            <div class="rating-fill"
                                 style="width: 91%;">
                            </div>
                        </div>

                        <span class="rating-total">
                            182
                        </span>

                    </div>


                    <!-- 4 STARS -->

                    <div class="rating-row">

                        <span>4★</span>

                        <div class="rating-bar">
                            <div class="rating-fill"
                                 style="width: 21%;">
                            </div>
                        </div>

                        <span class="rating-total">
                            41
                        </span>

                    </div>


                    <!-- 3 STARS -->

                    <div class="rating-row">

                        <span>3★</span>

                        <div class="rating-bar">
                            <div class="rating-fill"
                                 style="width: 6%;">
                            </div>
                        </div>

                        <span class="rating-total">
                            12
                        </span>

                    </div>


                    <!-- 2 STARS -->

                    <div class="rating-row">

                        <span>2★</span>

                        <div class="rating-bar">
                            <div class="rating-fill"
                                 style="width: 2%;">
                            </div>
                        </div>

                        <span class="rating-total">
                            4
                        </span>

                    </div>


                    <!-- 1 STAR -->

                    <div class="rating-row">

                        <span>1★</span>

                        <div class="rating-bar">
                            <div class="rating-fill"
                                 style="width: 1%;">
                            </div>
                        </div>

                        <span class="rating-total">
                            2
                        </span>

                    </div>

                </div>


                <!-- =================================
                     RIGHT SIDE
                ================================== -->

                <div class="reviews-list-area">


                    <!-- FILTERS -->

                    <div class="review-filters">

                        <button class="filter-button active">
                            All
                        </button>

                        <button class="filter-button">
                            5 stars
                        </button>

                        <button class="filter-button">
                            4 stars
                        </button>

                        <button class="filter-button">
                            3 stars
                        </button>

                    </div>


                    <!-- =================================
                         REVIEW 1
                    ================================== -->

                    <article class="review-card">

                        <div class="review-top">

                            <div class="review-person">

                                <div class="review-avatar">
                                    Of
                                </div>

                                <div>

                                    <strong>
                                        Ofrac
                                    </strong>

                                    <span data-i18n>
                                        Plumber
                                    </span>

                                </div>

                            </div>

                            <time>
                                Aug 18, 2026
                            </time>

                        </div>


                        <div class="review-rating">

                            <span class="stars">
                                ★★★★★
                            </span>

                            <span class="review-separator">
                                ·
                            </span>

                            <span>
                                Fix leaking kitchen faucet
                            </span>

                        </div>


                        <p>
                            Fast and professional. Fixed the leak
                            in under an hour and cleaned up after.
                            Highly recommend.
                        </p>

                    </article>


                    <!-- =================================
                         REVIEW 2
                    ================================== -->

                    <article class="review-card">

                        <div class="review-top">

                            <div class="review-person">

                                <div class="review-avatar">
                                    Ma
                                </div>

                                <div>

                                    <strong>
                                        Marisol
                                    </strong>

                                    <span data-i18n>
                                        House Cleaner
                                    </span>

                                </div>

                            </div>

                            <time>
                                Aug 12, 2026
                            </time>

                        </div>


                        <div class="review-rating">

                            <span class="stars">
                                ★★★★★
                            </span>

                            <span class="review-separator">
                                ·
                            </span>

                            <span>
                                Deep clean 2-bedroom condo
                            </span>

                        </div>


                        <p>
                            The place has never looked this good.
                            Very thorough and friendly. Will book
                            again.
                        </p>

                    </article>


                    <!-- =================================
                         REVIEW 3
                    ================================== -->

                    <article class="review-card">

                        <div class="review-top">

                            <div class="review-person">

                                <div class="review-avatar">
                                    Le
                                </div>

                                <div>

                                    <strong>
                                        Lea
                                    </strong>

                                    <span data-i18n>
                                        Errand Runner
                                    </span>

                                </div>

                            </div>

                            <time>
                                Aug 4, 2026
                            </time>

                        </div>


                        <div class="review-rating">

                            <span class="stars">
                                ★★★★★
                            </span>

                            <span class="review-separator">
                                ·
                            </span>

                            <span>
                                Grocery run &amp; pharmacy pickup
                            </span>

                        </div>


                        <p>
                            Great communication throughout.
                            Got everything on the list, just a
                            little later than expected.
                        </p>

                    </article>


                    <!-- =================================
                         REVIEW 4
                    ================================== -->

                    <article class="review-card">

                        <div class="review-top">

                            <div class="review-person">

                                <div class="review-avatar">
                                    Da
                                </div>

                                <div>

                                    <strong>
                                        Dante
                                    </strong>

                                    <span data-i18n>
                                        Electrician
                                    </span>

                                </div>

                            </div>

                            <time>
                                Jul 28, 2026
                            </time>

                        </div>


                        <div class="review-rating">

                            <span class="stars">
                                ★★★★★
                            </span>

                            <span class="review-separator">
                                ·
                            </span>

                            <span>
                                Install ceiling light fixture
                            </span>

                        </div>


                        <p>
                            Knew exactly what to do and explained
                            the work clearly. Neat wiring and no
                            mess left behind.
                        </p>

                    </article>

                </div>

            </section>
            }

        </main>

    </div>


    @if (Model.Legacy) { <script src="~/js/reviews.js?v=1"></script> }


    <partial name="_TaskHelp" />
</body>

</html>
