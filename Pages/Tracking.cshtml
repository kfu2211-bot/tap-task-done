@page
@model TrackingModel
@using tts.Data
@inject IConfiguration Configuration
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Tracking - Tap, Task, Done</title>

    <link rel="stylesheet" href="/css/completion-photo.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/tracking.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/tracking-database.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/readability.css" asp-append-version="true" />
    <script defer src="/js/sidebar-account.js" asp-append-version="true"></script>
    <script defer src="/js/profile-photo.js" asp-append-version="true"></script>
<link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" />
<style>
    html, html body, html body .tracking-layout, html body .tracking-layout > .main-content {
        background: #f6f7f3 !important;
        min-height: 100%;
    }
    html body .tracking-layout, html body .tracking-layout > .main-content { min-height: 100vh; }
    html body .tracking-layout > .main-content { display: flow-root; }
    @@media (min-width: 769px) { html body #mobileMenuToggle, html body #mobileMenuOverlay { display: none !important; } }
</style>
<link rel="stylesheet" href="/css/sidebar-consistency.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/workspace-spacing.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/maplibre-gl/maplibre-gl.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/job-location.css" asp-append-version="true" />
<link rel="stylesheet" href="/lib/maplibre-gl/maplibre-gl.css" asp-append-version="true" /><link rel="stylesheet" href="/css/task-location-picker.css" asp-append-version="true" /><script defer src="/lib/maplibre-gl/maplibre-gl.js" asp-append-version="true"></script><script defer src="/js/task-location-picker.js" asp-append-version="true"></script><script defer src="/js/agreement-live.js" asp-append-version="true"></script><partial name="_AccountTheme" /></head>

<body class="compact-page-layout">

    <div class="tracking-layout">

        <!-- ================= SIDEBAR ================= -->

        <aside class="sidebar">

            <a class="brand" asp-page="/Landing" aria-label="Tap, Task, Done landing page" style="text-decoration:none">
                <div class="brand-icon">✓</div>

                <div class="brand-name">
                    <strong>Tap, Task, Done</strong>
                </div>
            </a>


            <nav class="sidebar-menu">

                <a href="/Dashboard">
                    <span class="menu-icon">⌂</span>
                    <span data-i18n>Home</span>
                </a>


                <a href="/FindPost">
                    <span class="menu-icon">⌕</span>
                    <span data-i18n>Find &amp; Post</span>
                </a>


                <a href="/MyTasks">
                    <span class="menu-icon">▤</span>
                    <span data-i18n>My Tasks</span>
                </a>


                <a href="/Messages">
                    <span class="menu-icon">□</span>
                    <span data-i18n>Messages</span>
                </a>


                <a href="/IdentityVerification">
                    <span class="menu-icon">✓</span>
                    <span data-i18n>Identity Verification</span>
                </a>


                <a href="/Tracking"
                   class="active">
                    <span class="menu-icon">➤</span>
                    <span data-i18n>Tracking</span>
                </a>


                <a href="/Reviews">
                    <span class="menu-icon">☆</span>
                    <span data-i18n>Reviews</span>
                </a>

            </nav>


            <div class="sidebar-account">

                <div class="account-avatar">
                    JD
                </div>

                <div class="account-details">
                    <strong id="sidebarName">Jhon</strong>
                    <span id="sidebarEmail">jhon@gmail.com</span>
                </div>

                <div class="account-more">
                    ⋮
                </div>

            </div>

        </aside>


        <!-- ================= MAIN ================= -->

        <main class="main-content">


            <!-- TOP HEADER -->

            <header class="top-header">

                <h1>@(Model.IsHistory ? "Task history" : "Tracking")</h1>

                <div class="notification app-notification-trigger">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-2 7-2 9h16c0-2-2-2-2-9M10 20h4"/></svg>
                </div>

            </header>


            <!-- ================= TRACKING CONTENT ================= -->

            @{
            <section class="tracking-content db-tracking">
                <style>
                    .db-tracking .db-tracking-header h2,.db-tracking .db-tracking-card h3 { color:#143d31; }
                    .db-tracking .db-tracking-empty h3 { color:#143d31; }
                    .db-tracking .db-tracking-empty p { color:#526e60; }
                    .db-tracking .db-tracking-empty a:not(.workspace-action) { color:#126345; }
                    .db-tracking .db-tracking-header p,.db-tracking .db-tracking-card p { color:#526e60; }
                    .tracking-intro { background:#fff; border:1px solid #d5e5d6; border-radius:14px; padding:28px; margin-bottom:20px; }
                    .tracking-intro .db-tracking-header { margin-bottom:0; }
                    .tracking-intro .db-tracking-eyebrow { color:#19765a; font-size:10px; letter-spacing:.14em; }
                    .tracking-intro .db-tracking-header h2 { margin:10px 0 8px; font-size:28px; letter-spacing:-.5px; }
                    .tracking-intro .db-tracking-header p { margin:0; font-size:14px; }
                    html body .db-tracking .tracking-intro { background:#fff !important; box-shadow:none; }
                    html body .db-tracking .tracking-intro .db-tracking-header { background:#e5f0e6; box-shadow:none; }
                    .tracking-picker { position:relative; margin-top:10px; }
                    .tracking-picker-label { display:block; margin-top:16px; color:#193e30; font-size:13px; font-weight:600; }
                    .tracking-picker summary { list-style:none; display:flex; justify-content:space-between; align-items:center; gap:16px; min-height:62px; padding:13px 16px; border:1px solid #bfd3c3; border-radius:8px; background:#fff; color:#193e30; cursor:pointer; }
                    .tracking-picker summary::-webkit-details-marker { display:none; }
                    .tracking-picker summary > span { min-width:0; }
                    .tracking-picker summary strong { display:block; font-size:14px; font-weight:600; overflow-wrap:anywhere; }
                    .tracking-picker summary small { display:block; margin-top:5px; color:#637c6c; font-size:12px; }
                    .tracking-picker summary svg { flex:0 0 18px; width:18px; height:18px; color:#176b50; }
                    .tracking-picker[open] summary { border-color:#19765a; }
                    .tracking-picker[open] summary svg { transform:rotate(180deg); }
                    .tracking-picker summary:focus-visible,.tracking-picker-options a:focus-visible { outline:2px solid #19765a; outline-offset:3px; }
                    .tracking-picker-options { position:absolute; top:calc(100% + 7px); left:0; right:0; z-index:30; max-height:240px; overflow:auto; padding:5px; border:1px solid #d5e5d6; border-radius:8px; background:#fff; box-shadow:0 8px 24px rgba(25,62,48,.12); }
                    .tracking-picker-options a { display:flex; justify-content:space-between; align-items:center; gap:16px; padding:12px; border-radius:5px; color:#193e30; text-decoration:none; }
                    .tracking-picker-options a:hover,.tracking-picker-options a[aria-current="page"] { background:#edf5ed; }
                    .tracking-picker-options strong { display:block; font-size:13px; overflow-wrap:anywhere; }
                    .tracking-picker-options small { display:block; margin-top:4px; color:#637c6c; font-size:11px; }
                    .tracking-picker-options .tracking-picker-check { color:#19765a; font-weight:700; }
                    .tracking-map-link { display:inline-flex; gap:8px; align-items:center; margin-top:16px; color:#176b50; font-size:13px; font-weight:600; text-decoration:none; }
                    .tracking-selector { margin-top:24px; }
                    .tracking-selector label { display:block; color:#193e30; font-weight:700; margin-bottom:9px; }
                    .tracking-select { display:block; width:100%; max-width:100%; min-height:48px; padding:12px 16px; margin:0; border:1px solid #cde0cf; border-radius:10px; background:white; color:#143d31; }
                    .tracking-select:focus-visible { outline:3px solid #a7d8ba; outline-offset:2px; }
                    html body .db-tracking .db-tracking-card { background:white !important; border:1px solid #d5e5d6; border-radius:14px; margin:20px 0; padding:26px; }
                    .db-tracking .db-tracking-details > div { background:#f2f7f1; color:#264d3c; border:1px solid #e1eee1; }
                    .db-tracking .db-tracking-details strong { color:#143d31; }
                    .tracking-detail-layout { display:grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap:18px; margin-top:22px; align-items:start; }
                    .tracking-panel { border:1px solid #dce9dc; border-radius:12px; padding:22px; background:#fff; }
                    .tracking-panel h4 { color:#143d31; margin:0 0 18px; font-size:1.05rem; }
                    .tracking-timeline { list-style:none; margin:0; padding:0; }
                    .tracking-timeline li { display:flex; position:relative; gap:14px; padding:0 0 25px; color:#6b8074; }
                    .tracking-timeline li:not(:last-child)::after { content:""; position:absolute; left:13px; top:28px; bottom:0; width:2px; background:#dce9dc; }
                    .tracking-timeline li.done::after { background:#a1cfaf; }
                    .tracking-timeline li div { padding-top:3px; }
                    .tracking-timeline li small { display:block; margin-top:5px; color:#667f70; font-weight:400; line-height:1.4; }
                    .tracking-timeline li span { display:grid; place-items:center; width:28px; height:28px; flex:none; border:1px solid #adc9b1; border-radius:50%; }
                    .tracking-timeline li.current,.tracking-timeline li.done { color:#175e45; font-weight:600; }
                    .tracking-timeline li.current span,.tracking-timeline li.done span { background:#1a7657; color:white; border-color:#1a7657; }
                    .tracking-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:18px; }
                    .tracking-actions a,.tracking-actions button { display:inline-flex; align-items:center; justify-content:center; padding:10px 16px; border:1px solid #98c7a8; border-radius:8px; background:white; color:#126345; text-decoration:none; font-weight:600; cursor:pointer; }
                    .tracking-actions .tracking-primary { background:#197355; border-color:#197355; color:white; }
                    .tracking-actions form { margin:0; }
                    .tracking-person { font-size:1.1rem; font-weight:700; color:#143d31; }
                    .tracking-location { margin-top:16px; padding:18px; background:#fff; border:1px solid #dce9dc; border-radius:12px; color:#143d31; }
                    .tracking-location > strong,.tracking-location > span { display:block; }
                    .tracking-location > span { margin-top:6px; color:#526e60; overflow-wrap:anywhere; }
                    .tracking-map-preview { position:relative; overflow:hidden; height:155px; margin:14px 0 10px; border-radius:9px; background:repeating-linear-gradient(32deg, transparent 0 34px, #fff 35px 40px, transparent 41px 72px), repeating-linear-gradient(112deg, #e8f0e2 0 43px, #fff 44px 49px, #e8f0e2 50px 80px); border:1px solid #dce9dc; }
                    .tracking-map-preview::after { content:""; position:absolute; left:50%; top:48%; width:20px; height:20px; border:5px solid white; border-radius:50%; background:#187353; box-shadow:0 2px 8px #54786766; transform:translate(-50%,-50%); }
                    .tracking-map-note { font-size:12px; line-height:1.45; color:#526e60; }
                    .tracking-aside { display:grid; gap:16px; }
                    @@media(max-width:700px) { .tracking-detail-layout { grid-template-columns:1fr; } .tracking-intro { padding:20px; } .tracking-picker summary { padding:12px 14px; } }
                </style>
                @{
                    var selectedTask = long.TryParse(Request.Query["taskId"], out var requestedTask) && Model.Tasks.Any(x => x.Task.Id == requestedTask) ? requestedTask : Model.Tasks.FirstOrDefault()?.Task.Id;
                    var activeEntry = Model.Tasks.FirstOrDefault(x => x.Task.Id == selectedTask);
                }
                <div class="tracking-intro @(TaskTracking.ShowPicker(Model.IsHistory, Model.Tasks.Count) ? "" : "tracking-intro-simple")">
                    <p class="compact-page-description">@(Model.IsHistory ? "Review this task’s recorded progression, work details, and completion history." : "Follow your active work and review the next steps.")</p>
                    @if (activeEntry is not null && TaskTracking.ShowPicker(Model.IsHistory, Model.Tasks.Count)) {
                        <details class="tracking-picker tracking-picker-compact">
                            <summary><span><strong id="tracking-picker-current" data-i18n>Switch task</strong><small translate="no">@activeEntry.Task.Title · #@activeEntry.Task.Id</small></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
                            <nav class="tracking-picker-options" aria-label="Tasks available to track">
                                @foreach (var entry in Model.Tasks) {
                                    <a href="/Tracking?taskId=@entry.Task.Id" aria-current="@(entry.Task.Id == selectedTask ? "page" : null)"><span><strong>@entry.Task.Title</strong><small>@(entry.IsClient ? "Posted task" : "Accepted job") · #@entry.Task.Id</small></span>@if(entry.Task.Id == selectedTask) { <span class="tracking-picker-check" aria-hidden="true">✓</span> }</a>
                                }
                            </nav>
                        </details>
                    }
                </div>
                @if (Model.Unavailable) { <div class="db-tracking-empty"><h3>Tracking is unavailable</h3><p data-i18n>Please check the database connection and try again.</p><a class="work-button work-button-secondary" href="/Tracking" data-i18n>Try again</a></div> }
                else if (Model.Tasks.Count == 0) { <div class="db-tracking-empty"><span class="tracking-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 12h4l3-6 3 12 2-6h4"/></svg></span><h3>No active tasks to track</h3><p data-i18n>Your next accepted task will appear here. Finished tasks remain in your completed history.</p><a class="workspace-action" href="/FindPost" data-i18n>Explore Find &amp; Post</a></div> }
                @foreach (var item in Model.Tasks.Where(x => x.Task.Id == selectedTask)) {
                    var task = item.Task;
                    var status = Array.IndexOf(TaskProgress.States, task.Status);
                    var label = TaskSchedule.DisplayStatus(task, DateTime.UtcNow);
                    var steps = TaskProgress.Labels;
                    var jobEvents = Model.Progress.Where(e => e.TaskId == task.Id).ToList();
                    var flow = new JobFlowView(task, jobEvents, Model.Agreements.GetValueOrDefault(task.Id), item.IsClient, item.FreelancerId, DateTime.UtcNow);
                    var cancellationPending = jobEvents.LastOrDefault(e => e.Status is TaskProgress.CancellationRequested or TaskProgress.CancellationDeclined)?.Status == TaskProgress.CancellationRequested;
                    <article class="db-tracking-card"><div class="db-tracking-card-head"><div><span class="db-tracking-eyebrow">@(item.IsClient ? "YOUR POSTED TASK" : "YOUR ACCEPTED JOB")</span><h3>@task.Title</h3><p>@task.Category · @task.Location</p></div><div class="tracking-price-status"><div class="tracking-agreed-price"><span data-i18n>Agreed price</span><strong>₱@item.AgreedPrice.ToString("N2")</strong></div><span class="db-tracking-status" data-status="@label">@label</span></div></div>
                    <div class="db-tracking-details"><div><span data-i18n>Job type</span><strong>@task.JobTypeDisplay</strong></div><div><span data-i18n>Expected finish</span><strong>@(task.WorkEndUtc?.AddHours(8).ToString("MMM d, yyyy h:mm tt") ?? "To be agreed")</strong></div><div><span data-i18n>Client</span><strong>@item.Client</strong></div><div><span data-i18n>Freelancer</span><strong>@item.Freelancer</strong></div><div><span data-i18n>Schedule</span><strong>@TaskSchedule.Display(task.ScheduleText)</strong></div></div>
                    @if (Model.IsHistory) {
                    <section class="tracking-history-overview"><h4 data-i18n>Task details</h4><p translate="no">@task.Description</p><dl><div><dt data-i18n>Service</dt><dd>@task.CategoryDisplay</dd></div></dl><p class="work-help" data-i18n>Task details, progression, schedule changes and completion proof are kept together in this history.</p></section>
                    }
                    <div class="tracking-detail-layout tracking-workspace"><section class="tracking-panel tracking-progress-column"><h4>@(Model.IsHistory ? "Recorded progression" : "Task progress")</h4>
                    @if (Model.IsHistory) { <partial name="_TaskHistory" model="Model" /> }
                    @if (!Model.IsHistory && status >= 0) { var descriptions = new[] { "The booking or offer has been accepted.", "The freelancer is travelling to the work location.", "The freelancer has confirmed arrival. Travel tracking stops.", "The freelancer is performing the agreed work.", "The client reviews the finished work and any optional details.", "Completion has been confirmed. Reviews are available." }; <ol class="tracking-timeline">@for (var i = 0; i < steps.Length; i++) { <li class="@(i == 0 ? "done" : status == i ? "current" : status > i ? "done" : "")"><span>@(i == 0 || status > i ? "✓" : (i + 1).ToString())</span><div>@steps[i]<small>@descriptions[i]</small>
@{ var recorded = Model.Progress.LastOrDefault(x => x.TaskId == task.Id && x.Status == TaskProgress.States[i]); }
@if (recorded is not null) { <small>@recorded.CreatedAtUtc.AddHours(8).ToString("MMM d, yyyy h:mm tt") PHT</small> }</div></li> }</ol> }

@if (!string.IsNullOrEmpty(Model.Notice)) { <p role="status">@Model.Notice</p> }
@if (Model.ProgressUnavailable) { <p role="alert" data-i18n>Progress updates need the task_progress_events database table.</p> }
@{ var finished = Model.Progress.LastOrDefault(x => x.TaskId == task.Id && x.Status == "awaiting-confirmation"); }
<div data-flow-slot="multi" data-flow-key="@(flow.Agreement?.Version)-@(jobEvents.LastOrDefault()?.Id)-@CompletionFollowUp.Due(task, jobEvents, flow.Now)-@OverduePlan.Required(task, flow.Now)-@OverduePlan.Expired(task, flow.Now)-@OverduePlan.Ready(task, flow.Agreement, jobEvents, item.FreelancerId, flow.Now)-@JobCancellation.FollowUpDue(jobEvents.LastOrDefault(e => e.Status is TaskProgress.CancellationRequested or TaskProgress.CancellationDeclined), flow.Now)"><partial name="_MultiDayProgress" model="flow" /></div>
<div data-flow-slot="completion" data-flow-key="@(flow.Agreement?.Version)-@(jobEvents.LastOrDefault()?.Id)-@CompletionFollowUp.Due(task, jobEvents, flow.Now)-@OverduePlan.Required(task, flow.Now)-@OverduePlan.Expired(task, flow.Now)-@OverduePlan.Ready(task, flow.Agreement, jobEvents, item.FreelancerId, flow.Now)-@JobCancellation.FollowUpDue(jobEvents.LastOrDefault(e => e.Status is TaskProgress.CancellationRequested or TaskProgress.CancellationDeclined), flow.Now)"><partial name="_CompletionFollowUp" model="flow" /></div>
@if (finished is not null) { <partial name="_CompletionDetails" model="finished" /> }
@if (finished is not null && !item.IsClient && task.Status == "awaiting-confirmation") {
    <details class="work-editor work-completion-editor"><summary>Edit completion note</summary>
        <form method="post" asp-page-handler="CompletionNote"><input type="hidden" name="id" value="@task.Id" />
            <label>Completion note<textarea name="note" maxlength="1000" rows="3">@finished.Note</textarea></label>
            <button type="submit">Save completion note</button>
        </form>
    </details>
}
@if (!Model.IsHistory) {
    <section class="tracking-next-step" data-tracking-next-step data-blocked="@cancellationPending.ToString().ToLowerInvariant()" data-task-state="@task.Status" data-ready="@AgreementRules.CanProceed(Model.Agreements.GetValueOrDefault(task.Id)).ToString().ToLowerInvariant()">
        <h4 data-i18n>Next step</h4>
        @if (cancellationPending) { <strong data-i18n>Review the cancellation request</strong><a class="work-button work-button-secondary" href="#job-cancellation-@task.Id" data-i18n>Review request</a> }
        else if (task.Status == "assigned" && (OverduePlan.Required(task, flow.Now) || OverduePlan.Expired(task, flow.Now)) && !OverduePlan.Ready(task, flow.Agreement, jobEvents, item.FreelancerId, flow.Now)) { <strong data-i18n>Review overdue schedule</strong><a class="work-button work-button-secondary" href="#overdue-plan-@task.Id" data-i18n>Review schedule</a> }
        else if (task.Status == "assigned" && !AgreementRules.CanProceed(Model.Agreements.GetValueOrDefault(task.Id))) {
            <strong data-i18n>Confirm work details first</strong>
            <p data-i18n>Travel unlocks after both participants confirm the same work details.</p>
            <a class="work-button" href="#work-details-@task.Id" data-review-details data-i18n>Review details</a>
        } else if (task.Status == "assigned") {
            <p data-i18n>Work details are confirmed. Check your arrival schedule before travelling.</p>
        } else if (task.Status == "awaiting-confirmation") {
            <p data-i18n>@(item.IsClient ? "Review the finished work, then confirm completion." : "Waiting for the client to review and confirm completion.")</p>
        } else {
            <p data-i18n>Follow the current progress step below.</p>
        }
    </section>
}
<div class="tracking-actions tracking-current-actions">
@if (!cancellationPending && !Model.ProgressUnavailable && task.Status == "on-the-way")
{
    var requested = Model.Progress.Any(x => x.TaskId == task.Id && x.Status == TaskProgress.ArrivalRequest);
    <section class="tracking-arrival" data-arrival-panel data-task-id="@task.Id" data-arrival-requested="@(requested ? "true" : "false")" aria-labelledby="arrivalTitle-@task.Id">
        <h3 id="arrivalTitle-@task.Id">Confirm arrival</h3>
        @if (item.IsClient)
        {
            <p>@(requested ? "The freelancer asked you to confirm their arrival. Confirm once they are at the agreed location." : "The freelancer is travelling to the agreed task location.")</p>
            @if (requested)
            {
                <form method="post" asp-page-handler="Advance">
                    <input type="hidden" name="id" value="@task.Id" />
                    <button name="action" value="confirm-arrival" type="submit" class="tracking-primary">Confirm freelancer arrival</button>
                </form>
            }
        }
        else
        {
            <p data-arrival-status role="status" data-i18n>I’ve arrived becomes available once a recent, accurate location is within 100 m of the agreed pin.</p>
            <div class="tracking-arrival-buttons">
                <form method="post" asp-page-handler="Advance" data-arrival-form hidden>
                    <input type="hidden" name="id" value="@task.Id" />
                    <button name="action" value="arrive" type="submit" class="tracking-primary">I’ve arrived</button>
                </form>
                <button type="button" class="db-tracking-link" data-arrival-retry>Retry location</button>
            </div>
            @if (requested)
            {
                <p data-i18n>Waiting for the client to confirm your arrival.</p>
            }
            else
            {
                <form method="post" asp-page-handler="Advance">
                    <input type="hidden" name="id" value="@task.Id" />
                    <button name="action" value="request-arrival" type="submit" class="db-tracking-link">Ask client to confirm arrival</button>
                </form>
            }
        }
    </section>
}
@if (cancellationPending) { <p class="flow-notice" data-i18n>Resolve the cancellation request before changing task progress.</p> }
else if (task.Status == "assigned" && !AgreementRules.CanProceed(Model.Agreements.GetValueOrDefault(task.Id))) { <p class="flow-notice" data-i18n>Both participants must confirm work details before travel.</p> }
else if (task.Status == "assigned" && !JobTypes.ValidSchedule(task.JobType, task.ScheduleText, task.WorkEndUtc)) { <p class="flow-notice" data-i18n>Set a start and expected finish in the work agreement before starting travel.</p> }
else if (task.Status == "assigned" && !OverduePlan.Ready(task, flow.Agreement, jobEvents, item.FreelancerId, flow.Now)) { <p class="flow-notice"><span data-i18n>Review the overdue schedule before travelling.</span> <a href="#overdue-plan-@task.Id" data-i18n>Review schedule</a></p> }
else if (task.Status == "assigned" && !TaskSchedule.TravelOpen(task, DateTime.UtcNow)) { <p class="flow-notice" data-i18n>Travel opens 1 hour before the scheduled arrival time.</p> }
else if (!Model.ProgressUnavailable && !item.IsClient && task.Status is "assigned" or "arrived" or "in-progress") {
var action = task.Status switch { "assigned" => "travel", "on-the-way" => "arrive", "arrived" => "start", _ => "finish" };
var button = action switch { "travel" => "Start travel & share location", "arrive" => "I’ve arrived", "start" => "Start work", _ => "Mark work finished" };
<form method="post" asp-page-handler="Advance" enctype="multipart/form-data" class="tracking-progress-form"><input type="hidden" name="id" value="@task.Id" /><input type="hidden" name="action" value="@action" />
@if (action == "finish") { <partial name="_CompletionOptions" /> }
@if (action == "travel") { <p data-i18n>Allow location access and keep Tracking open while travelling. Sharing stops when you mark your arrival.</p> }
<button type="submit" class="tracking-primary">@button</button></form>
}
@if (!cancellationPending && !Model.ProgressUnavailable && item.IsClient && task.Status == "awaiting-confirmation") { <form method="post" asp-page-handler="Advance"><input type="hidden" name="id" value="@task.Id" /><input type="hidden" name="action" value="confirm" /><button type="submit" class="tracking-primary">Confirm completion</button></form> }
@if (task.Status == "disputed") { <p data-i18n>This older task is paused. Contact support through Safety &amp; Reports.</p> }
@if (task.Status == "cancelled") { <p data-i18n>This task was cancelled.</p> }

<a href="@(item.IsClient ? "/MarketTasks?view=mine" : (task.Status == "completed" ? "/MyJobs?view=completed" : task.Status == "cancelled" ? "/MyJobs?view=closed" : TaskSchedule.IsUpcoming(task, DateTime.UtcNow) ? "/MyJobs?view=scheduled" : "/MyJobs?view=active"))">@(item.IsClient ? "Open My Tasks" : "Open My Jobs")</a>
</div>
<div data-flow-slot="cancellation" data-flow-key="@(flow.Agreement?.Version)-@(jobEvents.LastOrDefault()?.Id)-@CompletionFollowUp.Due(task, jobEvents, flow.Now)-@OverduePlan.Required(task, flow.Now)-@OverduePlan.Expired(task, flow.Now)-@OverduePlan.Ready(task, flow.Agreement, jobEvents, item.FreelancerId, flow.Now)-@JobCancellation.FollowUpDue(jobEvents.LastOrDefault(e => e.Status is TaskProgress.CancellationRequested or TaskProgress.CancellationDeclined), flow.Now)"><partial name="_JobCancellation" model="flow" /></div>
@if (task.Status == "completed")
{
    var canReviewFreelancer = item.FreelancerId > 0 && !await Model.HasReviewAsync(task.Id, !item.IsClient);
    var canReviewCommunity = await Model.CanWriteCommunityReviewAsync();
    if (canReviewFreelancer || canReviewCommunity)
    {
    <section id="completed-reviews" class="tracking-completed-reviews">
        <h4>Leave a review</h4>
@if (canReviewFreelancer) {
    <details class="tracking-review tracking-actions"><summary>@(item.IsClient ? "Review your freelancer" : "Review your client")</summary><form method="post" asp-page="/MarketTasks" asp-page-handler="Review"><input type="hidden" name="id" value="@task.Id" /><input type="hidden" name="fromTracking" value="true" /><partial name="_StarRating" /><label>Feedback (optional)<textarea name="feedback" maxlength="1000" rows="3"></textarea></label><button type="submit" class="tracking-primary">Submit review</button></form></details>
}
        @if (canReviewCommunity)
        {
        <details class="tracking-review tracking-actions">
            <summary>Write a community review</summary>
            <form method="post" asp-page-handler="Feedback" data-submit-pending="Saving…">
                <input type="hidden" name="taskId" value="@task.Id" />
                <p data-i18n>Share your experience using Tap, Task, Done.</p>
                <partial name="_StarRating" />
                <label>Your feedback<textarea name="feedback" maxlength="500" rows="3" required></textarea></label>
                <p data-i18n>Your display name, rating, and feedback will appear on the landing page.</p>
                <button type="submit" class="tracking-primary">Publish community review</button>
            </form>
        </details>
        }
    </section>
    }
}
</section>
                    <aside class="tracking-aside tracking-work-column"><section class="tracking-panel tracking-contact-panel"><h4>@(item.IsClient ? "Freelancer" : "Client")</h4><a asp-page="/ReviewProfile" asp-route-id="@(item.IsClient ? item.FreelancerId : task.ClientId)" asp-route-role="@(item.IsClient ? "freelancer" : "client")" class="tracking-person" data-account-id="@(item.IsClient ? item.FreelancerId : task.ClientId)">@(item.IsClient ? item.Freelancer : item.Client)</a><p data-i18n>Assigned to this task</p>@if (Model.SharedPhones.TryGetValue(task.Id, out var sharedPhone)) { <p class="tracking-shared-phone"><strong>Mobile number</strong> <bdi dir="ltr" style="user-select: all">@sharedPhone</bdi></p> }<div class="tracking-actions"><a href="/Messages?taskId=@task.Id">Message @(item.IsClient ? "freelancer" : "client")</a></div></section><section class="tracking-location"><strong>Task location</strong><span>@(string.IsNullOrWhiteSpace(task.Location) ? "Location not provided" : task.Location)</span>
@if (!string.IsNullOrWhiteSpace(task.ArrivalInstructions))
{
    <div class="tracking-arrival location-arrival-note">
        <strong>Arrival instructions</strong>
        <p>@task.ArrivalInstructions</p>
    </div>
}
<div class="job-location" data-job-location data-task-id="@task.Id" data-viewer-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" data-freelancer="@(!item.IsClient ? "true" : "false")" data-progress-status="@task.Status" data-active="@(task.Status == "on-the-way" ? "true" : "false")" data-address="@task.Location" data-route-url="@(Configuration["Routing:BaseUrl"] ?? (HostEnvironment.EnvironmentName == "Development" ? "https://router.project-osrm.org" : ""))">
<div class="map-place-search" data-map-search><label>Search a place on the map<input maxlength="120" placeholder="Bacolor address or landmark" /></label><button type="button">Search map</button><div class="location-search-results"></div><p role="status" data-i18n>Search only changes your map view. To change the work destination, request changes in Confirm work details.</p></div><div class="job-location-map" data-map aria-label="Task and freelancer location map"></div>
<p class="job-location-status" data-map-status hidden role="status" data-i18n>Loading map…</p>
<p class="job-location-status" data-route-status hidden role="status" data-i18n>Waiting for a destination pin.</p>

<p class="job-location-status" data-location-status hidden role="status" data-i18n>Waiting for a location update.</p>
@if (!item.IsClient && task.Status == "on-the-way") {
<div class="tracking-actions"><button type="button" data-share>Enable location / Try again</button><button type="button" data-stop hidden>Stop sharing</button></div>
<p class="job-location-status" data-sharing-status hidden role="status"></p>
}
<form hidden data-location-token>@Html.AntiForgeryToken()</form>
</div>
</section>
@if (!Model.IsHistory && task.Status == "assigned") {
    var scheduleStatus = TaskSchedule.DisplayStatus(task, DateTime.UtcNow);
    <section class="tracking-schedule-notice work-schedule-notice" data-schedule-status="@scheduleStatus" aria-label="Schedule actions">
        <div class="work-section-heading"><h3 data-i18n>Arrival schedule</h3><span class="work-status" data-status="@scheduleStatus">@scheduleStatus</span></div>
        <p class="work-arrival-time">@TaskSchedule.Display(task.ScheduleText)</p>
        <p data-i18n>The scheduled time is your arrival time. Travel opens 1 hour earlier.</p>
        @if (scheduleStatus is "Due now" or "Schedule overdue") { <p data-i18n>No travel update is recorded. Contact each other to confirm whether work will proceed. Passing the scheduled time does not complete or cancel this job.</p> }
        <div class="tracking-actions"><a href="/Messages?taskId=@task.Id">Message @(item.IsClient ? "freelancer" : "client")</a><a href="#work-details-@task.Id" data-i18n>Request reschedule</a><a href="/Reports?taskId=@task.Id" data-i18n>Report a problem</a></div>
        <div data-flow-slot="plan" data-flow-key="@(flow.Agreement?.Version)-@(jobEvents.LastOrDefault()?.Id)-@CompletionFollowUp.Due(task, jobEvents, flow.Now)-@OverduePlan.Required(task, flow.Now)-@OverduePlan.Expired(task, flow.Now)-@OverduePlan.Ready(task, flow.Agreement, jobEvents, item.FreelancerId, flow.Now)-@JobCancellation.FollowUpDue(jobEvents.LastOrDefault(e => e.Status is TaskProgress.CancellationRequested or TaskProgress.CancellationDeclined), flow.Now)"><partial name="_OverduePlan" model="flow" /></div>
        <p data-i18n>To reschedule, request changes to the work details below. The current schedule stays in effect until both of you confirm the updated version.</p>
    </section>
}
@if (!Model.IsHistory && AgreementRules.Editable(task.Status)) {
    <div id="work-details-@task.Id"><partial name="_WorkAgreement" model="new AgreementView(task, Model.Agreements.GetValueOrDefault(task.Id), Model.Destinations.GetValueOrDefault(task.Id), item.IsClient)" /></div>
}
</aside></div></article>
                }
            </section>
            }

        </main>

    </div>
<script src="~/js/completion-photo.js" asp-append-version="true" defer></script>
<script src="~/js/job-location.js" asp-append-version="true" defer></script>

    <partial name="_TaskHelp" />
</body>
</html>
