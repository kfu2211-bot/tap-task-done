@page
@model tts.Pages.AdminDeletionsModel
@using tts.Data
@{ Layout = null; }
<!doctype html><html lang="en"><head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" asp-append-version="true" /><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Account deletion requests - Admin</title><link rel="stylesheet" href="~/css/login-security.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/account-deletion.css" asp-append-version="true"/><link rel="stylesheet" href="/css/admin-design.css" asp-append-version="true" /><partial name="_AccountTheme" /></head><body class="deletion-embedded">@if (Request.Query.ContainsKey("recordId"))
{
    <p><a href="/Admin#notifications" target="_top">← Back to notifications</a></p>
}<main class="security-page">
<header class="security-page-header"><div><p class="security-eyebrow">ADMIN REVIEW</p><h1>Account deletion requests</h1><p>Check commitments and evidence before approving removal.</p></div></header>
@if(Model.Notice is not null){<p class="security-notice" role="status">@Model.Notice</p>}
<section class="security-card"><h2>Review checklist</h2><p>Check active work, offers, bookings, safety evidence and documented obligations. Reports use free-text targets, so automatic checks cannot identify every case. Resolved historical offenses or low ratings alone are not grounds to block deletion.</p><div class="deletion-actions"><a class="security-return" href="/Admin#users" target="_top">Review users</a><a class="security-return" href="/Admin#reports" target="_top">Review safety reports</a></div><p>Approval authorizes automatic finalization only after at least 72 hours and a fresh database check. Requests with new unresolved items return to On hold.</p></section>
@if(Model.Unavailable){<p class="security-error">Deletion storage is unavailable. Apply the database migration before enabling this workflow.</p>}
else if(Model.Requests.Count==0){<section class="security-card"><h2>No deletion requests</h2><p>Verified requests will appear here.</p></section>}
@foreach(var item in Model.Requests){var r=item.Request;<section class="security-card"><div class="security-section-heading"><h2>@item.Name</h2><span class="security-count">@r.Status</span></div><p>Account #@r.UserId · @item.Email</p><p>Requested @DisplayTime.Philippine(r.RequestedUtc ?? r.UpdatedUtc) PHT · Earliest deletion @DisplayTime.Philippine(r.EligibleUtc ?? r.UpdatedUtc) PHT</p>@if(r.ReviewReason is not null){<p><strong>Latest reason:</strong> @r.ReviewReason</p>}
@if(item.Blockers.Count>0){<div class="deletion-review"><strong>Items requiring resolution</strong><ul>@foreach(var blocker in item.Blockers){<li>@blocker</li>}</ul></div>}else if(r.Status != "deleted"){<p>No automatically linked blockers found. Manual evidence review is still required.</p>}
@if(AccountDeletion.Pending(r.Status)){<form method="post" asp-route-embedded="true"><input type="hidden" name="userId" value="@r.UserId"/><label>Decision reason<textarea name="reason" rows="3" minlength="5" maxlength="1000" required></textarea></label><label class="deletion-check"><input type="checkbox" name="evidenceReviewed" value="true" required/><span>I reviewed the records, safety evidence and documented outstanding obligations for this account.</span></label><div class="deletion-actions"><button name="decision" value="approved" disabled="@(item.Blockers.Count>0)" type="submit">Approve deletion</button><button name="decision" value="held" class="security-secondary" type="submit">Put on hold</button><button name="decision" value="rejected" class="deletion-danger-button" type="submit">Reject request</button></div></form>}
</section>}
@if(Model.History.Count>0){<section class="security-card"><h2>Decision history</h2>@foreach(var e in Model.History){<div class="security-row"><div><strong>Account #@e.UserId · @e.Action</strong><small>@DisplayTime.Philippine(e.CreatedUtc) PHT · @(e.ActorId.HasValue ? $"Actor #{e.ActorId}" : "System final check")</small><p>@e.Reason</p></div></div>}</section>}
</main>
<script>
    if (window.parent !== window) {
        const content = document.querySelector('main');
        const resize = () => window.parent.postMessage({
            type: 'admin-deletions-height',
            height: Math.ceil(content.getBoundingClientRect().bottom + window.scrollY)
        }, location.origin);
        new ResizeObserver(resize).observe(content);
        resize();
    }
</script>
</body></html>
