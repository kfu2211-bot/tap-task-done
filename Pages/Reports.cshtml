@page
@model tts.Pages.ReportsModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Safety & Reports - Tap, Task, Done</title><link rel="stylesheet" href="/css/settings.css" asp-append-version="true" /><link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" /><link rel="stylesheet" href="/css/readability.css" asp-append-version="true" /><link rel="stylesheet" href="/css/report-evidence.css" asp-append-version="true" /><script defer src="/js/sidebar-account.js" asp-append-version="true"></script></head>
<body><div class="settings-layout"><aside class="sidebar"><div class="brand"><span class="brand-icon">✓</span><strong>Tap, Task, Done</strong></div><nav class="sidebar-menu"><a href="/Dashboard"><span class="menu-icon">⌂</span><span>Home</span></a><a href="/FindPost"><span class="menu-icon">⌕</span><span>Find &amp; Post</span></a><a href="/MyTasks"><span class="menu-icon">▤</span><span>My Tasks</span></a><a href="/Messages"><span class="menu-icon">□</span><span>Messages</span></a><a href="/Tracking"><span class="menu-icon">➤</span><span>Tracking</span></a><a href="/Reviews"><span class="menu-icon">☆</span><span>Reviews</span></a></nav><div class="sidebar-account"><span class="account-avatar">U</span><div><strong id="sidebarName">User</strong><span id="sidebarEmail">user@email.com</span></div></div></aside>
<main><header><h1>Safety &amp; Reports</h1></header><section class="settings-content"><div class="page-intro"><h2>Report a safety issue</h2><p>For scams, payment requests outside the app, no-shows, harassment, or work disputes. Reports are saved locally in this prototype.</p></div><form id="reportForm" class="settings-card"><div class="field-grid"><label>Person or provider<input id="reportTarget" required maxlength="80" placeholder="Name of the provider or user" /></label><label>Related task<input id="reportTask" maxlength="100" placeholder="Task title (optional)" /></label><label>Reason<select id="reportReason" required><option value="Scam or fake account">Scam or fake account</option><option value="Payment outside the app">Payment outside the app</option><option value="No-show">No-show</option><option value="Harassment or inappropriate behavior">Harassment or inappropriate behavior</option><option value="Work dispute">Work dispute</option><option value="Other">Other</option></select></label></div><label class="full-field">What happened?<textarea id="reportDescription" required maxlength="1000" placeholder="Describe the issue and include details that can help support review it."></textarea></label><section class="report-evidence" aria-labelledby="evidenceTitle"><div class="evidence-heading"><span class="evidence-icon">▧</span><div><h2 id="evidenceTitle">Add evidence <span>Optional</span></h2><p>Upload screenshots or photos that can help us review your report.</p></div></div><label class="evidence-upload" for="reportEvidence"><span>⇧</span><strong>Choose images</strong><small>JPG, PNG or WEBP · Up to 3 files · 5 MB each</small><input id="reportEvidence" type="file" accept="image/jpeg,image/png,image/webp" multiple /></label><div id="evidencePreview" class="evidence-preview" aria-live="polite"></div></section><button class="primary-button" type="submit">Submit report</button><p id="reportSavedMessage" class="form-message" aria-live="polite"></p></form><section class="settings-card"><h2>Your report history</h2><div id="reportHistory" class="report-history"></div></section></section></main></div><script src="/js/reports.js"></script></body></html>
