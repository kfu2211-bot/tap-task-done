@page
@model tts.Pages.IdentityVerificationModel
@{ Layout = null; }
<!DOCTYPE html><html lang="en"><head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" /><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Identity Verification - Tap, Task, Done</title>
<link rel="stylesheet" href="/css/identity-verification.css" asp-append-version="true" /><link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" /><link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" /><link rel="stylesheet" href="/css/identity-polish.css" asp-append-version="true" /><script defer src="/js/sidebar-account.js" asp-append-version="true"></script><link rel="stylesheet" href="/css/sidebar-consistency.css" asp-append-version="true" />
</head>
<body><div class="verification-page"><aside class="sidebar"><div class="sidebar-logo"><div class="mini-logo">✓</div><span>Tap, Task, Done</span></div><nav class="navigation"><a href="/Dashboard" class="nav-item"><span class="nav-icon">⌂</span><span>Home</span></a><a href="/FindPost" class="nav-item"><span class="nav-icon">⌕</span><span>Find &amp; Post</span></a><a href="/MyTasks" class="nav-item"><span class="nav-icon">▤</span><span>My Tasks</span></a><a href="/Messages" class="nav-item"><span class="nav-icon">□</span><span>Messages</span></a><a href="/IdentityVerification" class="nav-item active"><span class="nav-icon">✓</span><span>Identity Verification</span></a><a href="/Tracking" class="nav-item"><span class="nav-icon">➤</span><span>Tracking</span></a><a href="/Reviews" class="nav-item"><span class="nav-icon">☆</span><span>Reviews</span></a></nav><div class="sidebar-user"><div class="user-avatar" id="sidebarAvatar">U</div><div class="user-info"><strong id="sidebarName">User</strong><small id="sidebarEmail"></small></div></div></aside>
<main class="main-content"><header class="topbar"><h1>Identity Verification</h1></header><div class="content"><div class="page-heading"><span class="identity-eyebrow">TRUST &amp; SAFETY</span><h2>Verify your identity</h2><p>Submit your documents to help keep Tap, Task, Done safe and trusted.</p></div>
@if (!string.IsNullOrEmpty(Model.Notice)) { <p class="identity-notice" role="status">@Model.Notice</p> }
<section class="status-card"><div class="status-icon">!</div><div class="status-text"><strong>@Model.Status.ToUpperInvariant()</strong><p>@(Model.Status == "pending" ? "Your submission is waiting for review." : Model.Status == "approved" ? "Your identity has been verified." : Model.Status == "rejected" ? "Your submission was not approved. You may submit again." : "Your identity has not been verified yet.")</p>@if (!string.IsNullOrWhiteSpace(Model.ReviewNote)) { <p>Admin note: @Model.ReviewNote</p> }</div></section>
@if (Model.Status != "pending" && Model.Status != "approved") { <section class="verification-card"><div class="card-heading"><h3>Identity Documents</h3><p>Upload clear and readable copies of your documents.</p></div><form method="post" enctype="multipart/form-data"><div class="document-row"><div class="document-info"><div class="document-title"><strong>Valid Government ID</strong><span class="required">Required</span></div><p>Upload a valid government-issued identification card.</p></div><div class="upload-area"><input type="file" id="governmentId" name="governmentId" accept=".jpg,.jpeg,.png,.pdf" required /><small>JPG, PNG or PDF · Max. 5MB</small></div></div><div class="id-number-section"><label for="idNumber">ID Number <span>Required</span></label><input type="text" id="idNumber" name="idNumber" minlength="4" maxlength="50" required placeholder="Enter your government ID number" /><small>Only the last four characters are saved.</small></div><div class="document-row"><div class="document-info"><div class="document-title"><strong>Certification</strong><span class="optional">Optional</span></div><p>Upload a professional or relevant certification.</p></div><div class="upload-area"><input type="file" name="certification" aria-label="Certification" accept=".jpg,.jpeg,.png,.pdf" /><small>JPG, PNG or PDF · Max. 5MB</small></div></div><div class="document-row"><div class="document-info"><div class="document-title"><strong>Other Supporting Document</strong><span class="optional">Optional</span></div><p>Upload another document that may support your verification.</p></div><div class="upload-area"><input type="file" name="supportingDocument" aria-label="Other supporting document" accept=".jpg,.jpeg,.png,.pdf" /><small>JPG, PNG or PDF · Max. 5MB</small></div></div><div class="submit-area"><button type="submit">Submit for Verification</button></div></form></section> }
@if (Model.IsDevelopment) { <p class="page-note">Use test documents only while this feature is being tested locally.</p> }</div></main></div></body></html>
