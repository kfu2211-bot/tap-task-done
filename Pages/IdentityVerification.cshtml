@page
@model tts.Pages.IdentityVerificationModel
@{ Layout = null; }
<!DOCTYPE html><html lang="en"><head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" /><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Identity Verification - Tap, Task, Done</title>
<link rel="stylesheet" href="/css/identity-verification.css" asp-append-version="true" /><link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" /><link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" /><link rel="stylesheet" href="/css/identity-polish.css" asp-append-version="true" /><script defer src="/js/sidebar-account.js" asp-append-version="true"></script>
    <script defer src="/js/profile-photo.js" asp-append-version="true"></script><link rel="stylesheet" href="/css/sidebar-consistency.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/workspace-spacing.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/identity-selfie.css" asp-append-version="true" /><script defer src="/js/identity-face-visibility.js" asp-append-version="true"></script><script defer src="/js/identity-face-guide.js" asp-append-version="true"></script><script defer src="/js/identity-selfie.js" asp-append-version="true"></script><link rel="stylesheet" href="/css/identity-workspace.css" asp-append-version="true" /><partial name="_AccountTheme" /></head>
<body><div class="verification-page"><aside class="sidebar"><a class="sidebar-logo" asp-page="/Landing" aria-label="Tap, Task, Done landing page" style="text-decoration:none"><div class="mini-logo">✓</div><span>Tap, Task, Done</span></a><nav class="navigation"><a href="/Dashboard" class="nav-item"><span class="nav-icon">⌂</span><span>Home</span></a><a href="/FindPost" class="nav-item"><span class="nav-icon">⌕</span><span>Find &amp; Post</span></a><a href="/MyTasks" class="nav-item"><span class="nav-icon">▤</span><span>My Tasks</span></a><a href="/Messages" class="nav-item"><span class="nav-icon">□</span><span>Messages</span></a><a href="/IdentityVerification" class="nav-item active"><span class="nav-icon">✓</span><span>Identity Verification</span></a><a href="/Tracking" class="nav-item"><span class="nav-icon">➤</span><span>Tracking</span></a><a href="/Reviews" class="nav-item"><span class="nav-icon">☆</span><span>Reviews</span></a></nav><div class="sidebar-user"><div class="user-avatar" id="sidebarAvatar">U</div><div class="user-info"><strong id="sidebarName">User</strong><small id="sidebarEmail"></small></div></div></aside>
<main class="main-content"><header class="topbar"><h1>Identity Verification</h1></header><div class="content"><div class="page-heading"><span class="identity-eyebrow">TRUST &amp; SAFETY</span><h2>Verify your identity</h2><p>Submit your documents to help keep Tap, Task, Done safe and trusted.</p></div>
@if (!string.IsNullOrEmpty(Model.Notice)) { <p class="identity-notice" role="status">@Model.Notice</p> }
<section class="status-card @(Model.Status == "approved" ? "status-approved" : "")"><div class="status-icon" aria-hidden="true">@(Model.Status == "approved" ? "✓" : "!")</div><div class="status-text"><strong>@Model.Status.ToUpperInvariant()</strong><p>@(Model.Status == "pending" ? "Your submission is waiting for review." : Model.Status == "approved" ? "Your identity has been verified." : Model.Status == "resubmit" ? "Please submit your ID and a new selfie again. See the admin note below." : Model.Status == "rejected" ? "Your submission was not approved. You may submit again." : "Your identity has not been verified yet.")</p>@if (!string.IsNullOrWhiteSpace(Model.ReviewNote)) { <p>Admin note: @Model.ReviewNote</p> }</div></section>
@if (Model.Status != "pending" && Model.Status != "approved") { <div class="identity-workspace"><section class="verification-card"><div class="card-heading">
    <h3>Identity Documents</h3>
    <p>Upload clear and readable copies of your documents.</p>
</div>
<form id="identityForm" method="post" enctype="multipart/form-data">
    <input type="hidden" id="idCheckToken" name="idCheckToken" value="" />
    <input type="hidden" name="captureToken" value="@Model.CaptureToken" />
    <input type="hidden" id="captureSteps" value="@Model.CaptureSteps" />
    <div id="captureFiles" hidden></div>
    <div class="identity-id-fields">
        <div class="id-number-section">
            <label for="documentType">Government photo ID type <span>Required</span></label>
            <select id="documentType" name="documentType" required>
                <option value="" selected disabled hidden>Select your ID type</option>
                @foreach (var type in tts.Data.IdentityDocumentTypes.Accepted)
                {
                    <option value="@type">@type</option>
                }
            </select>
            <small>Select the type that matches your document. File acceptance does not establish document authenticity; an admin reviews the ID and selfie.</small>
        </div>
        <div class="id-number-section">
            <label for="idNumber">ID Number <span>Required</span></label>
            <input type="text" id="idNumber" name="idNumber" minlength="4" maxlength="50" pattern="[A-Za-z0-9 \-]{4,50}" title="Use the letters and digits printed on your ID. Spaces and hyphens are allowed." required autocomplete="off" spellcheck="false" aria-describedby="idNumberHelp" placeholder="Enter your government ID number" />
            <small id="idNumberHelp">Enter the full number beside the ID-number label on your document. We automatically read the upload and block numbers that do not match. Your full number is encrypted for admin review.</small>
        </div>
    </div>
    <div class="document-row">
        <div class="document-info">
            <div class="document-title"><strong>Valid Government ID</strong><span class="required">Required</span></div>
            <p>Upload a valid government-issued identification card.</p>
        </div>
        <div class="upload-area">
            <input type="file" id="governmentId" name="governmentId" accept=".jpg,.jpeg,.png,.pdf" aria-label="Upload government ID" aria-describedby="governmentIdHelp" required />
            <small id="governmentIdHelp">JPG, PNG or PDF · Max. 5MB</small>
        </div>
    </div>
<div class="document-row"><div class="document-info"><div class="document-title"><strong>Certification</strong><span class="optional">Optional</span></div><p>Upload a professional or relevant certification.</p></div><div class="upload-area"><input type="file" name="certification" aria-label="Certification" accept=".jpg,.jpeg,.png,.pdf" /><small>JPG, PNG or PDF · Max. 5MB</small></div></div><div class="document-row"><div class="document-info"><div class="document-title"><strong>Other Supporting Document</strong><span class="optional">Optional</span></div><p>Upload another document that may support your verification.</p></div><div class="upload-area"><input type="file" name="supportingDocument" aria-label="Other supporting document" accept=".jpg,.jpeg,.png,.pdf" /><small>JPG, PNG or PDF · Max. 5MB</small></div></div><section class="selfie-section" aria-labelledby="selfieHeading">
<h3 id="selfieHeading">Selfie verification <span class="required">Required</span></h3>
<ul class="selfie-requirements" aria-label="Before taking your selfie"><li>No glasses or mask</li><li>Full face visible</li><li>Good lighting</li></ul>
<p class="selfie-short-guide">Follow the circle and turn your head when prompted.</p>
<label class="selfie-consent"><input type="checkbox" name="consent" value="true" id="selfieConsent" required /> <span>I agree to encrypted storage of my ID, full ID number and face photos for admin review.</span></label>
<details class="selfie-privacy"><summary>Privacy &amp; storage details</summary><p>Your ID, full number, selfie and movement photos are accessible to authorized admins for review. They are removed 30 days after review while the service is running. The decision, last four ID characters and consent record are retained.</p><p>Automatic checks can make mistakes and do not establish document authenticity. An admin reviews your ID and face photos before approval.</p></details>
<div class="selfie-camera" id="selfieCamera" hidden><div class="selfie-frame"><video id="selfieVideo" autoplay muted playsinline hidden></video><img id="selfiePreview" alt="Your captured selfie" hidden /><div class="selfie-guide" aria-hidden="true"></div><span id="faceTarget" class="face-target" aria-hidden="true"></span></div><p class="selfie-frame-hint" id="faceInstruction" role="status" aria-live="polite">Center your face in the circle</p><progress id="faceProgress" max="5" value="0" aria-label="Camera movements completed"></progress><p id="faceStepCount">0 of 5 movements completed</p><button type="button" id="restartFaceGuide">Restart movements</button></div>
<input type="file" name="selfie" id="selfieFile" accept="image/jpeg,image/png" hidden />
<p id="idCheckMessage" class="id-check-status" data-state="neutral" role="status" aria-live="polite">Check your ID details first, then open the camera.</p>
<div class="selfie-actions"><button type="button" id="checkIdDetails">Check ID details</button><button type="button" id="openCamera">Open camera</button><button type="button" id="captureSelfie" hidden disabled>Capture selfie</button><button type="button" id="retakeSelfie" hidden>Retake</button></div>
<p id="selfieMessage" role="status" aria-live="polite"></p>
</section>
<div class="submit-area"><button type="button" id="reviewIdentity">Review submission</button></div>
<section id="identityReview" class="selfie-section" hidden><h3>Review your submission</h3><p>Check that your ID photo and selfie are clear. Retake your selfie if it is blurry, too dark, or shows glasses or a face mask. Optional attachments will be included.</p><div id="idPreview"></div><p id="reviewSummary"></p><div class="selfie-actions"><button type="button" id="editIdentity">Back to edit</button><button type="submit" id="submitIdentity">Submit for verification</button></div></section>
<noscript><p>Enable JavaScript to capture a selfie and review your submission.</p></noscript></form></section>
<aside class="identity-guide" aria-labelledby="identityGuideTitle">
    <h3 id="identityGuideTitle">Before you submit</h3>
    <ol>
        <li><strong>Prepare your government photo ID</strong><p>Choose the matching ID type and make sure the document is readable.</p></li>
        <li><strong>Take a clear selfie</strong><p>Use good lighting and keep your full face visible.</p></li>
        <li><strong>Review and submit</strong><p>Check your files and selfie. An admin will review your submission and update your status here.</p></li>
    </ol>
</aside></div> }
@if (Model.IsDevelopment) { <p class="page-note">Use test documents only while this feature is being tested locally.</p> }</div></main></div>
    <partial name="_TaskHelp" />
</body></html>
