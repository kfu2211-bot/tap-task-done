@page
@model tts.Pages.SecurityModel
@using tts.Data
@{ Layout = null; }
<!DOCTYPE html><html lang="en"><head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" asp-append-version="true" /><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Account security - Tap, Task, Done</title><link rel="stylesheet" href="~/css/login-security.css" asp-append-version="true"/><script src="~/js/login-security-alert.js" asp-append-version="true" defer></script><link rel="stylesheet" href="~/css/security-workspace.css" asp-append-version="true"/><partial name="_AccountTheme" /></head><body><main class="security-page"><header class="security-page-header"><div><p class="security-eyebrow">YOUR ACCOUNT</p><h1>Security &amp; devices</h1><p>Manage your sign-ins, active sessions and trusted browsers.</p></div><a class="security-return" href="@Model.SettingsUrl">Back to Settings</a></header><p class="security-device-note">Device names are browser estimates. Review any activity you don't recognize.</p>@if(Model.Notice is not null) { <p role="status" class="security-notice">@Model.Notice</p> }
<div class="security-workspace"><section class="security-card"><div class="security-section-heading"><h2>Active sessions</h2><span class="security-count">@Model.Sessions.Count active</span></div><p>Enter your current password when signing out a session. Signing out sessions also clears trusted browsers.</p>@foreach(var session in Model.Sessions) { <div class="security-row"><div class="security-device-details"><svg class="security-device-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M12 17v4m-5 0h10"/></svg><strong>@session.Device</strong>@if(session.Id == Model.CurrentId) { <span class="security-badge">This device</span> }<small>Signed in @DisplayTime.Philippine(session.CreatedUtc) · Last active @DisplayTime.Philippine(session.LastSeenUtc)</small></div><form method="post" asp-page-handler="Manage"><input type="hidden" name="action" value="revoke"/><input type="hidden" name="id" value="@session.Id"/><label class="sr-label">Current password<input name="CurrentPassword" type="password" autocomplete="current-password" maxlength="256" placeholder="Current password" required/></label><button type="submit">Sign out</button></form></div> }<form class="security-other-sessions" method="post" asp-page-handler="Manage"><input type="hidden" name="action" value="others"/><label>Current password<input name="CurrentPassword" type="password" autocomplete="current-password" maxlength="256" required/></label><button type="submit">Sign out all other devices</button></form></section>
<section class="security-card"><div class="security-section-heading"><h2>Recent sign-ins</h2><span class="security-count">@Model.Alerts.Count recent</span></div><p>A successful sign-in creates an alert here and in Notifications.</p><div class="security-alert-list" role="region" aria-label="Sign-in activity" tabindex="0">@foreach(var alert in Model.Alerts) { <div class="security-row"><div class="security-device-details"><svg class="security-device-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M12 17v4m-5 0h10"/></svg><strong>@alert.Device</strong><small>@DisplayTime.Philippine(alert.CreatedUtc) · @(alert.EmailSent ? "Email alert sent" : "Email alert could not be delivered")</small></div><form method="post" asp-page-handler="Read"><input type="hidden" name="id" value="@alert.Id"/><button type="submit" class="security-secondary" disabled="@(alert.ReadUtc is not null)">@(alert.ReadUtc is null ? "Yes, this was me" : "Reviewed")</button></form><a href="#secure-account">Secure account</a></div> }</div></section></div>
<section class="security-card"><div class="security-section-heading"><h2>Trusted browsers</h2><span class="security-count">@Model.Devices.Count trusted</span></div><p>Trusted browsers can skip the email code for up to 30 days. Removing trust does not sign out an existing session.</p>@foreach(var device in Model.Devices) { <div class="security-row"><div><strong>@device.Device</strong><small>Trusted until @DisplayTime.Philippine(device.ExpiresUtc)</small></div><form method="post" asp-page-handler="Manage"><input type="hidden" name="action" value="forget"/><input type="hidden" name="id" value="@device.Id"/><label>Current password<input name="CurrentPassword" type="password" autocomplete="current-password" maxlength="256" required/></label><button type="submit">Remove trust</button></form></div> }</section>
<section id="secure-account" class="security-card security-recovery"><h2>Secure my account</h2><p>Change your password, sign out every session including this one, and remove all trusted browsers. You will need a new email code to sign in.</p><form method="post" asp-page-handler="Manage"><input type="hidden" name="action" value="secure"/><label>Current password<input asp-for="CurrentPassword" type="password" autocomplete="current-password" maxlength="256" required/></label><label>New password<input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="8" maxlength="256" required/></label><label>Confirm new password<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="256" required/></label><button type="submit">Change password &amp; sign out all devices</button></form><p><a href="/ForgotPassword">Forgot your current password?</a></p></section></main>
    @if (User.Identity?.AuthenticationType != "AdminCookie") { <partial name="_TaskHelp" /> }
</body></html>
