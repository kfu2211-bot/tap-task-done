@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Something went wrong</h1>
<p>We couldn't complete your request. Please try again in a moment.</p>
<p>If the problem continues, contact support and include the request ID below, if shown.</p>

<p>
    <a asp-page="/Index" class="btn btn-primary">Return to home</a>
</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

