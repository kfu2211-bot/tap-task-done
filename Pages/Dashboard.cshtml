                            <div class="provider-top">

                                <div class="provider-avatar">
                                    Da
                                </div>

                                <div class="provider-name">

                                    <strong>
                                        Dante
                                    </strong>

                                    <span>
                                        Electrician
                                    </span>

                                </div>

                            </div>


                            <div class="provider-stats">

                                <span class="rating">
                                    ★ 4.7
                                    <small>
                                        (288)
