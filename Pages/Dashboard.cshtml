                                </span>

                                <span>
                                    132 jobs
                                </span>

                            </div>


                            <div class="provider-bottom">

                                <span>
                                    ₱750 / task
                                </span>

                                <button type="button">
                                    Book
                                </button>

                            </div>

                        </div>


                        <!-- PROVIDER 4 -->

                        <div class="provider-card">

                            <div class="provider-top">

                                <div class="provider-avatar">
                                    Le
                                </div>

                                <div class="provider-name">

                                    <strong>
                                        Lea
                                    </strong>

                                    <span>
                                        Errand Runner
