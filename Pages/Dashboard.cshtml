@page
@model DashboardModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head><script defer src="/js/freelancer-home-summary.js" asp-append-version="true"></script><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" />

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Home - Tap, Task, Done</title>

    <link rel="stylesheet"
          href="/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/readability.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/light-home.css" asp-append-version="true" />
    <script defer src="/js/sidebar-account.js" asp-append-version="true"></script>
    <script defer src="/js/profile-photo.js" asp-append-version="true"></script>
    <script defer src="/js/provider-status.js" asp-append-version="true"></script>

<link rel="stylesheet" href="/css/sidebar-consistency.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/workspace-spacing.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/client-workspace.css" asp-append-version="true" />
<partial name="_AccountTheme" /><script defer src="/js/home-service-photos.js" asp-append-version="true"></script></head>

<body class="dashboard-body @(Model.FreelancerOnly ? "freelancer-home" : "client-workspace client-home")">

    <div class="dashboard">

        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="sidebar">

            <!-- LOGO -->

            <a class="sidebar-logo" asp-page="/Landing" aria-label="Tap, Task, Done landing page" style="text-decoration:none">

                <div class="mini-logo">
                    ✓
                </div>

                <span>
                    Tap, Task, Done
                </span>

            </a>


            <!-- NAVIGATION -->

            <nav class="navigation" data-home-view="@(Model.FreelancerOnly ? "freelancer" : "client")" aria-label="Workspace navigation">

                <a asp-page="/Dashboard"
                   class="nav-item active">

                    <span class="nav-icon">
                        ⌂
                    </span>

                    <span>
                        Home
                    </span>

                </a>


                <a asp-page="/FindPost"
                   class="nav-item">

                    <span class="nav-icon">
                        ⌕
                    </span>

                    <span>
                        Find &amp; Post
                    </span>

                </a>


                <a asp-page="/MyTasks"
                   class="nav-item">

                    <span class="nav-icon">
                        ▤
                    </span>

                    <span>
                        My Tasks
                    </span>

                </a>


                <!-- MESSAGES - CONNECTED -->

                <a asp-page="/Messages"
                   class="nav-item">

                    <span class="nav-icon">
                        □
                    </span>

                    <span>
                        Messages
                    </span>

                </a>


                <a href="/IdentityVerification"
                   class="nav-item">

                    <span class="nav-icon">
                        ✓
                    </span>

                    <span>
                        Identity Verification
                    </span>

                </a>


                <!-- TRACKING - CONNECTED -->

                <a asp-page="/Tracking"
                   class="nav-item">

                    <span class="nav-icon">
                        ➤
                    </span>

                    <span>
                        Tracking
                    </span>

                </a>


                <!-- REVIEWS - CONNECTED -->

                <a asp-page="/Reviews"
                   class="nav-item">

                    <span class="nav-icon">
                        ☆
                    </span>

                    <span>
                        Reviews
                    </span>

                </a>

                <a href="/Reports"
                   class="nav-item">

                    <span class="nav-icon">
                        ⚑
                    </span>

                    <span>
                        Safety &amp; Reports
                    </span>

                </a>

            </nav>


            <!-- =================================================
                 USER PROFILE BUTTON
            ================================================== -->

            <div class="sidebar-user"
                 id="openProfile"
                 role="button"
                 tabindex="0">

                <div class="user-avatar"
                     id="sidebarAvatar">

                    JD

                </div>


                <div class="user-info">

                    <strong id="sidebarName">
                        Jordan Dela Cruz
                    </strong>

                    <small id="sidebarEmail">
                        jordan@gmail.com
                    </small>

                </div>


                <div class="user-menu">
                    ⋮
                </div>

            </div>

        </aside>


        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->

        <main class="main-content">
            @if (TempData["RegistrationSuccess"] is string registrationSuccess)
            {
                <p role="status" class="dashboard-registration-success">@registrationSuccess</p>
            }


            <!-- TOPBAR -->

            <header class="topbar home-topbar">

                <h1>
                    Home
                </h1>


                <button class="notification app-notification-trigger"
                        type="button"
                        aria-label="Notifications">

                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-2 7-2 9h16c0-2-2-2-2-9M10 20h4"/></svg>

                </button>

                @if (Model.CanSwitchView)
                {
                    <nav class="home-view-switch" aria-label="Home view">
                        <a asp-page="/Dashboard" asp-route-view="client" aria-current="@(!Model.FreelancerOnly ? "page" : null)">Client</a>
                        <a asp-page="/Dashboard" asp-route-view="freelancer" aria-current="@(Model.FreelancerOnly ? "page" : null)">Freelancer</a>
                    </nav>
                }
            </header>


            <!-- CONTENT -->

            <div class="content">


                <!-- =================================================
                     SEARCH
                ================================================== -->


                <!-- =================================================
                     HERO
                ================================================== -->

                <section class="hero-card home-banner">
                    <div class="home-service-photos" aria-label="Featured services">
                        <div class="home-service-slide is-current" data-service="cleaning" aria-hidden="true"></div>
                        <div class="home-service-slide" data-service="repairs" aria-hidden="true"></div>
                        <div class="home-service-slide" data-service="gardening" aria-hidden="true"></div>
                        <div class="home-service-slide" data-service="moving" aria-hidden="true"></div>
                        <div class="home-service-slide" data-service="errands" aria-hidden="true"></div>

                        <div class="home-service-slide" data-service="painting" aria-hidden="true"></div>

                        <div class="home-service-slide" data-service="tutoring" aria-hidden="true"></div>

                        <div class="home-service-slide" data-service="pet-care" aria-hidden="true"></div>
                        <div class="home-service-controls">
                            <span class="home-service-category">Cleaning</span>
                            <button type="button" class="home-service-toggle" hidden>Pause</button>
                        </div>
                    </div>
                        <span class="client-location"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>@tts.Data.TaskLocationRules.PublicArea</span>

                    <div class="hero-text">



                        @if (Model.FreelancerOnly)
                        {
                            <h2>Find your next job</h2>
                            <p>Browse available tasks in Bacolor, Pampanga, and keep your jobs and availability up to date.</p>
                            <div class="hero-buttons">
                                <a class="post-button" href="/FindPost?mode=jobs"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>Find Jobs</a>
                                <a class="find-button" href="/MyJobs"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18"/></svg>My Jobs</a>
                            </div>
                        }
                        else
                        {
                        <h2>Manage your tasks</h2>

                        <p>
                            Post local service needs, review offers, and keep your bookings on track with trusted freelancers in Bacolor, Pampanga.
                        </p>


                        <div class="hero-buttons">

                            <button class="post-button"
                                    type="button"
                                    onclick="window.location.href='/FindPost?mode=post';">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M12 7v10M7 12h10"/></svg>
                                Post a task

                            </button>


                            <button class="find-button"
                                    type="button"
                                    onclick="window.location.href='/FindPost?mode=freelancer';">

                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2z"/></svg>

                                Find a Freelancer

                            </button>

                        </div>

                        }
                    </div>

                </section>


                @{
                    var labels = Model.FreelancerOnly
                        ? new[] { "Pending offers", "Active jobs", "Completed jobs" }
                        : new[] { "Needs confirmation", "New offers", "Active bookings" };
                }
                <section class="home-overview" aria-label="Work overview" data-freelancer-summary="@(Model.FreelancerOnly ? Url.Page("/Dashboard", "FreelancerSummary") : null)">
                    @{ var jobViews = new[] { "offers&pending=1", "active", "completed" }; }
                    @for (var i = 0; i < labels.Length; i++)
                    {
                        <a class="home-metric" href="@(Model.FreelancerOnly ? "/MyJobs?view=" + jobViews[i] : "/MarketTasks?view=mine")">
                            <span class="home-symbol" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    @if (i == 0 && !Model.FreelancerOnly) { <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/> }
                                    else if ((i == 1 && !Model.FreelancerOnly) || (i == 0 && Model.FreelancerOnly)) { <path d="M3 4h8l10 10-7 7L3 10z"/><circle cx="7.5" cy="8" r=".6"/> }
                                    else if (i == 2 && Model.FreelancerOnly) { <circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/> }
                                    else { <rect x="4" y="6" width="16" height="15" rx="2"/><path d="M8 3v6m8-6v6M4 11h16"/> }
                                </svg>
                            </span>
                            <span class="home-metric-copy"><span>@labels[i]</span><strong>@(Model.SummaryUnavailable ? "Unavailable" : Model.Summary[i].ToString())</strong></span>
                            <span aria-hidden="true">›</span>
                        </a>
                    }
                </section>

                @if (!Model.FreelancerOnly)
                {
                    <section class="section home-panel" id="home-tasks">
                        <div class="home-panel-heading"><h3>My Tasks</h3><a href="/MarketTasks?view=mine">View all tasks ›</a></div>
                        <nav class="home-filters" aria-label="Filter recent tasks">
                            @foreach (var (key, label, count) in new[] { ("all", "All", Model.TaskCounts[0]), ("confirm", "Needs confirmation", Model.TaskCounts[1]), ("scheduled", "Scheduled", Model.TaskCounts[4]), ("active", "Active", Model.TaskCounts[2]), ("completed", "Completed", Model.TaskCounts[3]) })
                            {
                                <a asp-page="/Dashboard" asp-route-view="@(Model.CanSwitchView ? "client" : null)" asp-route-filter="@key" asp-fragment="home-tasks" aria-current="@(Model.TaskFilter == key ? "page" : null)">@label@if (!Model.SummaryUnavailable) { <text> (@count)</text> }</a>
                            }
                        </nav>
                        @if (Model.RecentTasks.Count == 0)
                        {
                            <p>@(Model.SummaryUnavailable ? "Tasks are temporarily unavailable." : "No tasks in this view yet.")</p>
                        }
                        @foreach (var item in Model.RecentTasks)
                        {
                            <a class="home-task-row" href="/MarketTasks?view=mine#task-@item.Task.Id">
                                <span class="home-row-copy"><strong>@item.Task.Title</strong><small>@item.Task.Category @if (!string.IsNullOrWhiteSpace(item.Task.ScheduleText)) { <text> · @item.Task.ScheduleText</text> } · @item.Offers pending offer@(item.Offers == 1 ? "" : "s")</small></span>
                                <strong class="home-budget">@item.Task.BudgetDisplay</strong>
                                <span class="home-status" data-status="@item.Task.Status">@tts.Data.TaskSchedule.DisplayStatus(item.Task, DateTime.UtcNow)</span>
                                <span aria-hidden="true">›</span>
                            </a>
                        }
                    </section>
                }
                @if (!Model.FreelancerOnly)
                {
                <section class="section dashboard-categories-section">

                    <div class="section-title">

                        <div>

                            <h3>
                                Browse categories
                            </h3>

                            <p>
                                Explore services and find available freelancers. Scroll over the cards or swipe to see more.
                            </p>

                        </div>

                    </div>


                    <div class="category-carousel">
                    <div class="category-grid" id="categoryList" tabindex="0" aria-label="Service categories">


                        <!-- CLEANING -->

                        <a class="category-card" href="/FindPost?category=Cleaning">

                            <span class="category-illustration" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 3h5v3h-5zM15 6v3l-3 3v8h8V10l-2-1V6M12 14h8M15 3V2h-3"/></svg></span>

                            <h4>
                                Cleaning
                            </h4>

                            <p>
                                Homes, offices &amp; deep cleans
                            </p>

                            <strong>
                                @(Model.CategoriesUnavailable ? "Availability unavailable" : $"{Model.CategoryCounts.GetValueOrDefault("Cleaning")} available")
                            </strong>

                        </a>


                        <!-- REPAIRS -->

                        <a class="category-card" href="/FindPost?category=Repairs">

                            <span class="category-illustration" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 6a5 5 0 0 0-6 6L3 17l4 4 5-5a5 5 0 0 0 6-6l-3 3-3-3z"/></svg></span>

                            <h4>
                                Repairs
                            </h4>

                            <p>
                                Plumbing, electrical &amp; fixes
                            </p>

                            <strong>
                                @(Model.CategoriesUnavailable ? "Availability unavailable" : $"{Model.CategoryCounts.GetValueOrDefault("Repairs")} available")
                            </strong>

                        </a>


                        <!-- ERRANDS -->

                        <a class="category-card" href="/FindPost?category=Errands">

                            <span class="category-illustration" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 4h2l2 11h11l3-8H6M9 20h.01M18 20h.01"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg></span>

                            <h4>
                                Errands
                            </h4>

                            <p>
                                Deliveries, groceries &amp; queues
                            </p>

                            <strong>
                                @(Model.CategoriesUnavailable ? "Availability unavailable" : $"{Model.CategoryCounts.GetValueOrDefault("Errands")} available")
                            </strong>

                        </a>


                        <!-- MOVING -->

                        <a class="category-card" href="/FindPost?category=Moving">

                            <span class="category-illustration" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10M7 5l9 4"/></svg></span>

                            <h4>
                                Moving
                            </h4>

                            <p>
                                Packing, hauling &amp; assembly
                            </p>

                            <strong>
                                @(Model.CategoriesUnavailable ? "Availability unavailable" : $"{Model.CategoryCounts.GetValueOrDefault("Moving")} available")
                            </strong>

                        </a>

                        <a class="category-card" href="/FindPost?category=Gardening"><span class="category-illustration" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 4C12 4 5 7 5 14a5 5 0 0 0 5 5c7 0 10-7 10-15zM4 21c3-5 6-8 11-11"/></svg></span><h4>Gardening</h4><p>Garden care, plants &amp; landscaping</p><strong>@(Model.CategoriesUnavailable ? "Availability unavailable" : $"{Model.CategoryCounts.GetValueOrDefault("Gardening")} available")</strong></a>
                        <a class="category-card" href="/FindPost?category=Painting"><span class="category-illustration" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="14" height="7" rx="1"/><path d="M17 6h3v6h-8v2M10 14h4v7h-4z"/></svg></span><h4>Painting</h4><p>Walls, rooms &amp; touch-ups</p><strong>@(Model.CategoriesUnavailable ? "Availability unavailable" : $"{Model.CategoryCounts.GetValueOrDefault("Painting")} available")</strong></a>
                        <a class="category-card" href="/FindPost?category=Tutoring"><span class="category-illustration" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 6c-2-2-5-2-9-1v13c4-1 7-1 9 1m0-13c2-2 5-2 9-1v13c-4-1-7-1-9 1m0-13v13"/></svg></span><h4>Tutoring</h4><p>Lessons, homework &amp; study support</p><strong>@(Model.CategoriesUnavailable ? "Availability unavailable" : $"{Model.CategoryCounts.GetValueOrDefault("Tutoring")} available")</strong></a>
                        <a class="category-card" href="/FindPost?category=Pet%20Care"><span class="category-illustration" aria-hidden="true"><svg viewBox="0 0 24 24"><ellipse cx="6" cy="8" rx="2" ry="2.5"/><ellipse cx="11" cy="5" rx="2" ry="2.5"/><ellipse cx="16" cy="6" rx="2" ry="2.5"/><ellipse cx="20" cy="10" rx="2" ry="2.5"/><path d="M7 18c0-3 3-6 5-6s5 3 5 6c0 2-2 3-5 2-3 1-5 0-5-2z"/></svg></span><h4>Pet Care</h4><p>Pet sitting, walks &amp; care</p><strong>@(Model.CategoriesUnavailable ? "Availability unavailable" : $"{Model.CategoryCounts.GetValueOrDefault("Pet Care")} available")</strong></a>
                        <a class="category-card" href="/FindPost?category=Others"><span class="category-illustration" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12h.01M12 12h.01M16 12h.01"/><circle cx="8" cy="12" r=".5"/><circle cx="12" cy="12" r=".5"/><circle cx="16" cy="12" r=".5"/></svg></span><h4>Others</h4><p>Unique skills &amp; other services</p><strong>@(Model.CategoriesUnavailable ? "Availability unavailable" : $"{Model.CategoryCounts.GetValueOrDefault("Others")} available")</strong></a>
                    </div>
                    </div>

                </section>
                }


                <!-- =================================================
                     TOP SERVICE PROVIDERS
                ================================================== -->

                @if (!Model.FreelancerOnly)
                {
                <section class="section providers-section">


                    <div class="providers-heading">

                        <div>

                            <h3>
                                Top service providers
                            </h3>

                            <p>
                                Highest rated from completed tasks
                            </p>

                        </div>


                        <a class="dashboard-view-all" href="/FindPost">
                            View all
                        </a>

                    </div>


                    <div class="provider-grid" aria-label="Top service providers">
                        @if (Model.ReviewsUnavailable) { <p>Ratings are unavailable until the reviews database is ready.</p> }
                        else if (Model.RatedProviders.Count == 0) { <p>No rated service providers to show right now.</p> }
                        @foreach (var provider in Model.RatedProviders) { <div class="provider-card"><div class="provider-top"><div class="provider-avatar">@(provider.Name.Length > 0 ? provider.Name.Substring(0, 1).ToUpperInvariant() : "?")</div><div class="provider-name"><strong>@provider.Name</strong><span>@provider.Service</span><small class="provider-availability" data-provider-status="@(provider.CanRequest ? provider.Id.ToString() : null)">@provider.Availability</small></div></div><div class="provider-stats"><span class="rating">★ @provider.Average.ToString("0.0") <small>(@provider.Count reviews)</small></span></div><div class="provider-bottom">@if (provider.CanRequest && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value != provider.Id.ToString()) { <a asp-page="/FindPost" asp-route-providerId="@provider.Id">Request work</a> }</div></div> }
                    </div>
                    <div class="sample-provider-grid" hidden>


                        <!-- PROVIDER 1 -->

                        <div class="provider-card">

                            <div class="provider-top">

                                <div class="provider-avatar">
                                    Of
                                </div>

                                <div class="provider-name">

                                    <strong>
                                        Ofrac­io
                                    </strong>

                                    <span>
                                        Plumber
                                    </span>

                                </div>

                            </div>


                            <div class="provider-stats">

                                <span class="rating">
                                    ★ 4.8
                                    <small>
                                        (600)
                                    </small>
                                </span>

                                <span>
                                    100 jobs
                                </span>

                            </div>


                            <div class="provider-bottom">

                                <span>
                                    ₱600 / task
                                </span>

                                <button type="button">
                                    Book
                                </button>

                            </div>

                        </div>


                        <!-- PROVIDER 2 -->

                        <div class="provider-card">

                            <div class="provider-top">

                                <div class="provider-avatar">
                                    Ma
                                </div>

                                <div class="provider-name">

                                    <strong>
                                        Marisol
                                    </strong>

                                    <span>
                                        House Cleaner
                                    </span>

                                </div>

                            </div>


                            <div class="provider-stats">

                                <span class="rating">
                                    ★ 4.9
                                    <small>
                                        (421)
                                    </small>
                                </span>

                                <span>
                                    210 jobs
                                </span>

                            </div>


                            <div class="provider-bottom">

                                <span>
                                    ₱450 / task
                                </span>

                                <button type="button">
                                    Book
                                </button>

                            </div>

                        </div>


                        <!-- PROVIDER 3 -->

                        <div class="provider-card">

                            <div class="provider-top">

                                <div class="provider-avatar">
                                    Da
                                </div>

                                <div class="provider-name">

                                    <strong>
                                        Dante
                                    </strong>

                                    <span>
                                        Electrician
                                    </span>

                                </div>

                            </div>


                            <div class="provider-stats">

                                <span class="rating">
                                    ★ 4.7
                                    <small>
                                        (288)
                                    </small>
                                </span>

                                <span>
                                    132 jobs
                                </span>

                            </div>


                            <div class="provider-bottom">

                                <span>
                                    ₱750 / task
                                </span>

                                <button type="button">
                                    Book
                                </button>

                            </div>

                        </div>


                        <!-- PROVIDER 4 -->

                        <div class="provider-card">

                            <div class="provider-top">

                                <div class="provider-avatar">
                                    Le
                                </div>

                                <div class="provider-name">

                                    <strong>
                                        Lea
                                    </strong>

                                    <span>
                                        Errand Runner
                                    </span>

                                </div>

                            </div>


                            <div class="provider-stats">

                                <span class="rating">
                                    ★ 4.9
                                    <small>
                                        (512)
                                    </small>
                                </span>

                                <span>
                                    340 jobs
                                </span>

                            </div>


                            <div class="provider-bottom">

                                <span>
                                    ₱300 / task
                                </span>

                                <button type="button">
                                    Book
                                </button>

                            </div>

                        </div>

                    </div>

                </section>
                }

                @if (Model.ShowAvailableTasks)
                {
                    <div class="home-job-layout">
                        <section class="section home-panel">
                            <div class="home-panel-heading"><h3>Available tasks</h3><a href="/FindPost?mode=jobs">View all jobs ›</a></div>
                            <p>Recently posted work open for offers.</p>
                            @if (Model.TasksUnavailable || Model.AvailableTasks.Count == 0)
                            {
                                <p>@(Model.TasksUnavailable ? "Tasks are temporarily unavailable." : "No open tasks right now.")</p>
                            }
                            @foreach (var task in Model.AvailableTasks)
                            {
                                <a class="home-task-row" href="/FindPost?mode=jobs#task-@task.Id">
                                    <span class="home-row-copy"><strong>@task.Title</strong><small>@task.Category · @tts.Data.TaskLocationRules.PublicArea</small></span>
                                    <strong class="home-budget">@task.BudgetDisplay</strong>
                                    <span aria-hidden="true">›</span>
                                </a>
                            }
                        </section>
                        <div class="home-job-details">
                            <section class="section home-panel">
                                <div class="home-panel-heading"><h3>Scheduled job</h3></div>
                                <div data-scheduled-details hidden="@(Model.ScheduledJob is null)">
                                    <p><strong data-scheduled-title>@Model.ScheduledJob?.Title</strong><br /><span data-scheduled-time>@Model.ScheduledJob?.ScheduleText</span></p>
                                    <a class="home-panel-action" data-scheduled-link href="@(Model.ScheduledJob is { } job ? Url.Page("/Tracking", new { taskId = job.Id }) : null)">View progress</a>
                                </div>
                                <p data-scheduled-empty hidden="@(Model.ScheduledJob is not null)">@(Model.SummaryUnavailable ? "Schedule is temporarily unavailable." : "No upcoming accepted jobs.")</p>
                            </section>
                            <section class="section home-panel">
                                <div class="home-panel-heading"><h3>Your availability</h3></div>
                                <p class="availability-intro">Let clients know when you’re free for work in Bacolor.</p>
                                <form method="post" asp-page-handler="Availability" class="availability-strip">
                                    <span><i aria-hidden="true"></i>@(Model.Availability == "Available" ? "Available for new jobs" : Model.Availability)</span>
                                    <button type="submit" role="switch" aria-label="Accepting new jobs" aria-checked="@Model.AcceptingJobs.ToString().ToLowerInvariant()"
                                            name="acceptingJobs" value="@((!Model.AcceptingJobs).ToString().ToLowerInvariant())" disabled="@(!Model.CanEditAvailability)"></button>
                                </form>
                                @if (Model.AvailabilityNotice is { } notice) { <p role="status">@notice</p> }
                                <dl class="home-availability-details">
                                    <div><dt><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v5m10-5v5M3 10h18"/></svg>Work days</dt><dd>@(string.IsNullOrWhiteSpace(Model.AvailableDays) ? "Not set" : Model.AvailableDays.Replace(",", ", "))</dd></div>
                                    <div><dt><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Preferred hours</dt><dd>@Model.PreferredHours</dd></div>
                                    <div><dt><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>Service area</dt><dd>@(string.IsNullOrWhiteSpace(Model.ServiceArea) ? "Not set" : Model.ServiceArea)</dd></div>
                                </dl>
                                <a class="home-panel-action" href="/Settings#availability"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6 4 4M4 20l4-1L20 7l-3-3L5 16l-1 4Z"/></svg>Edit availability</a>
                            </section>
                        </div>
                    </div>
                }
            </div>

        </main>

    </div>


    <!-- =========================================================
         DASHBOARD JAVASCRIPT
    ========================================================== -->

    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/category-carousel.js" asp-append-version="true"></script>


    <!-- =========================================================
         MY PROFILE POPUP
    ========================================================== -->

    <div id="profileOverlay"
         class="profile-overlay"
         aria-hidden="true">

        <div class="profile-panel"
             role="dialog"
             aria-modal="true"
             aria-labelledby="profileTitle">


            <!-- PROFILE HEADER -->

            <div class="profile-header">

                <div>

                    <span class="profile-eyebrow">
                        ACCOUNT
                    </span>

                    <h2 id="profileTitle">
                        My Profile
                    </h2>

                    <p>
                        Manage your account information
                    </p>

                </div>


                <button id="closeProfile"
                        class="close-profile"
                        type="button"
                        aria-label="Close profile">

                    ×

                </button>

            </div>


            <!-- PROFILE IDENTITY -->

            <div class="profile-identity">

                <div id="profileAvatar"
                     class="large-avatar">

                    U

                </div>


                <div class="profile-identity-text">

                    <h3 id="profileName">
                        User
                    </h3>

                    <p id="profileEmail">
                        user@email.com
                    </p>

                    <span class="profile-status">
                        ● Active account
                    </span>

                </div>

            </div>


            <!-- ACCOUNT INFORMATION -->

            <div class="profile-section">

                <h3>
                    Account Information
                </h3>


                <div class="profile-field">

                    <label for="profileFullName">
                        Full Name
                    </label>

                    <input type="text"
                           id="profileFullName"
                           placeholder="Enter your full name"
                           maxlength="60"
                           autocomplete="name" />

                </div>


                <div class="profile-field">

                    <label for="profileEmailInput">
                        Email Address
                    </label>

                    <input type="email"
                           id="profileEmailInput"
                           placeholder="Enter your email"
                           maxlength="100"
                           autocomplete="email" />

                </div>


                <div class="profile-field">

                    <label for="nicknameInput">
                        Nickname
                    </label>

                    <input type="text"
                           id="nicknameInput"
                           placeholder="Enter your nickname"
                           maxlength="30"
                           autocomplete="nickname" />

                </div>


                <button id="saveProfile"
                        type="button"
                        class="save-profile-button">

                    Save Changes

                </button>

            </div>


            <!-- IDENTITY VERIFICATION -->

            <div class="profile-section">

                <h3>
                    Identity Verification
                </h3>


                <div class="profile-verification-row">

                    <div class="verification-small-icon">
                        ✓
                    </div>


                    <div class="verification-small-text">

                        <strong id="profileVerificationStatus">
                            Not Verified
                        </strong>

                        <span id="profileVerificationDescription">
                            Your identity has not been verified yet.
                        </span>

                    </div>


                    <button type="button"
                            id="openVerification">

                        Verify

                    </button>

                </div>

            </div>


            <!-- SECURITY -->

            <div class="profile-section security-section">

                <h3>
                    Security
                </h3>


                <button type="button"
                        id="changePasswordButton"
                        class="profile-action-button">

                    <span>
                        Change Password
                    </span>

                    <span>
                        ›
                    </span>

                </button>

            </div>


            <!-- FOOTER -->

            <div class="profile-footer">

                <button type="button"
                        id="closeProfileBottom"
                        class="profile-close-button">

                    Close

                </button>

            </div>

        </div>

    </div>


    <!-- =========================================================
         PROFILE JAVASCRIPT
    ========================================================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /* =====================================================
               ELEMENTS
            ===================================================== */

            const profileOverlay =
                document.getElementById("profileOverlay");

            const openProfile =
                document.getElementById("openProfile");

            const closeProfile =
                document.getElementById("closeProfile");

            const closeProfileBottom =
                document.getElementById("closeProfileBottom");

            const saveProfile =
                document.getElementById("saveProfile");

            const profileFullName =
                document.getElementById("profileFullName");

            const profileEmailInput =
                document.getElementById("profileEmailInput");

            const nicknameInput =
                document.getElementById("nicknameInput");

            const profileName =
                document.getElementById("profileName");

            const profileEmail =
                document.getElementById("profileEmail");

            const profileAvatar =
                document.getElementById("profileAvatar");

            const sidebarName =
                document.getElementById("sidebarName");

            const sidebarEmail =
                document.getElementById("sidebarEmail");

            const sidebarAvatar =
                document.getElementById("sidebarAvatar");

            const openVerification =
                document.getElementById("openVerification");

            const changePasswordButton =
                document.getElementById("changePasswordButton");

            const profileVerificationStatus =
                document.getElementById("profileVerificationStatus");

            const profileVerificationDescription =
                document.getElementById("profileVerificationDescription");


            /* =====================================================
               GET INITIALS
            ===================================================== */

            function getProfileInitials(name) {

                if (!name) {
                    return "U";
                }

                const words =
                    name.trim().split(/\s+/);


                if (words.length === 1) {

                    return words[0]
                        .substring(0, 2)
                        .toUpperCase();

                }


                return (
                    words[0][0] +
                    words[words.length - 1][0]
                ).toUpperCase();

            }


            /* =====================================================
               GET ACCOUNT FROM LOCAL STORAGE
            ===================================================== */

            function getAccount() {

                const account =
                    localStorage.getItem(
                        "tapTaskDoneAccount"
                    );


                if (!account) {
                    return null;
                }


                try {

                    return JSON.parse(account);

                }
                catch (error) {

                    console.error(
                        "Could not load account.",
                        error
                    );

                    return null;

                }

            }


            /* =====================================================
               VERIFICATION STATUS
            ===================================================== */

            function loadVerificationStatus() {

                const status =
                    localStorage.getItem(
                        "tapTaskDoneVerificationStatus"
                    );


                if (status === "pending") {

                    if (profileVerificationStatus) {

                        profileVerificationStatus.textContent =
                            "Pending Verification";

                    }


                    if (profileVerificationDescription) {

                        profileVerificationDescription.textContent =
                            "Your documents are currently being reviewed.";

                    }


                    if (openVerification) {

                        openVerification.textContent =
                            "View";

                    }

                }
                else {

                    if (profileVerificationStatus) {

                        profileVerificationStatus.textContent =
                            "Not Verified";

                    }


                    if (profileVerificationDescription) {

                        profileVerificationDescription.textContent =
                            "Your identity has not been verified yet.";

                    }


                    if (openVerification) {

                        openVerification.textContent =
                            "Verify";

                    }

                }

            }


            /* =====================================================
               LOAD PROFILE
            ===================================================== */

            function loadProfileInformation() {

                const user =
                    getAccount();


                if (!user) {

                    profileFullName.value = "";
                    profileEmailInput.value = "";
                    nicknameInput.value = "";

                    profileName.textContent = "User";
                    profileEmail.textContent = "user@email.com";
                    profileAvatar.textContent = "U";

                    loadVerificationStatus();

                    return;

                }


                const fullName =
                    user.name || "";

                const email =
                    user.email || "";

                const nickname =
                    user.nickname || "";


                const displayName =
                    nickname ||
                    fullName ||
                    "User";


                profileFullName.value =
                    fullName;

                profileEmailInput.value =
                    email;

                nicknameInput.value =
                    nickname;


                profileName.textContent =
                    displayName;

                profileEmail.textContent =
                    email || "user@email.com";

                profileAvatar.textContent =
                    getProfileInitials(displayName);


                sidebarName.textContent =
                    displayName;

                sidebarEmail.textContent =
                    email;

                sidebarAvatar.textContent =
                    getProfileInitials(displayName);


                loadVerificationStatus();

            }


            /* =====================================================
               OPEN PROFILE
            ===================================================== */

            function openProfilePanel() {

                loadProfileInformation();

                profileOverlay.classList.add("show");

                profileOverlay.setAttribute(
                    "aria-hidden",
                    "false"
                );

                document.body.classList.add(
                    "profile-open"
                );

                setTimeout(function () {

                    profileFullName.focus();

                }, 100);

            }


            if (openProfile) {

                openProfile.addEventListener(
                    "click",
                    function (event) {

                        event.preventDefault();

                        openProfilePanel();

                    }
                );


                openProfile.addEventListener(
                    "keydown",
                    function (event) {

                        if (
                            event.key === "Enter" ||
                            event.key === " "
                        ) {

                            event.preventDefault();

                            openProfilePanel();

                        }

                    }
                );

            }


            /* =====================================================
               SAVE PROFILE
            ===================================================== */

            if (saveProfile) {

                saveProfile.addEventListener(
                    "click",
                    function () {

                        const user =
                            getAccount();


                        if (!user) {

                            alert(
                                "No account information found."
                            );

                            return;

                        }


                        const newName =
                            profileFullName.value.trim();

                        const newEmail =
                            profileEmailInput.value.trim();

                        const newNickname =
                            nicknameInput.value.trim();


                        if (!newName) {

                            alert(
                                "Please enter your full name."
                            );

                            profileFullName.focus();

                            return;

                        }


                        if (!newEmail) {

                            alert(
                                "Please enter your email address."
                            );

                            profileEmailInput.focus();

                            return;

                        }


                        user.name =
                            newName;

                        user.email =
                            newEmail;

                        user.nickname =
                            newNickname;


                        localStorage.setItem(
                            "tapTaskDoneAccount",
                            JSON.stringify(user)
                        );


                        const displayName =
                            newNickname ||
                            newName ||
                            "User";


                        profileName.textContent =
                            displayName;

                        profileEmail.textContent =
                            newEmail;

                        profileAvatar.textContent =
                            getProfileInitials(displayName);


                        sidebarName.textContent =
                            displayName;

                        sidebarEmail.textContent =
                            newEmail;

                        sidebarAvatar.textContent =
                            getProfileInitials(displayName);


                        alert(
                            "Profile information saved successfully."
                        );

                    }
                );

            }


            /* =====================================================
               IDENTITY VERIFICATION
            ===================================================== */

            if (openVerification) {

                openVerification.addEventListener(
                    "click",
                    function () {

                        window.location.href =
                            "/IdentityVerification";

                    }
                );

            }


            /* =====================================================
               CHANGE PASSWORD
            ===================================================== */

            if (changePasswordButton) {

                changePasswordButton.addEventListener(
                    "click",
                    function () {

                        window.location.href =
                            "/ChangePassword";

                    }
                );

            }


            /* =====================================================
               CLOSE PROFILE
            ===================================================== */

            function closeProfilePanel() {

                profileOverlay.classList.remove(
                    "show"
                );

                profileOverlay.setAttribute(
                    "aria-hidden",
                    "true"
                );

                document.body.classList.remove(
                    "profile-open"
                );

            }


            if (closeProfile) {

                closeProfile.addEventListener(
                    "click",
                    closeProfilePanel
                );

            }


            if (closeProfileBottom) {

                closeProfileBottom.addEventListener(
                    "click",
                    closeProfilePanel
                );

            }


            /* =====================================================
               CLICK OUTSIDE
            ===================================================== */

            if (profileOverlay) {

                profileOverlay.addEventListener(
                    "click",
                    function (event) {

                        if (
                            event.target ===
                            profileOverlay
                        ) {

                            closeProfilePanel();

                        }

                    }
                );

            }


            /* =====================================================
               ESC KEY
            ===================================================== */

            document.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "Escape" &&
                        profileOverlay.classList.contains("show")
                    ) {

                        closeProfilePanel();

                    }

                }
            );


            /* =====================================================
               INITIAL LOAD
            ===================================================== */

            loadProfileInformation();

        });

    </script>


    <partial name="_TaskHelp" />
</body>

</html>
