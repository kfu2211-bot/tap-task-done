@page
@model MessagesModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Messages - Tap, Task, Done</title>

    <link rel="stylesheet" href="/css/messages.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/sidebar-stability.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/readability.css" asp-append-version="true" />
    <script defer src="/js/sidebar-account.js" asp-append-version="true"></script>
    <script defer src="/js/profile-photo.js" asp-append-version="true"></script>
<link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/sidebar-consistency.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/messages-polish.css" asp-append-version="true" />
<link rel="stylesheet" href="/css/workspace-spacing.css" asp-append-version="true" />
<partial name="_AccountTheme" /></head>

<body class="@(Request.Query["legacy"] == "1" ? "messages-legacy-view" : "messages-current-view")">

    <!-- ==============================
         SIDEBAR
    =============================== -->

    <aside class="sidebar">

        <div class="logo-area">
            <div class="logo-circle">✓</div>
            <span>Tap, Task, Done</span>
        </div>

        <nav class="sidebar-nav">

            <a href="/Dashboard">
                <span class="nav-icon">⌂</span>
                <span>Home</span>
            </a>

            <a href="/FindPost">
                <span class="nav-icon">⌕</span>
                <span>Find &amp; Post</span>
            </a>

            <a href="/MyTasks">
                <span class="nav-icon">▤</span>
                <span>My Tasks</span>
            </a>

            <a href="/Messages" class="active">
                <span class="nav-icon">□</span>
                <span>Messages</span>
            </a>

            <a href="/IdentityVerification">
                <span class="nav-icon">✓</span>
                <span>Identity Verification</span>
            </a>

            <a href="/Tracking">
                <span class="nav-icon">➤</span>
                <span>Tracking</span>
            </a>

            <a href="/Reviews">
                <span class="nav-icon">☆</span>
                <span>Reviews</span>
            </a>

        </nav>

        <!-- USER -->

        <div class="sidebar-user">

            <div class="user-avatar" id="userAvatar">
                JD
            </div>

            <div class="user-info">
                <strong id="sidebarName">Jhon</strong>
                <span id="sidebarEmail">jhon@gmail.com</span>
            </div>

            <button class="user-menu">⋮</button>

        </div>

    </aside>


    <!-- ==============================
         MAIN CONTENT
    =============================== -->

    <main class="main-content">

        <!-- TOP BAR -->

        <header class="topbar">

            <h1>Messages</h1>

            <button class="notification-button">
                ♧
            </button>

        </header>


        <!-- ==============================
             MESSAGE AREA
        =============================== -->

        @if (Request.Query["legacy"] == "1") {
        <p style="padding: 15px">Older browser-only messages have not been imported. <a href="/Messages">Back to current messages</a></p>
        <section class="messages-wrapper">

            <!-- CONVERSATION LIST -->

            <div class="conversation-panel">

                <div class="search-box">

                    <span>⌕</span>

                    <input type="text"
                           id="messageSearch"
                           placeholder="Search messages" />

                </div>


                <div class="conversation active" onclick="openConversation('Ofrac')">
                    <div class="conversation-avatar">Of</div>
                    <div class="conversation-details"><div class="conversation-top"><strong>Ofrac</strong><span>10:24 AM</span></div><p>I can be there by 2 PM today.</p></div>
                    <div class="unread">2</div>
                </div>
                <div class="conversation" onclick="openConversation('Marisol')">
                    <div class="conversation-avatar">Ma</div>
                    <div class="conversation-details"><div class="conversation-top"><strong>Marisol</strong><span>Yesterday</span></div><p>See you on Saturday morning!</p></div>
                </div>
                <div class="conversation" onclick="openConversation('Dante')">
                    <div class="conversation-avatar">Da</div>
                    <div class="conversation-details"><div class="conversation-top"><strong>Dante</strong><span>Mon</span></div><p>Could you send a photo of the future...</p></div>
                </div>
                <div class="conversation" onclick="openConversation('Lea')">
                    <div class="conversation-avatar">Le</div>
                    <div class="conversation-details"><div class="conversation-top"><strong>Lea</strong><span>Aug 18</span></div><p>Delivered! Thanks for booking.</p></div>
                </div>

            </div>


            <!-- ==============================
                 CHAT PANEL
            =============================== -->

            <div class="chat-panel">

                <!-- CHAT HEADER -->

                <div class="chat-header">
                    <div class="chat-avatar">Of</div>
                    <div><strong id="chatName">Ofrac</strong><span>Plumber</span></div>
                </div>


                <!-- CHAT MESSAGES -->

                <div class="chat-messages" id="chatMessages">
                    <div class="message received"><div class="message-bubble">Hi Jhon, I saw your faucet task.<small>10:10 AM</small></div></div>
                    <div class="message received"><div class="message-bubble">No problem, I have the parts.<small>10:20 AM</small></div></div>
                    <div class="message received"><div class="message-bubble">I can be there by 2 PM today.<small>10:24 AM</small></div></div>
                    <div class="message sent"><div class="message-bubble">Great! It's leaking pretty badly.<small>10:25 AM</small></div></div>
                </div>


                <!-- MESSAGE INPUT -->

                <div class="message-input-area">
                    <textarea id="messageInput"
                              rows="2"
                              placeholder="Write a message…"></textarea>
                    <button type="button" id="sendMessage" aria-label="Send message">➤</button>
                    <small>Press Enter to send · Shift + Enter for a new line</small>
                </div>

            </div>

        </section>
        } else {
        <section class="messages-current">

            @if (!string.IsNullOrWhiteSpace(Model.Notice)) { <p class="messages-notice" role="status">@Model.Notice</p> }
            @if (Model.Unavailable) { <div class="messages-empty" role="alert">Messages are unavailable. Check the database setup and try again.</div> }
            else {
            <div class="messages-grid @(Model.Selected is null ? "" : "has-open-thread")"><nav class="messages-conversations" aria-label="Conversations">
                <div class="conversations-toolbar"><div class="conversations-title"><h2>Conversations</h2><span class="conversation-count">@Model.Conversations.Count</span></div><label class="conversation-search"><span class="messages-sr-only">Search conversations</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg><input id="conversationSearch" type="search" placeholder="Search conversations" autocomplete="off" /></label></div>
                <div class="conversation-results">
                @if (Model.Conversations.Count == 0) { <p class="conversation-list-empty">No conversations yet. Ask about a public task or discuss a private booking to start a conversation.</p> }
                @foreach (var conversation in Model.Conversations) {
                    Model.LatestMessages.TryGetValue(conversation.OtherId, out var latest);
                    var unread = Model.UnreadCounts.GetValueOrDefault(conversation.OtherId);
                    <a class="conversation-link @(Model.Selected?.OtherId == conversation.OtherId ? "selected" : "") @(unread > 0 ? "has-unread" : "")"
                       asp-page="/Messages" asp-route-accountId="@conversation.OtherId"
                       aria-current="@(Model.Selected?.OtherId == conversation.OtherId ? "page" : null)"
                       data-search="@($"{conversation.OtherName} {conversation.Title}".ToLowerInvariant())">
                        <span class="conversation-avatar" aria-hidden="true">@MessagesModel.Initials(conversation.OtherName)</span>
                        <span class="conversation-copy">
                            <span class="conversation-row-heading">
                                <strong data-account-id="@conversation.OtherId">@(string.IsNullOrWhiteSpace(conversation.OtherName) ? "User" : conversation.OtherName)</strong>
                                @if (latest is not null) { <time title="@tts.Data.DisplayTime.Philippine(latest.CreatedAt)">@latest.CreatedAt.AddHours(8).ToString("MMM d")</time> }
                            </span>
                            <span class="conversation-task">@conversation.Title</span>
                            <span class="conversation-preview">@(latest is null ? "No messages yet" : latest.Body)</span>
                        </span>
                        @if (unread > 0) { <span class="conversation-unread" aria-label="@unread unread">@(unread > 99 ? "99+" : unread.ToString())</span> }
                    </a>
                }
                </div><p id="conversationNoMatches" class="conversation-list-empty" hidden>No conversations match your search.</p>
            </nav><div class="messages-thread">
                @if (Model.Selected == null)
                {
                    <div class="inbox-welcome">
                        <div class="inbox-welcome-icon" aria-hidden="true">
                            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 22h4l5 4v-6a8 8 0 0 0-1-13M23 13a9 9 0 0 1-9 9h-3l-6 4v-7a9 9 0 1 1 18-6Z"/><path d="M10 12h8m-8 4h5"/></svg>
                        </div>
                        <h3>@(Model.Conversations.Count > 0 ? "Open a conversation" : "Your inbox is empty")</h3>
                        @if (Model.Conversations.Count > 0)
                        {
                            <p>Choose a person from your inbox to see your messages and shared tasks.</p>
                        }
                        else
                        {
                            <p>Ask about a task or discuss a booking to start a conversation.</p>
                            <a class="thread-task-link" href="/FindPost">Find tasks and freelancers</a>
                        }
                    </div>
                }
                else {
                    <div class="thread-heading">
                        <a class="thread-back" asp-page="/Messages" aria-label="Back to conversations"><span aria-hidden="true">‹</span></a>
                        <span class="conversation-avatar" aria-hidden="true">@MessagesModel.Initials(Model.Selected.OtherName)</span>
                        <div class="thread-heading-copy">
                            <h3 data-account-id="@Model.Selected.OtherId">@(string.IsNullOrWhiteSpace(Model.Selected.OtherName) ? "User" : Model.Selected.OtherName)</h3>
                            @if (Model.SelectedTasks.Count == 1) { <p>@Model.Selected.Title · Task #@Model.Selected.TaskId</p> }
                        </div>
                        @if (Model.SelectedTasks.Count > 1)
                        {
                        <form class="thread-task-picker" method="get" asp-page="/Messages">
                            <label for="messageTask">Task</label>
                            <select id="messageTask" name="conversationId">
                                @foreach (var task in Model.SelectedTasks)
                                {
                                    <option value="@task.Id" selected="@(task.Id == Model.Selected.Id)">@task.Title · Task #@task.TaskId</option>
                                }
                            </select>
                            <button type="submit">Switch</button>
                        </form>
                        }
                        <a class="thread-task-link" href="@(Model.Selected.ClientId == Model.UserId ? "/MarketTasks?view=mine" : "/MyJobs")">View task</a>
                    </div>
                    @if (Model.Selected.Assigned)
                    {
                        <div class="thread-agreement">
                            <div><strong>Task progress</strong><p>Follow the work and discuss any changes here.</p></div>
                            <a href="/Tracking?taskId=@Model.Selected.TaskId">View progress</a>
                        </div>
                    }
                    <div class="thread-messages" data-account="@Model.Selected.OtherId" data-task-context="@Model.Selected.Id" aria-label="Conversation messages">
                        @if (Model.Messages.Count == 0) { <div class="thread-empty-state">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 11a8 8 0 0 1-8 8H8l-5 2 2-5a8 8 0 1 1 16-5Z"/><path d="M8 10h8m-8 4h5"/></svg>
                                <strong>@(Model.Selected.CanSend ? "Start the conversation" : "No messages")</strong>
                                @if (Model.Selected.CanSend) { <p>Send a message to discuss the task details.</p> }
                            </div> }
                        @{ DateTime? messageDay = null; long? previousConversation = null; var tasks = Model.SelectedTasks.ToDictionary(task => task.Id); }
                        @foreach (var message in Model.Messages) {
                            var day = message.CreatedAt.AddHours(8).Date;
                            if (day != messageDay) { <div class="thread-date">@day.ToString("MMMM d, yyyy")</div> messageDay = day; }
                            if (Model.SelectedTasks.Count > 1 && previousConversation != message.ConversationId && message.ConversationId is long conversationId)
                            {
                                <div class="thread-context"><span>@tasks[conversationId].Title · Task #@message.TaskId</span></div>
                                previousConversation = conversationId;
                            }
                            <div class="thread-message @(message.SenderId == Model.UserId ? "mine" : "theirs")"><p>@message.Body</p><time datetime="@message.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ssZ")" title="@tts.Data.DisplayTime.Philippine(message.CreatedAt)">@message.CreatedAt.AddHours(8).ToString("h:mm tt")</time></div>
                        }
                    </div>
@if(Model.Selected.CanSend) { <form method="post" asp-page-handler="Send" class="thread-form"><input type="hidden" name="conversationId" value="@Model.Selected.Id" /><input type="hidden" name="taskId" value="@Model.Selected.TaskId" /><label for="messageBody" class="messages-sr-only">Your message</label><textarea id="messageBody" name="body" maxlength="2000" required rows="1" placeholder="Write a message…"></textarea><button type="submit">Send</button></form> } else {
                        <div class="thread-archived"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>Messaging for this task is archived.</div>
                    }
                }
            </div></div>
            }
        <script defer src="/js/messages-live.js" asp-append-version="true"></script></section>
        }

    </main>


    @if (Request.Query["legacy"] == "1") { <script src="~/js/messages.js" asp-append-version="true"></script> }

</body>
</html>
