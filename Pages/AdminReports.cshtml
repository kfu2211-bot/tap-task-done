@page
@model tts.Pages.AdminReportsModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en"><head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" /><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Safety Reports - Admin</title><link rel="stylesheet" href="/css/admin.css" asp-append-version="true" /><link rel="stylesheet" href="/css/safety-reports.css" asp-append-version="true" /><link rel="stylesheet" href="/css/light-system.css" asp-append-version="true" /><link rel="stylesheet" href="/css/admin-polish.css" asp-append-version="true" />
<partial name="_AccountTheme" /></head>
<body class="report-admin-body @(Model.Embedded ? "report-embedded" : "")"><div class="report-admin-layout">
    <aside class="report-admin-sidebar" aria-label="Admin navigation">
        <a class="report-brand" href="/Admin"><span>✓</span><strong>Tap, Task, Done</strong></a>
        <nav><a href="/Admin">⌂ <span>Admin overview</span></a><a class="current" href="/AdminReports" aria-current="page">⚑ <span>Safety reports</span></a></nav>
        <p>Admin workspace</p>
    </aside>
    <main class="report-admin-main">
        <header class="report-admin-header"><a href="/Admin">← Admin Center</a><span>Admin workspace</span></header>
        <div class="admin-report-page">
            <div class="report-page-heading"><div><p class="report-eyebrow">COMMUNITY SAFETY</p><h1>Safety reports</h1><p>Review reports submitted by users and keep track of your decisions.</p></div><span class="report-total">@(Model.DatabaseUnavailable ? "Unable to load reports" : $"{Model.Reports.Count} reports")</span></div>
            <div class="report-guidance"><strong>Review carefully</strong><p>Reported names are entered by users and are not automatically verified. Treat attachments as untrusted files. No account is suspended automatically.</p></div>
            <form method="get" class="report-filters" aria-label="Filter and sort reports">
                @if (Model.Embedded) { <input type="hidden" name="embedded" value="true" /> }
                <div class="report-filter-field"><label for="reportStatusFilter">Status</label>
                <select id="reportStatusFilter" name="statusFilter" asp-for="StatusFilter"><option value="all">All statuses</option><option value="open">Open</option><option value="reviewing">Under review</option><option value="resolved">Resolved</option><option value="dismissed">Dismissed</option></select></div>
                <div class="report-filter-field"><label for="reportPriorityFilter">Priority</label><select id="reportPriorityFilter" name="priorityFilter" asp-for="PriorityFilter"><option value="all">All priorities</option><option value="0">Not assessed</option><option value="1">Low</option><option value="2">Normal</option><option value="3">High</option></select></div>
                <div class="report-filter-field"><label for="reportSort">Sort by</label>
                <select id="reportSort" name="sort" asp-for="Sort"><option value="recent">Most recent</option><option value="oldest">Oldest</option><option value="priority">Highest priority</option></select></div>
                <button type="submit">Apply filters</button>
            </form>
            @if (!string.IsNullOrWhiteSpace(Model.Notice)) { <div class="report-notice @(Model.DatabaseUnavailable ? "report-notice-error" : "")" role="status"><strong>@(Model.DatabaseUnavailable ? "Reports are temporarily unavailable" : "Report update")</strong><p>@Model.Notice</p>@if(Model.DatabaseUnavailable){<a href="">Try again</a>}</div> }
            @if (!Model.DatabaseUnavailable && Model.Reports.Count == 0) { <section class="report-empty"><h2>No matching reports</h2><p>Try another filter or check again when a report is submitted.</p></section> }
            @foreach (var item in Model.Reports) {
                var report = item.Report;
                var statusLabel = report.Status switch { "open" => "Open", "reviewing" => "Under review", "resolved" => "Resolved", "dismissed" => "Dismissed", _ => report.Status };
                var priorityLabel = report.Priority switch { 1 => "Low", 2 => "Normal", 3 => "High", _ => "Not assessed" };
                <article class="admin-report-card">
                    <div class="report-card-heading"><div><p class="report-eyebrow">REPORT #@report.Id</p><h2>@report.Reason</h2></div><div class="report-badges"><span class="report-priority priority-@report.Priority">Priority: @priorityLabel</span><span class="report-status status-@report.Status">@statusLabel</span></div></div>
                    <form method="post" asp-page-handler="Priority" class="report-guidance priority-editor"><input type="hidden" name="id" value="@report.Id" /><input type="hidden" name="embedded" value="@Model.Embedded.ToString().ToLowerInvariant()" /><input type="hidden" name="statusFilter" value="@Model.StatusFilter" /><input type="hidden" name="priorityFilter" value="@Model.PriorityFilter" /><input type="hidden" name="sort" value="@Model.Sort" /><label>Review priority <select name="priority"><option value="0" selected="@(report.Priority == 0)">Not assessed</option><option value="1" selected="@(report.Priority == 1)">Low</option><option value="2" selected="@(report.Priority == 2)">Normal</option><option value="3" selected="@(report.Priority == 3)">High</option></select></label> <button type="submit">Save priority</button><p>Priority is an assessment for review, not a finding or an automatic penalty. Review the details and adjust it when needed.</p></form>
                    <dl class="report-details"><div><dt>Reported person</dt><dd>@report.Target</dd></div><div><dt>Submitted by</dt><dd>@item.Reporter</dd></div><div><dt>Related task</dt><dd>@(report.TaskId.HasValue ? (Model.TaskTitles.TryGetValue(report.TaskId.Value, out var taskTitle) ? taskTitle : "Task unavailable") : "Not provided")</dd></div><div><dt>Submitted</dt><dd>@tts.Data.DisplayTime.Philippine(report.CreatedAt)</dd></div></dl>
                    <div class="report-message"><h3>What happened</h3><p class="admin-report-description">@report.Description</p></div>
                    <div class="report-message"><h3>Next steps</h3><p>Review attachments and the related task. Obtain explanations through your established support channel. If an offense is confirmed, open <a href="/Admin#users" target="_top">Users: offense review</a>, verify the account, and use incident reference <strong>report:@report.Id</strong>. Saving this review does not apply a penalty or issue a refund.</p></div><div class="report-message"><h3>Supporting evidence</h3>@if (Model.EvidenceUnavailable) { <p>Attachments could not be loaded.</p> } else if (!Model.Evidence.Any(e => e.ReportId == report.Id)) { <p>No files attached.</p> } else { <ul>@foreach (var file in Model.Evidence.Where(e => e.ReportId == report.Id)) { <li><a asp-page="/AdminReports" asp-page-handler="Evidence" asp-route-id="@file.Id">Download evidence #@file.Id (@(file.ContentType == "application/pdf" ? "PDF" : "Image"))</a></li> }</ul> }</div>
                    @if (report.Status is "open" or "reviewing") {
                        <form method="post" asp-page-handler="Update" class="safety-form report-action-form"><h3>Review this report</h3><input type="hidden" name="id" value="@report.Id" /><input type="hidden" name="embedded" value="@Model.Embedded.ToString().ToLowerInvariant()" />
                        <label>Internal note <span>(private; required when closing a report)</span><textarea name="note" maxlength="1000" rows="3" placeholder="Add context for other admins"></textarea></label>
                        <label>Update status<select name="status">@if(report.Status == "open") { <option value="reviewing">Under review</option> }<option value="resolved">Resolved</option><option value="dismissed">Dismissed</option></select></label>
                        <label>Message to the reporter <span>(required; visible to the reporter and sent by email)</span><textarea name="publicMessage" minlength="10" maxlength="1000" required rows="3" placeholder="Explain the findings, action taken, and next steps. Avoid private information about another person."></textarea></label><label class="report-review-confirm"><input type="checkbox" name="reviewConfirmed" value="true" /> I reviewed the evidence, considered explanations from both parties where available, and documented missing information before closing.</label><p>Closing requires an internal decision reason of at least 10 characters. Resolve after the concern has been addressed; dismiss with a clear evidence-based reason. New evidence can be submitted in a follow-up report.</p><button type="submit">Save review and notify reporter</button></form>
                    } else { <p class="report-closed">This report is closed. Its action history is available below.</p> }
                    <details class="report-history"><summary>Admin action history <span>View decisions and notes</span></summary>@if(Model.HistoryUnavailable) { <p>Action history could not be loaded.</p> } else if(!Model.Actions.Any(a => a.Action.ReportId == report.Id)) { <p>No actions recorded yet.</p> } <div class="report-history-list">@foreach(var entry in Model.Actions.Where(a => a.Action.ReportId == report.Id)) { <div class="report-history-entry"><div class="report-history-marker" aria-hidden="true"></div><div><strong>@(entry.Action.Status == "reviewing" ? "Under review" : entry.Action.Status == "resolved" ? "Resolved" : entry.Action.Status == "dismissed" ? "Dismissed" : entry.Action.Status)</strong><span class="report-history-meta">@entry.AdminName · @tts.Data.DisplayTime.Philippine(entry.Action.CreatedAt)</span>@if(!string.IsNullOrWhiteSpace(entry.Action.PublicMessage)){<p><strong>Reporter update:</strong> @entry.Action.PublicMessage</p>}@if(!string.IsNullOrWhiteSpace(entry.Action.Note)) { <p>@entry.Action.Note</p> }</div></div> }</div></details>
                </article>
            }
            <p class="report-footnote">Showing up to 100 reports for the selected filters.</p>
        </div>
    </main>
</div>
@if (Model.Embedded) {
<script>
    const content = document.querySelector('.admin-report-page');
    const reportHeight = () => {
        if (window.parent === window) return;
        const height = Math.ceil(content.getBoundingClientRect().height + 64);
        if (height > 0) window.parent.postMessage({ type: 'admin-reports-height', height }, window.location.origin);
    };
    new ResizeObserver(reportHeight).observe(content);
    document.querySelectorAll('details').forEach(item => item.addEventListener('toggle', reportHeight));
    window.addEventListener('load', reportHeight);
    reportHeight();
</script>
}
</body></html>
