@page
@model tts.Pages.ForgotPasswordModel
@{ Layout = null; }
<!DOCTYPE html><html lang="en"><head><link rel="icon" type="image/svg+xml" href="/tap-task-icon.svg" /><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Forgot password - Tap, Task, Done</title><link rel="stylesheet" href="/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="/css/light-auth.css" asp-append-version="true" /></head>
<body><main class="login-page"><div class="login-logo"><div class="login-logo-circle">✓</div><span>Tap, Task, Done</span></div><div class="login-box">
<div class="login-eyebrow">ACCOUNT RECOVERY</div><h1>Forgot password?</h1>
@if (Model.Notice is not null) { <p class="login-subtitle" role="status">@Model.Notice</p> }
@if (Model.ErrorMessage is not null) { <p role="alert" style="color:#a32828">@Model.ErrorMessage</p> }
@if (Model.Step == "email") {
<p class="login-subtitle">Enter your account email and we'll send a verification code.</p>
<form method="post" asp-page-handler="Send"><div class="login-group"><label for="Email">EMAIL</label><input asp-for="Email" type="email" autocomplete="email" required /></div><button class="login-button" type="submit">Send verification code</button></form>
} else if (Model.Step == "code") {
<form method="post" asp-page-handler="Verify"><input type="hidden" asp-for="Email" /><div class="login-group"><label>VERIFICATION CODE</label><div class="reset-code-boxes">@for (var i = 0; i < 6; i++) { <input name="CodeDigits" type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" aria-label="Digit @(i + 1)" autocomplete="@(i == 0 ? "one-time-code" : "off")" required /> }</div></div><button class="login-button" type="submit">Verify code</button></form>
<form method="post" asp-page-handler="Send"><input type="hidden" asp-for="Email" /><button class="resend-code" type="submit">Resend code</button></form>
} else if (Model.Step == "password") {
<form method="post" asp-page-handler="Reset"><div class="login-group"><label for="Password">NEW PASSWORD</label><input asp-for="Password" type="password" autocomplete="new-password" minlength="8" maxlength="256" required /></div><div class="login-group"><label for="ConfirmPassword">CONFIRM PASSWORD</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="256" required /></div><button class="login-button" type="submit">Update password</button></form>
} else { <p class="login-subtitle" role="status">Your password has been updated. Please log in with your new password.</p> }
<p class="create-account-text"><a href="/Login">Back to login</a></p></div></main><style>.reset-code-boxes{display:flex;gap:8px}.reset-code-boxes input{width:0;min-width:0;flex:1;text-align:center;font-size:1.25rem;padding:12px 4px}.resend-code{margin-top:18px;background:none;border:0;color:#167153;font-weight:600;cursor:pointer}</style><script src="/js/reset-code.js" asp-append-version="true"></script></body></html>
